                        <Hyperlink>="javascript:void(window.open('http://localhost/InvestmentReports/report/InvestmentReportProject/MonthlySales?symbol=" &amp; Fields!Code.Value &amp; "&amp;rc:Zoom=100','_blank'))"</Hyperlink>
                      </Action></Actions></ActionInfo>
