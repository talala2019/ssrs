<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource_localhost">
      <DataSourceReference>DataSource_localhost</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>56cd27f5-46d2-4105-a744-8706f1cbd54f</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <!-- Parameter available values datasets -->
    <DataSet Name="IndustryList">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <CommandText>SELECT DISTINCT Industry FROM Company WHERE Status=1 AND CountryCode='TW' AND Industry IS NOT NULL AND Industry != '' ORDER BY Industry</CommandText>
      </Query>
      <Fields>
        <Field Name="Industry"><DataField>Industry</DataField><rd:TypeName>System.String</rd:TypeName></Field>
      </Fields>
    </DataSet>
    <DataSet Name="IndustryNamesList">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Industry">
            <Value>=Parameters!Industry.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>
SELECT DISTINCT ii.IndustryName
FROM IndustryIndex ii
WHERE EXISTS (
    SELECT 1 FROM CompanyDetailedIndustry cdi
    JOIN Company c ON cdi.CompanyID = c.CompanyID
    WHERE c.Industry IN (@Industry)
    AND cdi.IndustryNames LIKE '%' + ii.IndustryName + '%'
)
ORDER BY ii.IndustryName
        </CommandText>
      </Query>
      <Fields>
        <Field Name="IndustryName"><DataField>IndustryName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
      </Fields>
    </DataSet>
    <!-- Main screening dataset -->
    <DataSet Name="ScreeningData">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Industry">
            <Value>=Parameters!Industry.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@IndustryNames">
            <Value>=Parameters!IndustryNames.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>
DECLARE @CurYear  INT = YEAR(GETDATE())
DECLARE @PrevYear INT = @CurYear - 1
DECLARE @LatestMonth INT

SELECT TOP 1 @LatestMonth = LatMonth
FROM (
    SELECT CASE
        WHEN ISNULL(Dec,0)   &gt; 0 THEN 12 WHEN ISNULL(Nov,0)   &gt; 0 THEN 11
        WHEN ISNULL(Oct,0)   &gt; 0 THEN 10 WHEN ISNULL(Sep,0)   &gt; 0 THEN 9
        WHEN ISNULL(Aug,0)   &gt; 0 THEN 8  WHEN ISNULL(July,0)  &gt; 0 THEN 7
        WHEN ISNULL(June,0)  &gt; 0 THEN 6  WHEN ISNULL(May,0)   &gt; 0 THEN 5
        WHEN ISNULL(April,0) &gt; 0 THEN 4  WHEN ISNULL(Mar,0)   &gt; 0 THEN 3
        WHEN ISNULL(Feb,0)   &gt; 0 THEN 2  WHEN ISNULL(Jan,0)   &gt; 0 THEN 1
        ELSE 0 END AS LatMonth
    FROM MonthlySales ms
    JOIN Company c ON ms.CompanyId = c.CompanyID
    WHERE c.Status = 1 AND c.CountryCode = 'TW' AND ms.Year = @CurYear
) sub
WHERE LatMonth &gt; 0
GROUP BY LatMonth ORDER BY COUNT(*) DESC

DECLARE @M1Month INT = @LatestMonth
DECLARE @M1Year  INT = @CurYear
DECLARE @M2Month INT = CASE WHEN @LatestMonth &gt; 1 THEN @LatestMonth - 1 ELSE 12 END
DECLARE @M2Year  INT = CASE WHEN @LatestMonth &gt; 1 THEN @CurYear ELSE @PrevYear END
DECLARE @M3Month INT = CASE WHEN @LatestMonth &gt; 2 THEN @LatestMonth - 2 WHEN @LatestMonth = 2 THEN 12 ELSE 11 END
DECLARE @M3Year  INT = CASE WHEN @LatestMonth &gt; 2 THEN @CurYear ELSE @PrevYear END

DECLARE @M1Label VARCHAR(10) = LEFT(DATENAME(MONTH, DATEFROMPARTS(2000, @M1Month, 1)), 3) + '/' + RIGHT(CAST(@M1Year AS VARCHAR), 2)
DECLARE @M2Label VARCHAR(10) = LEFT(DATENAME(MONTH, DATEFROMPARTS(2000, @M2Month, 1)), 3) + '/' + RIGHT(CAST(@M2Year AS VARCHAR), 2)
DECLARE @M3Label VARCHAR(10) = LEFT(DATENAME(MONTH, DATEFROMPARTS(2000, @M3Month, 1)), 3) + '/' + RIGHT(CAST(@M3Year AS VARCHAR), 2)

;WITH MV AS (
    SELECT ms.CompanyId, ms.Year, v.m, CAST(v.amt AS FLOAT) AS amt
    FROM MonthlySales ms
    CROSS APPLY (VALUES
        (1,ISNULL(ms.Jan,0)), (2,ISNULL(ms.Feb,0)),  (3,ISNULL(ms.Mar,0)),
        (4,ISNULL(ms.April,0)),(5,ISNULL(ms.May,0)), (6,ISNULL(ms.June,0)),
        (7,ISNULL(ms.July,0)), (8,ISNULL(ms.Aug,0)), (9,ISNULL(ms.Sep,0)),
        (10,ISNULL(ms.Oct,0)),(11,ISNULL(ms.Nov,0)),(12,ISNULL(ms.Dec,0))
    ) v(m, amt)
    WHERE ms.Year IN (@CurYear, @PrevYear, @CurYear - 2)
),
YTD AS (
    SELECT ms.CompanyId,
        SUM(CASE WHEN ms.Year = @CurYear THEN CAST(
            CASE WHEN @LatestMonth &gt;= 1  THEN ISNULL(ms.Jan,0)   ELSE 0 END +
            CASE WHEN @LatestMonth &gt;= 2  THEN ISNULL(ms.Feb,0)   ELSE 0 END +
            CASE WHEN @LatestMonth &gt;= 3  THEN ISNULL(ms.Mar,0)   ELSE 0 END +
            CASE WHEN @LatestMonth &gt;= 4  THEN ISNULL(ms.April,0) ELSE 0 END +
            CASE WHEN @LatestMonth &gt;= 5  THEN ISNULL(ms.May,0)   ELSE 0 END +
            CASE WHEN @LatestMonth &gt;= 6  THEN ISNULL(ms.June,0)  ELSE 0 END +
            CASE WHEN @LatestMonth &gt;= 7  THEN ISNULL(ms.July,0)  ELSE 0 END +
            CASE WHEN @LatestMonth &gt;= 8  THEN ISNULL(ms.Aug,0)   ELSE 0 END +
            CASE WHEN @LatestMonth &gt;= 9  THEN ISNULL(ms.Sep,0)   ELSE 0 END +
            CASE WHEN @LatestMonth &gt;= 10 THEN ISNULL(ms.Oct,0)   ELSE 0 END +
            CASE WHEN @LatestMonth &gt;= 11 THEN ISNULL(ms.Nov,0)   ELSE 0 END +
            CASE WHEN @LatestMonth &gt;= 12 THEN ISNULL(ms.Dec,0)   ELSE 0 END
        AS FLOAT) ELSE 0 END) / 1000.0 AS CurYTD,
        SUM(CASE WHEN ms.Year = @PrevYear THEN CAST(
            CASE WHEN @LatestMonth &gt;= 1  THEN ISNULL(ms.Jan,0)   ELSE 0 END +
            CASE WHEN @LatestMonth &gt;= 2  THEN ISNULL(ms.Feb,0)   ELSE 0 END +
            CASE WHEN @LatestMonth &gt;= 3  THEN ISNULL(ms.Mar,0)   ELSE 0 END +
            CASE WHEN @LatestMonth &gt;= 4  THEN ISNULL(ms.April,0) ELSE 0 END +
            CASE WHEN @LatestMonth &gt;= 5  THEN ISNULL(ms.May,0)   ELSE 0 END +
            CASE WHEN @LatestMonth &gt;= 6  THEN ISNULL(ms.June,0)  ELSE 0 END +
            CASE WHEN @LatestMonth &gt;= 7  THEN ISNULL(ms.July,0)  ELSE 0 END +
            CASE WHEN @LatestMonth &gt;= 8  THEN ISNULL(ms.Aug,0)   ELSE 0 END +
            CASE WHEN @LatestMonth &gt;= 9  THEN ISNULL(ms.Sep,0)   ELSE 0 END +
            CASE WHEN @LatestMonth &gt;= 10 THEN ISNULL(ms.Oct,0)   ELSE 0 END +
            CASE WHEN @LatestMonth &gt;= 11 THEN ISNULL(ms.Nov,0)   ELSE 0 END +
            CASE WHEN @LatestMonth &gt;= 12 THEN ISNULL(ms.Dec,0)   ELSE 0 END
        AS FLOAT) ELSE 0 END) / 1000.0 AS PrevYTD
    FROM MonthlySales ms
    WHERE ms.Year IN (@CurYear, @PrevYear)
    GROUP BY ms.CompanyId
)
SELECT
    @M1Label AS M1Label,
    @M2Label AS M2Label,
    @M3Label AS M3Label,
    LEFT(c.Symbol, 4)                                AS Code,
    c.ChtName,
    c.Industry,
    ISNULL(cdi.IndustryNames, '')                    AS IndustryNames,
    CAST(m3.amt / 1000.0 AS BIGINT)                  AS M3_Val,
    CAST(m3.amt / pm3.amt AS DECIMAL(10,1))           AS M3_YoY,
    CAST(m2.amt / 1000.0 AS BIGINT)                  AS M2_Val,
    CAST(m2.amt / pm2.amt AS DECIMAL(10,1))           AS M2_YoY,
    CAST(m1.amt / 1000.0 AS BIGINT)                  AS M1_Val,
    CAST(m1.amt / pm1.amt AS DECIMAL(10,1))           AS M1_YoY,
    CAST(ytd.CurYTD AS BIGINT)                       AS YTD_Val,
    CAST(ytd.CurYTD / ytd.PrevYTD AS DECIMAL(10,1))  AS YTD_YoY
FROM Company c
JOIN MV m1  ON c.CompanyId = m1.CompanyId  AND m1.Year  = @M1Year     AND m1.m  = @M1Month
JOIN MV m2  ON c.CompanyId = m2.CompanyId  AND m2.Year  = @M2Year     AND m2.m  = @M2Month
JOIN MV m3  ON c.CompanyId = m3.CompanyId  AND m3.Year  = @M3Year     AND m3.m  = @M3Month
JOIN MV pm1 ON c.CompanyId = pm1.CompanyId AND pm1.Year = @M1Year - 1 AND pm1.m = @M1Month AND pm1.amt &gt; 10000
JOIN MV pm2 ON c.CompanyId = pm2.CompanyId AND pm2.Year = @M2Year - 1 AND pm2.m = @M2Month AND pm2.amt &gt; 10000
JOIN MV pm3 ON c.CompanyId = pm3.CompanyId AND pm3.Year = @M3Year - 1 AND pm3.m = @M3Month AND pm3.amt &gt; 10000
JOIN YTD ytd ON c.CompanyId = ytd.CompanyId
LEFT JOIN CompanyDetailedIndustry cdi ON c.CompanyID = cdi.CompanyID
WHERE c.Status = 1 AND c.CountryCode = 'TW'
  AND c.Industry IN (@Industry)
  AND (
      cdi.CompanyID IS NULL
      OR EXISTS (
          SELECT 1 FROM IndustryIndex ii
          WHERE ii.IndustryName IN (@IndustryNames)
          AND cdi.IndustryNames LIKE '%' + ii.IndustryName + '%'
      )
  )
  AND m1.amt &gt; 0
  AND m1.amt &gt; pm1.amt
  AND m2.amt &gt; pm2.amt
  AND m3.amt &gt; pm3.amt
ORDER BY ytd.CurYTD / ytd.PrevYTD DESC
        </CommandText>
      </Query>
      <Fields>
        <Field Name="M1Label"><DataField>M1Label</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="M2Label"><DataField>M2Label</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="M3Label"><DataField>M3Label</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Code"><DataField>Code</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="ChtName"><DataField>ChtName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Industry"><DataField>Industry</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="IndustryNames"><DataField>IndustryNames</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="M3_Val"><DataField>M3_Val</DataField><rd:TypeName>System.Int64</rd:TypeName></Field>
        <Field Name="M3_YoY"><DataField>M3_YoY</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="M2_Val"><DataField>M2_Val</DataField><rd:TypeName>System.Int64</rd:TypeName></Field>
        <Field Name="M2_YoY"><DataField>M2_YoY</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="M1_Val"><DataField>M1_Val</DataField><rd:TypeName>System.Int64</rd:TypeName></Field>
        <Field Name="M1_YoY"><DataField>M1_YoY</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="YTD_Val"><DataField>YTD_Val</DataField><rd:TypeName>System.Int64</rd:TypeName></Field>
        <Field Name="YTD_YoY"><DataField>YTD_YoY</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="Industry">
      <DataType>String</DataType>
      <MultiValue>true</MultiValue>
      <ValidValues>
        <DataSetReference>
          <DataSetName>IndustryList</DataSetName>
          <ValueField>Industry</ValueField>
          <LabelField>Industry</LabelField>
        </DataSetReference>
      </ValidValues>
      <DefaultValue>
        <Values>
          <Value>半導體</Value>
        </Values>
      </DefaultValue>
      <Prompt>產業</Prompt>
    </ReportParameter>
    <ReportParameter Name="IndustryNames">
      <DataType>String</DataType>
      <MultiValue>true</MultiValue>
      <ValidValues>
        <DataSetReference>
          <DataSetName>IndustryNamesList</DataSetName>
          <ValueField>IndustryName</ValueField>
          <LabelField>IndustryName</LabelField>
        </DataSetReference>
      </ValidValues>
      <DefaultValue>
        <DataSetReference>
          <DataSetName>IndustryNamesList</DataSetName>
          <ValueField>IndustryName</ValueField>
        </DataSetReference>
      </DefaultValue>
      <Prompt>細產業</Prompt>
    </ReportParameter>
  </ReportParameters>
