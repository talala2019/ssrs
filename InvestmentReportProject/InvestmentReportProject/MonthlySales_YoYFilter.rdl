  <Code>
Public Function YoYColor(yoy As Decimal) As String
    If yoy &gt;= 1.3D Then
        Return "DarkRed"
    ElseIf yoy &gt;= 1.1D Then
        Return "DarkGreen"
    Else
        Return "SeaGreen"
    End If
End Function

Public Function YoYWeight(yoy As Decimal) As String
    If yoy &gt;= 1.3D Then
        Return "Bold"
    Else
        Return "Normal"
    End If
End Function

Public Function YoYBg(yoy As Decimal) As String
    If yoy &gt;= 1.3D Then
        Return "#FFFACD"
    Else
        Return "White"
    End If
End Function
  </Code>
