                      <CellContents>
                        <Textbox Name="Textbox13">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Switch(
Format(Fields!PriceDate.Value, "yyyy-MM-dd") = "2026-04-16", "*** 法說會 *** ",
Format(Fields!PriceDate.Value, "yyyy-MM-dd") = "2026-07-10", "*** 即將法說會 *** ",
Format(Fields!PriceDate.Value, "yyyy-MM-dd") = "2026-10-10", "*** 即將法說會 *** ",
Format(Fields!PriceDate.Value, "yyyy-MM-dd") = "2027-01-10", "*** 即將法說會 *** ",
IsNothing(Fields!Premium.Value)=false and Fields!tsm_chg1.Value&gt;3 and (Fields!tsm_chg1.Value-Fields!tw2330_chg1.Value)&gt;4.5, " +++ ADR 領先大漲 +++ ",
IsNothing(Fields!Premium.Value)=false and Fields!tsm_chg1.Value&lt;-3 and (Fields!tsm_chg1.Value-Fields!tw2330_chg1.Value)&lt;-4.5, " --- ADR 領先大跌 --- ",
IsNothing(Fields!Premium.Value)=false and Fields!Premium.Value&lt;(Sum(Fields!AvgPremium.Value, "DataSet2")-0.05) and Fields!Day0_K.Value&lt;25,"[ A ] 双超賣，Sell OTM Put 或 分批買台股",
IsNothing(Fields!Premium.Value)=false and Fields!Premium.Value&lt;(Sum(Fields!AvgPremium.Value, "DataSet2")+0.01) and Fields!Day0_D.Value&gt;50 and Fields!Day0_D.Value&lt;60 and Fields!Day0_K.Value&gt;Fields!Day1_K.Value and Fields!Day0_D.Value&gt;Fields!Day1_D.Value,"[ B ] 多頭拉回轉強",
IsNothing(Fields!Premium.Value)=false and Fields!Premium.Value&gt;(Sum(Fields!AvgPremium.Value, "DataSet2")+0.05) and Fields!Day0_K.Value&lt;40,"[ C ] 美股看好，買台股",
IsNothing(Fields!Premium.Value)=false and Fields!Premium.Value&gt;(Sum(Fields!AvgPremium.Value, "DataSet2")+0.05) and Fields!Day0_K.Value&gt;90,"[ D ] 双超買，兩邊過熱",
IsNothing(Fields!Premium.Value)=false and Fields!Premium.Value&lt;(Sum(Fields!AvgPremium.Value, "DataSet2")-0.04) and Fields!Day0_K.Value&gt;90,"[ E ] 台股過熱 K開始鈍化，美股不跟。--&gt; ADR補漲前不宜作多。當台股降溫，D&gt;50多頭也不須大幅減碼。一旦ADR領先大漲，台股站回Ma5又可加碼，直到台股又過熱或溢價過大。",
IsNothing(Fields!Premium.Value)=false and Fields!Premium.Value&lt;(Sum(Fields!AvgPremium.Value, "DataSet2")-0.04) and Fields!Day0_K.Value&gt;85 and Fields!Days_CloseOnMa5.Value&gt;=7,"[ E ] 台股過熱 K開始鈍化，美股不跟。--&gt; ADR補漲前不宜作多。當台股降溫，D&gt;50多頭也不須大幅減碼。一旦ADR領先大漲，台股站回Ma5又可加碼，直到台股又過熱或溢價過大。",
0=0,"")</Value>
                                  <Style>
                                    <FontFamily />
                                    <FontSize>11pt</FontSize>
                                    <Color>DarkBlue</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Center</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
