                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Switch(Weekday(Fields!PriceDate.Value) = 2, "一", Weekday(Fields!PriceDate.Value) = 3, "二", Weekday(Fields!PriceDate.Value) = 4, "三", Weekday(Fields!PriceDate.Value) = 5, "四", Weekday(Fields!PriceDate.Value) = 6, "五", Weekday(Fields!PriceDate.Value) = 7, "六")</Value>
