<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource_localhost">
      <DataSourceReference>DataSource_localhost</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>5784b6ae-35e8-46b7-9f12-4203d8a3893e</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <CommandText>select 
    A.PriceDate, 
    A.DayClose as 'TSM', 
    B.DayClose as 'TW2330', 
    C.DayClose as 'TWD=X',
    -- Use CASE to handle NULL or Zero to avoid math errors
    CASE 
        WHEN B.DayClose IS NULL OR B.DayClose = 0 THEN NULL 
        ELSE ((A.DayClose / 5) * ISNULL(C.DayClose, 31.5)) / B.DayClose 
    END as 'Premium',
    SPI.Day0_K, SPI.Day1_K, SPI.Day0_D, SPI.Day1_D, SPI.Days_CloseOnMa5, SPI.Close_Chg1 as 'tw2330_chg1', TSM.Close_Chg1 as 'tsm_chg1'
from StockDailyData as A
left join StockDailyData as B on A.PriceDate = B.PriceDate and B.CompanyID = 291 -- 2330
left join StockDailyData as C on A.PriceDate = C.PriceDate and C.CompanyID = 3099 -- TWD=X
left join StockPriceIndicator as SPI on A.PriceDate = SPI.PriceDate and SPI.CompanyID = 291
left join StockPriceIndicator as TSM on A.PriceDate = TSM.PriceDate and TSM.CompanyID = 3542
where A.CompanyID = 3542 -- TSM
  and A.PriceDate &gt; getdate() - 360
order by A.PriceDate desc</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="PriceDate">
          <DataField>PriceDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="TSM">
          <DataField>TSM</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="TW2330">
          <DataField>TW2330</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="TWD_X">
          <DataField>TWD=X</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Premium">
          <DataField>Premium</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Day0_K">
          <DataField>Day0_K</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Day1_K">
          <DataField>Day1_K</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Day0_D">
          <DataField>Day0_D</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Day1_D">
          <DataField>Day1_D</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Days_CloseOnMa5">
          <DataField>Days_CloseOnMa5</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="tw2330_chg1">
          <DataField>tw2330_chg1</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="tsm_chg1">
          <DataField>tsm_chg1</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <CommandText>select AVG(C.DayClose) as 'AvgTWDX',    AVG(((A.DayClose/5)*C.DayClose)/B.DayClose) as 'AvgPremium'
from StockDailyData as A
inner join StockDailyData as B on A.PriceDate=B.PriceDate
inner join StockDailyData as C on A.PriceDate=C.PriceDate
where A.CompanyID=3542 and B.CompanyID=291 and C.CompanyID=3099 and A.PriceDate&gt;getdate()-180</CommandText>
      </Query>
      <Fields>
        <Field Name="AvgTWDX">
          <DataField>AvgTWDX</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="AvgPremium">
          <DataField>AvgPremium</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
