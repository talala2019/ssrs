<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource_localhost">
      <DataSourceReference>DataSource_localhost</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>dbad599c-fdcf-4813-9544-51add775f4fe</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@pid">
            <Value>=Parameters!pid.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@pricedate">
            <Value>=Parameters!pricedate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>WITH CPO_BaseData AS (
    -- 1. 篩選出 CPO 與光通訊核心族群，並計算單日漲跌幅
    SELECT
		sdd.PriceDate,
        Symbol, 
        ChtName,
        DayClose,
        PreClose,
        Volume,         -- 今日成交量
        Vol_MA5,        -- 5日均量
        -- 計算漲跌幅 (%)，加上 .0 強制轉為浮點數確保精確
        ((DayClose - PreClose) / PreClose) * 100.0 AS ChangePct
    FROM Company as com
	inner join temp_company_sdd as sdd on com.CompanyID=sdd.CID
    WHERE com.Status=1 and com.CountryCode='TW' 
	and sdd.CID in (select CompanyID from PortfolioStock where PID in (@pid))
	and sdd.PriceDate=@pricedate 
),
Sector_Aggregation AS (
    -- 2. 使用視窗函數計算「族群平均」與「量能激增比」
    SELECT 
        *,
        -- 視窗函數：不群組資料列的情況下，算出這 4 檔股票的平均漲跌幅
        AVG(ChangePct) OVER () AS SectorAvgChange,
        
        -- 計算量能激增比 (防呆機制：避免除以 0)
        (Volume / NULLIF(Vol_MA5, 1.0)) AS VolRatio
    FROM CPO_BaseData
)
-- 3. 計算最終資金總分與排名
SELECT
	PriceDate,
    Symbol,
    ChtName,
    DayClose,
    CAST(ChangePct AS DECIMAL(10,2)) AS ChangePct,
    CAST(SectorAvgChange AS DECIMAL(10,2)) AS SectorAvgChange,
    CAST(VolRatio AS DECIMAL(10,2)) AS VolRatio,
    
    -- 核心指標：(個股漲幅 - 族群平均) * 權重 + (量能比) * 權重
    -- 這裡設定價格強勢度佔 60%，量能佔 40%，您可依盤感微調
    CAST((ChangePct - SectorAvgChange) * 0.6 + (VolRatio * 0.4) AS DECIMAL(10,2)) AS CapitalFlowScore,
    
    -- 視窗函數：依據資金總分自動進行 1~4 名排序
    RANK() OVER (ORDER BY ((ChangePct - SectorAvgChange) * 0.6 + (VolRatio * 0.4)) DESC) AS FlowRank
FROM Sector_Aggregation
ORDER BY FlowRank;</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="PriceDate">
          <DataField>PriceDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Symbol">
          <DataField>Symbol</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ChtName">
          <DataField>ChtName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DayClose">
          <DataField>DayClose</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="ChangePct">
          <DataField>ChangePct</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="SectorAvgChange">
          <DataField>SectorAvgChange</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="VolRatio">
          <DataField>VolRatio</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="CapitalFlowScore">
          <DataField>CapitalFlowScore</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="FlowRank">
          <DataField>FlowRank</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="PriceDateList">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <CommandText>SELECT DISTINCT PriceDate
FROM   temp_company_sdd
WHERE (PriceDate &gt; GETDATE() - 30) 
and CID in (282,291)
ORDER BY PriceDate Desc</CommandText>
      </Query>
      <Fields>
        <Field Name="PriceDate">
          <DataField>PriceDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="PortfolioList">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <CommandText>select PID, REPLACE(REPLACE(Name, '_000', ''), '_002', ''), REPLACE(REPLACE(Name, '_000', ''), '_002', '')+' '+CAST(PID as varchar(10)) as'NameID' from PortfolioMain
where Name like '%1T_000%' or Name like '%1T_002%' or userid='myreport'
order by name, priority, pid
</CommandText>
      </Query>
      <Fields>
        <Field Name="PID">
          <DataField>PID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ID">
          <DataField />
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NameID">
          <DataField>NameID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
