  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@countryCode">
            <Value>=Parameters!countryCode.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@industry">
            <Value>=Parameters!industry.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@salesYoY">
            <Value>=Parameters!salesYoY.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@pricedate">
            <Value>=Parameters!pricedate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@symbol">
            <Value>=Parameters!symbol.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@volume">
            <Value>=Parameters!volume.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@fi1_ratio">
            <Value>=Parameters!fi1_ratio.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@fi6_ratio">
            <Value>=Parameters!fi6_ratio.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@fi12_ratio">
            <Value>=Parameters!fi12_ratio.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@fi60_ratio">
            <Value>=Parameters!fi60_ratio.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@close_chg1">
            <Value>=Parameters!close_chg1.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@close_chg6">
            <Value>=Parameters!close_chg6.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@close_chg12">
            <Value>=Parameters!close_chg12.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@companySignal">
            <Value>=Parameters!companySignal.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@companyStatus">
            <Value>=Parameters!companyStatus.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@signalType">
            <Value>=Parameters!signalType.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@AccITBuy">
            <Value>=Parameters!AccITBuy.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@AccITBuyDay">
            <Value>=Parameters!AccITBuyDay.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@breakth_high">
            <Value>=Parameters!breakth_high.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@daysCloseOnMa5">
            <Value>=Parameters!daysCloseOnMa5.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@InvestTrustVol_Ratio">
            <Value>=Parameters!InvestTrustVol_Ratio.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@volMultiple">
            <Value>=Parameters!volMultiple.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Ma20Bias">
            <Value>=Parameters!Ma20Bias.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Instilinvest_1_ratio">
            <Value>=Parameters!Instilinvest_1_ratio.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select Com.CompanyID as 'CID',
Com.Industry, Com.Sector, Com.DLGroup, 
Com.ChtName, Com.Symbol, substring(Com.Symbol,0,5) as 'Code', 
Com.CountryCode, Com.Capital,
temp_sdd.PriceDate, temp_sdd.DayOpen, temp_sdd.DayHigh, temp_sdd.DayLow,  temp_sdd.DayClose, temp_sdd.PreClose,
Cast((temp_sdd.DayClose-temp_sdd.MA60)/temp_sdd.MA60 as DECIMAL(10,2)) as 'D_60_Div',
Cast((temp_sdd.DayClose-temp_sdd.MA100)/temp_sdd.MA100 as DECIMAL(10,2)) as 'D_100_Div', 
temp_sdd.Volume, temp_sdd.Vol_MA3, temp_sdd.Vol_MA5, temp_sdd.Vol_MA15, temp_sdd.Vol_MA20, 
Cast(temp_sdd.Vol_MA5/temp_sdd.Vol_MA20 as DECIMAL(10,2)) as 'VolMul_5_20',
temp_sdd.MA5, temp_sdd.MA10, temp_sdd.MA11, temp_sdd.MA20, temp_sdd.MA42, temp_sdd.MA60, temp_sdd.MA100,
temp_swd.EndDate as 'W-EndDate', temp_swd.WeekClose as 'W-Close', temp_swd.WeekMA60 as 'W-MA60', temp_swd.WeekMA60_Div_Pct as 'W_60_Div', 
temp_swd.WeekTrend as 'W-T', temp_swd.WeekMACDStatus as 'W-macd', temp_swd.WeekDMI as 'W-DMI', temp_swd.WeekADX14 as 'W-ADX',
msales.year, msales.month, msales.msales, msales.salesYoY, msales.msalesresult,
pe.name, pe.yield, pe.pe_ratio, pe.pb_ratio, pe.quarter,
instilinvest.ForeignInvest,
instilinvest.ForeignInvest_MA3,
instilinvest.ForeignInvest_MA6,
instilinvest.ForeignInvest_MA12,
instilinvest.ForeignInvest_MA20,
instilinvest.ForeignInvest_MA40,
instilinvest.ForeignInvest_MA60,
instilinvest.InvestTrust,
instilinvest.InvestTrust_MA3,
instilinvest.InvestTrust_MA6,
instilinvest.InvestTrust_MA12,
instilinvest.InvestTrust_MA20,
instilinvest.InvestTrust_MA40,
instilinvest.InvestTrust_MA60,
instilinvest.Dealer,
instilinvest.Dealer_MA3,
instilinvest.Dealer_MA6,
instilinvest.Dealer_MA12,
instilinvest.Dealer_MA20,
instilinvest.Dealer_MA40,
instilinvest.Dealer_MA60,
instilinvest.BuySellTotal,
instilinvest.BuySellRunningTotal,
instilinvest.MaxBuySellRunningTotal,
instilinvest.BuySellTotal_MA3,
instilinvest.BuySellTotal_MA6,
instilinvest.BuySellTotal_MA12,
instilinvest.BuySellTotal_MA20,
instilinvest.BuySellTotal_MA40,
instilinvest.BuySellTotal_MA60,
spi.Day0_K,
spi.Day0_D,
spi.Day0_Dif,
spi.Day0_Macd,
spi.Day1_K,
spi.Day1_D,
spi.Day1_Dif,
spi.Day1_Macd,
spi.KLine_Status,
spi.MA5_Status,
--spi.MA10_Status,
spi.MA20_Status,
spi.MA42_Status,
spi.MA60_Status,
spi.Day1_Vol,
spi.VolAvg3_Status,
spi.Day0_Bar,
spi.Day0_Bar_Status,
spi.Day0_W9,
spi.Day0_W55,
spi.Days_CloseOnMa5,
spi.Days_VolMa3OnMa15,
spi.Days_Ma5OnMa20,
spi.Close_Chg1,
spi.Close_Chg3,
spi.Close_Chg5,
spi.Close_Chg6,
spi.Close_Chg12,
--spi.Close_Chg10,
spi.Close_Chg20,
spi.Close_Chg40,
spi.Close_Chg60,
spi.Close_Chg120,
spi.BT_60DaysHigh,
spi.BT_120DaysHigh,
spi.FB_60DaysLow,
spi.FB_120DaysLow,
mt.PreMarginRmng,
mt.MarginRmng,
mt.MarginTtl,
mt.PreShortSellingRmng,
mt.ShortSellingRmng,
mt.ShortSellingTtl,
dt.Volume/1000 as 'DayTrade_Vol',
tt.TrendTrackingSignal,
tt.SignalType,
tt.SignalCount,
tt.SignalDay,
tt.AccCloseChg,
tt.AccFI1,
tt.MaxAccFI1Sell,
tt.MaxAccInvestTrustBuy,
tt.MaxAccInvestTrustBuyDay,
tt.MaxFI12,
tt.MaxFI20,
tt.AccMargin1,
tt.MaxAccMargin1Sell,
((instilinvest.ForeignInvest+instilinvest.InvestTrust+instilinvest.Dealer)/Com.Capital)*100 as 'InsInvest_Ratio',
(instilinvest.InvestTrust/(temp_sdd.Volume-(dt.Volume/1000))) as 'InvestTrustVol_Ratio',
com_signal.Signal,
com_status.Status,
com_status.Status_StartDate,
com_status.BreakTh_High,
com_status.Above_High,
com_status.FallBelow_Low
from Company as Com 
inner join temp_company_sdd as temp_sdd on Com.CompanyID=temp_sdd.CID
left join CompanySignalTracking as com_signal on Com.CompanyID=com_signal.CompanyID and temp_sdd.PriceDate=com_signal.PriceDate
left join CompanyStatus as com_status on Com.CompanyID=com_status.CompanyID and temp_sdd.PriceDate=com_status.PriceDate
left join temp_company_swd as temp_swd on temp_sdd.CID=temp_swd.CompanyID and temp_sdd.PriceDate=temp_swd.EndDate
left join temp_company_msalesYoY as msales on com.CompanyID=msales.cid
left join temp_company_instilinvest as instilinvest on Com.CompanyID=instilinvest.CID and instilinvest.DataDate=temp_sdd.PriceDate
left join temp_company_spi as spi on Com.CompanyID=spi.CompanyID and spi.PriceDate=temp_sdd.PriceDate
left join MarginTrading as mt on temp_sdd.CID=mt.cid and temp_sdd.PriceDate=mt.DataDate
left join DayTrading as dt on temp_sdd.CID=dt.cid and temp_sdd.PriceDate=dt.DataDate
left join Trend_Tracking as tt on Com.CompanyID=tt.CID and temp_sdd.PriceDate=tt.PriceDate
--left join companyinfo as cominfo on Com.CompanyID=cominfo.CompanyID
left join temp_company_pe as pe on SUBSTRING(com.Symbol,0,5)=ltrim(rtrim(pe.symbol))

where 

-- 參數
com.status=1
and com.CountryCode=@countryCode									-- Country
and (com.industry like '%'+@industry+'%')							-- Industry
and (msales.salesYoY is null or msales.salesYoY	&gt; @salesYoY)		-- 累計營收年增率					
and temp_sdd.PriceDate=@pricedate									-- sdd pricedate
and (Com.Symbol like '%'+ltrim(rtrim(@symbol))+'%' or Com.Chtname like N'%'+ltrim(rtrim(@symbol))+'%') 		-- symbol
and (temp_sdd.DayClose * temp_sdd.Volume &gt;= @volume)				-- 中大量
and ((((instilinvest.ForeignInvest+instilinvest.InvestTrust)/Com.Capital)*100 &gt;= @fi1_ratio) or (instilinvest.ForeignInvest is Null) or (instilinvest.InvestTrust is Null))
and ((((instilinvest.ForeignInvest_MA6+instilinvest.InvestTrust_MA6)/Com.Capital)*100 &gt;= @fi6_ratio) or (instilinvest.ForeignInvest_MA6 is Null) or (instilinvest.InvestTrust_MA6 is Null))
and ((((instilinvest.ForeignInvest_MA12+instilinvest.InvestTrust_MA12)/Com.Capital)*100 &gt;= @fi12_ratio) or (instilinvest.ForeignInvest_MA12 is Null) or (instilinvest.InvestTrust_MA12 is Null))
and ((((instilinvest.ForeignInvest_MA60+instilinvest.InvestTrust_MA60)/Com.Capital)*100 &gt;= @fi60_ratio) or (instilinvest.ForeignInvest_MA60 is Null) or (instilinvest.InvestTrust_MA60 is Null))
and spi.Close_Chg1&lt;=@close_chg1
and spi.Close_Chg6&lt;=@close_chg6
and spi.Close_Chg12&lt;=@close_chg12
and (com_signal.Signal LIKE N'%'+ltrim(rtrim(@companySignal))+'%' or com_signal.Signal is null ) -- 目前訊號
and (com_status.Status LIKE N'%'+ltrim(rtrim(@companyStatus))+'%' or com_status.Status is null ) -- company status
and (tt.SignalType LIKE N'%'+ltrim(rtrim(@signalType))+'%' or tt.SignalType is null) -- signal type
and (tt.MaxAccInvestTrustBuy&gt;=@AccITBuy) --投信連買
and (tt.MaxAccInvestTrustBuyDay&lt;=@AccITBuyDay) --投信連買天數
and (com_status.BreakTh_High like '%'+@breakth_high+'%' or com_status.BreakTh_High is null) -- 今過黑Ｋ高點
and (spi.Days_CloseOnMa5&gt;@daysCloseOnMa5) -- 站上MA5天數
and (( instilinvest.InvestTrust/(temp_sdd.Volume-(dt.Volume/1000))*100 )&gt;=@InvestTrustVol_Ratio or dt.Volume is null) -- 投量比
and (temp_sdd.Volume/spi.Day1_Vol&gt;=@volMultiple)
and (temp_sdd.DayClose/temp_sdd.MA20&lt;=@Ma20Bias) -- 偏離 MA20 
-- 1 法本
and ((((instilinvest.ForeignInvest+instilinvest.InvestTrust+instilinvest.Dealer)/Com.Capital)*100 &lt;= @Instilinvest_1_ratio) or (instilinvest.ForeignInvest is Null) or (instilinvest.InvestTrust is Null) or (instilinvest.Dealer is Null))
order by InsInvest_Ratio desc</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
