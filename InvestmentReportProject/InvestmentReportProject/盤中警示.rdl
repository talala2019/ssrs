    <DataSet Name="ValueList">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <CommandText>SELECT value
FROM (VALUES (0), (1), (2), (3)) AS Numbers(value);</CommandText>
      </Query>
