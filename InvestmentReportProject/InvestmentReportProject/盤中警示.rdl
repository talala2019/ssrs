<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource_localhost">
      <DataSourceReference>DataSource_localhost</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>96f5ca0a-1027-4897-a3dd-8fa0b45598b9</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@symbol">
            <Value>=Parameters!symbol.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@detailedIndustry">
            <Value>=Parameters!detailedIndustry.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@closechage">
            <Value>=Parameters!closechage.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@downchage">
            <Value>=Parameters!downchage.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@stockfuture">
            <Value>=Parameters!stockfuture.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@from_low">
            <Value>=Parameters!from_low.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@from_high">
            <Value>=Parameters!from_high.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@pid1">
            <Value>=Parameters!pid1.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>--Use INVESTMENT_DB

declare @today date
declare @pre_date date

select @today=MAX(PriceDateTime) from QuoteCom_30026;
select @pre_date=MAX(PriceDate) from temp_company_sdd where PriceDate&lt;=@today;

WITH LatestCompanyChips AS (
    SELECT
        cc.*,
        ROW_NUMBER() OVER (PARTITION BY cc.cid ORDER BY cc.pricedate DESC) AS rn
    FROM
        temp_company_chips cc
)

select
ROW_NUMBER() over (order by (TotalMatchQty*dbo.Get_Volume_Multiple()/com.Capital) desc) as row_no,
FORMAT(CAST( quotecom.ChgTime AS DATETIME2), 'yyyy-MM-dd HH:mm') as "update_time", 
com.CompanyID as "CID", 
StockNumber as "StockNo", 
com.ChtName as "Name", 
com.Capital/10000 as "Capital", 
temp_sdd.DayClose as "昨收", 
FirstMatchPrice as "開盤", 
CAST(((FirstMatchPrice-temp_sdd.DayClose)/temp_sdd.DayClose)*100 AS DECIMAL(18,2)) as "開幅", 
DayHighPrice as "High", DayLowPrice as "Low",LastMatchPrice as "成交價",  
CAST((LastMatchPrice-temp_sdd.DayClose) AS DECIMAL(18,2)) as "漲跌", 
CAST(((LastMatchPrice-temp_sdd.DayClose)/temp_sdd.DayClose)*100 AS DECIMAL(18,2)) as "漲幅", 
TotalMatchQty as "成交量", 
CAST(TotalMatchQty*dbo.Get_Volume_Multiple() AS INT) as "預估量",
CAST((TotalMatchQty*dbo.Get_Volume_Multiple())/temp_sdd.vol_ma20 AS DECIMAL(18,2)) as "均量比",
CAST((TotalMatchQty*dbo.Get_Volume_Multiple()/com.Capital)*100 AS DECIMAL(18,2)) as TurnOverRate,
com.Industry, comDetailedIndus.IndustryNames,
CASE 
	WHEN comInfo.Stock_Future IN (1, 3) THEN N'有'
	ELSE '' -- or whatever you want for other values
END AS "股期",
comInfo.Pid,
lcc.symbol as 'chip_symbol',
FORMAT(lcc.pricedate, 'yyyy-MM-dd') as 'chip_pricedate',
lcc.mi_buy,
lcc.mi_sell,
lcc.key_buy,
lcc.key_sell,
lcc.chip_good,
lcc.chip_bad,
lcc.floor,
lcc.call_warrant,
lcc.put_warrant,
lcc.bband_up,
lcc.bband_down,
-- 2. Institutional Ratios (Using NULLIF on Capital)
CONVERT(DECIMAL(10,2),((INS.ForeignInvest + INS.InvestTrust) / NULLIF(Com.Capital, 0)) * 100) as 'FIRatio1',
CONVERT(DECIMAL(10,2),((INS.ForeignInvest_MA3 + INS.InvestTrust_MA3) / NULLIF(Com.Capital, 0)) * 100) as 'FIRatio3',
CONVERT(DECIMAL(10,2),((INS.ForeignInvest_MA6 + INS.InvestTrust_MA6) / NULLIF(Com.Capital, 0)) * 100) as 'FIRatio6',
temp_spi.Close_Chg1,
temp_spi.Close_Chg3,
temp_spi.Close_Chg6,
temp_sdd.DayOpen,
temp_sdd.DayHigh,
temp_sdd.DayLow,
temp_sdd.DayClose,
temp_sdd.MA10,
temp_sdd.MA11,
temp_sdd.MA240,
-- 核心邏輯：透過 CROSS APPLY 取得三者最大值
calc.AbsoluteStop,
FE.Status,
FE.Trend,
FE.DS_HR,
FE.StopLossPoint,
FE.DS_PR,
FE.TakeProfitPoint
from QuoteCom_30026 as quotecom
inner join Company as com on quotecom.StockNumber=left(com.Symbol,4)
inner join CompanyInfo as comInfo on com.CompanyID=comInfo.CompanyID
inner join temp_company_sdd as temp_sdd on com.CompanyID=temp_sdd.CID
inner join temp_company_spi as temp_spi on com.CompanyID=temp_spi.CompanyID and temp_sdd.PriceDate=temp_spi.PriceDate
LEFT JOIN FinancialEst as FE on temp_sdd.CID=FE.CompanyID and FE.Status='Est' and FE.Trend='OK'
LEFT JOIN temp_company_instilinvest as INS on com.CompanyID=INS.CID AND INS.DataDate=temp_spi.PriceDate
left join CompanyDetailedIndustry as comDetailedIndus on com.CompanyID=comDetailedIndus.CompanyID
LEFT JOIN LatestCompanyChips lcc on com.CompanyID=lcc.cid and lcc.rn = 1 and lcc.pricedate&gt;getdate()-8
CROSS APPLY (
    SELECT MAX(val) AS AbsoluteStop
    FROM (VALUES 
        (temp_sdd.MA10), 
        (temp_sdd.DayLow * 0.97), 
        -- 紅 K 中值邏輯：收盤 &gt; 開盤才計算，否則給 0
        (CASE 
            WHEN temp_sdd.DayClose &gt; temp_sdd.DayOpen 
            THEN (temp_sdd.DayClose + temp_sdd.DayOpen) / 2.0 
            ELSE 0 
         END)
    ) AS t(val)
) AS calc
where quotecom.PriceDateTime = @today -- 今日
and temp_sdd.PriceDate = @pre_date	-- 昨日
and com.CountryCode='TW'
and com.Status=1
and temp_sdd.PreClose&lt;&gt;0
and (com.Symbol like '%'+ltrim(rtrim(@symbol))+'%' or Com.Chtname like N'%'+ltrim(rtrim(@symbol))+'%')
and ((comDetailedIndus.IndustryNames like N'%'+ltrim(rtrim(@detailedIndustry))+'%') or comDetailedIndus.IndustryNames is null)
and (((LastMatchPrice-temp_sdd.DayClose)/temp_sdd.DayClose)*100)&gt;=@closechage
and (((LastMatchPrice-temp_sdd.DayClose)/temp_sdd.DayClose)*100)&lt;=@downchage
and comInfo.Stock_Future in (@stockfuture)
and TotalMatchQty&gt;0
and ((LastMatchPrice/DayLowPrice)-1)*100&gt;=@from_low
and abs(((LastMatchPrice/DayHighPrice)-1)*100)&gt;=@from_high
and (TotalMatchQty*dbo.Get_Volume_Multiple())&gt;=2000
and comInfo.Pid in (@pid1)
order by TurnOverRate desc</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
