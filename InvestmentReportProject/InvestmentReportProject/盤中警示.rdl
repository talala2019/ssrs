                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Format(((Fields!成交價.Value/Fields!High.Value)-1)*100,"#.0")+"%      "</Value>
                                  <Style>
                                    <FontFamily />
                                    <FontSize>11pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Color>=IIf(((Fields!成交價.Value/Fields!High.Value)-1)*100&lt;-2.5,"Green","DarkBlue")</Color>
                                  </Style>
