<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="14.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <FullPath>Debug</FullPath>
    <OutputPath>bin\Debug</OutputPath>
    <ErrorLevel>2</ErrorLevel>
    <OverwriteDatasets>False</OverwriteDatasets>
    <OverwriteDataSources>False</OverwriteDataSources>
    <TargetServerVersion>SSRS2016</TargetServerVersion>
    <Platform>Win32</Platform>
    <TargetReportFolder>InvestmentReportProject</TargetReportFolder>
    <TargetDatasetFolder>Datasets</TargetDatasetFolder>
    <TargetDatasourceFolder>Data Sources</TargetDatasourceFolder>
    <TargetReportPartFolder>Report Parts</TargetReportPartFolder>
    <TargetServerURL>http://localhost/reportserver</TargetServerURL>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'DebugLocal' ">
    <FullPath>DebugLocal</FullPath>
    <OutputPath>bin\DebugLocal</OutputPath>
    <ErrorLevel>2</ErrorLevel>
    <OverwriteDatasets>False</OverwriteDatasets>
    <OverwriteDataSources>False</OverwriteDataSources>
    <TargetServerVersion>SSRS2016</TargetServerVersion>
    <Platform>Win32</Platform>
    <TargetReportFolder>InvestmentReportProject</TargetReportFolder>
    <TargetDatasetFolder>Datasets</TargetDatasetFolder>
    <TargetDatasourceFolder>Data Sources</TargetDatasourceFolder>
    <TargetReportPartFolder>Report Parts</TargetReportPartFolder>
    <TargetServerURL>http://localhost/reportserver</TargetServerURL>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Release' ">
    <FullPath>Release</FullPath>
    <OutputPath>bin\Release</OutputPath>
    <ErrorLevel>2</ErrorLevel>
    <OverwriteDatasets>False</OverwriteDatasets>
    <OverwriteDataSources>False</OverwriteDataSources>
    <TargetServerVersion>SSRS2016</TargetServerVersion>
    <Platform>Win32</Platform>
    <TargetReportFolder>InvestmentReportProject</TargetReportFolder>
    <TargetDatasetFolder>Datasets</TargetDatasetFolder>
    <TargetDatasourceFolder>Data Sources</TargetDatasourceFolder>
    <TargetReportPartFolder>Report Parts</TargetReportPartFolder>
    <TargetServerURL>http://localhost/reportserver</TargetServerURL>
  </PropertyGroup>
  <PropertyGroup>
    <State>$base64$</State>
    <DataSources>@(DataSource)</DataSources>
    <DataSets>@(DataSet)</DataSets>
    <Reports>@(Report)</Reports>
  </PropertyGroup>
  <ItemGroup>
    <DataSource Include="DataSource_localhost.rds" />
    <DataSource Include="InMemoryOLTP_KGI_DB.rds" />
  </ItemGroup>
  <ItemGroup>
    <Report Include="ActionList.rdl" />
    <Report Include="BBand_Up_Report.rdl" />
    <Report Include="BearTrendFilter.rdl" />
    <Report Include="BullTrendFilter.rdl" />
    <Report Include="DisposedStock.rdl" />
    <Report Include="Industry_法人買賣超.rdl" />
    <Report Include="Industry_細產業漲跌幅.rdl" />
    <Report Include="Industry_類股漲跌幅.rdl" />
    <Report Include="Industry_類股漲跌幅_V2.rdl" />
    <Report Include="IntegratedReport.rdl" />
    <Report Include="IntegratedReport_V2.rdl" />
    <Report Include="Key_Branch.rdl" />
    <Report Include="Line_Msg_Log_Report_2.rdl" />
    <Report Include="L_M_Log_Report_3Min_1.rdl" />
    <Report Include="MarketData.rdl" />
    <Report Include="MonthlySales.rdl" />
    <Report Include="MonthlySales_YoYFilter.rdl" />
    <Report Include="FinancialStatements.rdl" />
    <Report Include="MatchOnBidOrAsk.rdl" />
    <Report Include="MatchOnBidOrAsk_V2.rdl" />
    <Report Include="QuoteSummary.rdl" />
    <Report Include="SDD_Correlations.rdl" />
    <Report Include="SDD_Correlations_V2.rdl" />
    <Report Include="StockDetails_V3.rdl" />
    <Report Include="Stocks_By_DetailedIndustry.rdl" />
    <Report Include="Stocks_By_Industry.rdl" />
    <Report Include="Stock_21Days.rdl" />
    <Report Include="Stock_21Days_V1.rdl" />
    <Report Include="TSM_Premium.rdl" />
    <Report Include="Volatility_平均震幅.rdl" />
    <Report Include="Volatility_週轉率.rdl" />
    <Report Include="WatchList.rdl" />
    <Report Include="個股買賣超.rdl" />
    <Report Include="多頭拉回買.rdl" />
    <Report Include="大戶買賣超.rdl" />
    <Report Include="盤中警示.rdl" />
    <Report Include="盤中週轉率.rdl" />
    <Report Include="資金流向強弱指標.rdl" />
  </ItemGroup>
  <Import Project="$(MSBuildExtensionsPath)\Reporting Services\Microsoft.ReportingServices.MSBuilder.targets" />
</Project>