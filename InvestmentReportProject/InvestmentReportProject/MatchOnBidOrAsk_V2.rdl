                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Textbox76">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!MaxPriceBeforeCurrentTime.Value</Value>
                                  <Style>
                                    <FontFamily />
                                    <FontWeight>Bold</FontWeight>
                                    <Color>=IIf((Fields!ID1MinQty.Value/Fields!ID5MinAvgQty.Value)&gt;1.5,"Red","Black")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Center</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>Textbox45</rd:DefaultName>
                          <Style>
                            <Border>
                              <Color>LightGrey</Color>
                            </Border>
                            <BottomBorder>
                              <Style>Solid</Style>
                            </BottomBorder>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Textbox13">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Switch(
Fields!AccQtyOnAsk.Value=Variables!MaxAccQtyOnAsk.Value," * 今日最大_連_Buy_量 * ",
Fields!AccQtyOnBid.Value=Variables!MaxAccQtyOnBid.Value," * 今日最大_連_Sell_量 * ",
Fields!BreakThrough_OpenPrice.Value=1," 站上開盤價 "+Format(Fields!OpenPrice.Value,"#,#.0"),
Fields!BreakThrough_OpenPrice.Value=2," 跌破開盤價 "+Format(Fields!OpenPrice.Value,"#,#.0"),
Fields!ClosePrice.Value&gt;Fields!OpenPrice.Value,"正",
Fields!ClosePrice.Value&lt;Fields!OpenPrice.Value,"負",
0=0,"")</Value>
                                  <Style>
                                    <FontFamily />
                                    <FontSize>11pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Color>=IIf((Fields!Min_MatchPrice.Value+Fields!Max_MatchPrice.Value)/2&gt;Fields!OpenPrice.Value,"Red","Green")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Left</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>Textbox13</rd:DefaultName>
                          <Style>
                            <Border>
                              <Color>LightGrey</Color>
                            </Border>
                            <BottomBorder>
                              <Style>Solid</Style>
                            </BottomBorder>
                            <BackgroundColor>=Switch(
Fields!AccQtyOnAsk.Value=Variables!MaxAccQtyOnAsk.Value,"Yellow",
Fields!AccQtyOnBid.Value=Variables!MaxAccQtyOnBid.Value,"Aqua",
Fields!BreakThrough_OpenPrice.Value=1,"Pink",
Fields!BreakThrough_OpenPrice.Value=2,"LightBlue",
0=0,"White")</BackgroundColor>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Textbox20">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Switch(
Fields!BreakThrough_AvgPrice.Value=1," 站上均價線 "+Format(Fields!AvgPrice.Value,"#,#.0"),
Fields!BreakThrough_AvgPrice.Value=2," 跌破均價線 "+Format(Fields!AvgPrice.Value,"#,#.0"),
Fields!ClosePrice.Value&gt;Fields!AvgPrice.Value,"正",
Fields!ClosePrice.Value&lt;Fields!AvgPrice.Value,"負",
0=0,"")</Value>
                                  <Style>
                                    <FontFamily />
                                    <FontSize>11pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Color>=IIf((Fields!Min_MatchPrice.Value+Fields!Max_MatchPrice.Value)/2&gt;Fields!AvgPrice.Value,"Red","Green")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Left</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>Textbox20</rd:DefaultName>
                          <Style>
                            <Border>
                              <Color>LightGrey</Color>
                            </Border>
                            <BottomBorder>
                              <Style>Solid</Style>
                            </BottomBorder>
                            <BackgroundColor>=Switch(
Fields!AccQtyOnAsk.Value=Variables!MaxAccQtyOnAsk.Value,"Yellow",
Fields!AccQtyOnBid.Value=Variables!MaxAccQtyOnBid.Value,"Aqua",
Fields!BreakThrough_AvgPrice.Value=1,"Pink",
Fields!BreakThrough_AvgPrice.Value=2,"LightGreen",
0=0,"White")</BackgroundColor>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Textbox29">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>="   " + 
Switch(
((((Fields!Min_MatchPrice.Value + Fields!Max_MatchPrice.Value)/2) / Variables("PreClose").Value) - 1) &gt; 0, "上漲 " + Format((( ((Fields!Min_MatchPrice.Value + Fields!Max_MatchPrice.Value)/2) / Variables("PreClose").Value) - 1) * 100, "#,#.00") + " %   ", 
((((Fields!Min_MatchPrice.Value + Fields!Max_MatchPrice.Value)/2) / Variables("PreClose").Value) - 1) &lt; 0, "下跌 " + Format((( ((Fields!Min_MatchPrice.Value + Fields!Max_MatchPrice.Value)/2) / Variables("PreClose").Value) - 1) * 100, "#,#.00") + " %   ",
0 = 0, "")</Value>
                                  <Style>
                                    <FontFamily />
                                    <FontSize>11pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Color>=IIf((((First(Fields!Min_MatchPrice.Value)+First(Fields!Max_MatchPrice.Value))/2 / Variables("PreClose").Value) - 1)&gt;0,"Red","Green")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>Textbox24</rd:DefaultName>
                          <Style>
                            <Border>
                              <Color>LightGrey</Color>
                            </Border>
                            <BottomBorder>
                              <Style>Solid</Style>
                            </BottomBorder>
                            <BackgroundColor>=Switch(
Fields!AccQtyOnAsk.Value=Variables!MaxAccQtyOnAsk.Value,"Yellow",
Fields!AccQtyOnBid.Value=Variables!MaxAccQtyOnBid.Value,"Aqua",
((((Fields!Min_MatchPrice.Value + Fields!Max_MatchPrice.Value)/2) / Variables("PreClose").Value) - 1) * 100 &gt; 6,"Yellow",
((((Fields!Min_MatchPrice.Value + Fields!Max_MatchPrice.Value)/2) / Variables("PreClose").Value) - 1) * 100 &gt; 3,"Pink",
((((Fields!Min_MatchPrice.Value + Fields!Max_MatchPrice.Value)/2) / Variables("PreClose").Value) - 1) * 100 &lt; -3,"LightGreen",
((((Fields!Min_MatchPrice.Value + Fields!Max_MatchPrice.Value)/2) / Variables("PreClose").Value) - 1) * 100 &lt; -6,"LightBlue",
0=0,"White")</BackgroundColor>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
