<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="InMemoryOLTP_KGI_DB">
      <DataSourceReference>InMemoryOLTP_KGI_DB</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>1d9d561e-e846-442d-a85c-d1ddeff02e7c</rd:DataSourceID>
    </DataSource>
    <DataSource Name="Investment_DB">
      <DataSourceReference>DataSource_localhost</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>6db98026-bae4-432c-b7d0-b0f4ba0d6282</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>InMemoryOLTP_KGI_DB</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@stockNo">
            <Value>=Parameters!stockNo.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@start_time">
            <Value>=Parameters!start_time.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
          <QueryParameter Name="@end_time">
            <Value>=Parameters!end_time.Value</Value>
            <rd:UserDefined>true</rd:UserDefined>
          </QueryParameter>
        </QueryParameters>
        <CommandText>WITH BaseData AS (
    SELECT 
        StockNumber,
        TimeString,
        TotalQty,
        MatchBidOrAsk,
		MatchPrice,
		FIRST_VALUE(MatchPrice) OVER (PARTITION BY StockNumber ORDER BY TimeString, TotalQty) AS OpenPrice,
        -- Running Average of MatchPrice from start to current row
        SUM(MatchPrice) OVER (PARTITION BY StockNumber ORDER BY TimeString, TotalQty ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) 
        / COUNT(MatchPrice) OVER (PARTITION BY StockNumber ORDER BY TimeString, TotalQty ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) 
        AS AvgPrice,

        CASE WHEN MatchBidOrAsk = 1 THEN TotalQty - LAG(TotalQty, 1, TotalQty) OVER (PARTITION BY StockNumber ORDER BY TimeString, TotalQty) ELSE 0 END AS QtyOnBid,
        CASE WHEN MatchBidOrAsk = 2 THEN TotalQty - LAG(TotalQty, 1, TotalQty) OVER (PARTITION BY StockNumber ORDER BY TimeString, TotalQty) ELSE 0 END AS QtyOnAsk
    FROM quotecom_31001_MatchBidOrAsk
    WHERE StockNumber = @stockNo
),

GroupedData AS (
    SELECT 
        StockNumber,
        (TimeString / 1000 / 5) * 5 AS GroupedTime,  -- Group every 5 seconds
        MAX(TimeString / 10000000) AS HourPart,  -- Extract hours
        MAX((TimeString / 100000) % 100) AS MinutePart,  -- Extract minutes
		MAX(TotalQty) AS TotalQty,
		MIN(MatchPrice) AS Min_MatchPrice,
		MAX(MatchPrice) AS Max_MatchPrice,
		MAX(OpenPrice) AS OpenPrice,
        MAX(AvgPrice) AS AvgPrice, -- Running average up to this group
        SUM(QtyOnBid) AS SumQtyOnBid,
        SUM(QtyOnAsk) AS SumQtyOnAsk,
        COUNT(CASE WHEN QtyOnBid &gt; 0 THEN 1 ELSE NULL END) AS CountEntries_OnBid,
        COUNT(CASE WHEN QtyOnAsk &gt; 0 THEN 1 ELSE NULL END) AS CountEntries_OnAsk
    FROM BaseData
    GROUP BY StockNumber, (TimeString / 1000 / 5) * 5
),

WinStreaks AS (
    SELECT *,
        CASE 
            WHEN SumQtyOnBid &gt; SumQtyOnAsk THEN 1
            WHEN SumQtyOnBid &lt; SumQtyOnAsk THEN 2
            ELSE 0 
        END AS CurrentWinner,
        
        LAG(CASE 
            WHEN SumQtyOnBid &gt; SumQtyOnAsk THEN 1
            WHEN SumQtyOnBid &lt; SumQtyOnAsk THEN 2
            ELSE 0 
        END, 1, 0) OVER (PARTITION BY StockNumber ORDER BY GroupedTime) AS PreviousWinner
    FROM GroupedData
),

Streaks AS (
    SELECT *,
        SUM(CASE WHEN CurrentWinner &lt;&gt; PreviousWinner THEN 1 ELSE 0 END) 
        OVER (PARTITION BY StockNumber ORDER BY GroupedTime) AS StreakID
    FROM WinStreaks
),

WinCounts AS (
    SELECT 
        s.*,
        CASE 
            WHEN s.CurrentWinner = 1 THEN ROW_NUMBER() OVER (PARTITION BY s.StockNumber, s.StreakID ORDER BY s.GroupedTime)
            ELSE 0
        END AS OnBid_Count,

        CASE 
            WHEN s.CurrentWinner = 2 THEN ROW_NUMBER() OVER (PARTITION BY s.StockNumber, s.StreakID ORDER BY s.GroupedTime)
            ELSE 0
        END AS OnAsk_Count
    FROM Streaks s
),

AccumulatedData AS (
    SELECT 
        w.StockNumber,
        w.GroupedTime,
        w.HourPart,
        w.MinutePart,
		w.TotalQty,
		w.Min_MatchPrice,
		w.Max_MatchPrice,
		w.OpenPrice,
		w.AvgPrice,
        w.SumQtyOnBid,
        w.SumQtyOnAsk,
        w.CountEntries_OnBid,
        w.CountEntries_OnAsk,
        w.OnBid_Count,

        CASE 
            WHEN w.OnBid_Count &gt; 0 THEN 
                SUM(w.SumQtyOnBid) OVER (PARTITION BY w.StockNumber, w.StreakID ORDER BY w.GroupedTime ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
            ELSE 0
        END AS AccQtyOnBid,

        w.OnAsk_Count,

        CASE 
            WHEN w.OnAsk_Count &gt; 0 THEN 
                SUM(w.SumQtyOnAsk) OVER (PARTITION BY w.StockNumber, w.StreakID ORDER BY w.GroupedTime ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
            ELSE 0
        END AS AccQtyOnAsk,

        LEAD(w.OnBid_Count, 1, 0) OVER (PARTITION BY w.StockNumber ORDER BY w.GroupedTime) AS NextBidCount,
        LEAD(w.OnAsk_Count, 1, 0) OVER (PARTITION BY w.StockNumber ORDER BY w.GroupedTime) AS NextAskCount,

	    -- New Added: 1MinQty, 5MinAvgQty, 20MinAvgQty
        TotalQty - LAG(TotalQty, 12) OVER (PARTITION BY w.StockNumber ORDER BY w.GroupedTime) AS [1MinQty],
	    (TotalQty - LAG(TotalQty, 60) OVER (PARTITION BY w.StockNumber ORDER BY w.GroupedTime)) / 5.0 AS [5MinAvgQty],
        (TotalQty - LAG(TotalQty, 240) OVER (PARTITION BY w.StockNumber ORDER BY w.GroupedTime)) / 20.0 AS [20MinAvgQty],

		 -- New columns
		MIN(w.Min_MatchPrice) OVER (
			PARTITION BY w.StockNumber 
			ORDER BY w.GroupedTime 
			ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
		) AS MinPriceBeforeCurrentTime,

		MAX(w.Max_MatchPrice) OVER (
			PARTITION BY w.StockNumber 
			ORDER BY w.GroupedTime 
			ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW
		) AS MaxPriceBeforeCurrentTime

    FROM WinCounts w
)

SELECT 
    ROW_NUMBER() over (order by GroupedTime desc) as Row_No,
    A.StockNumber,
    GroupedTime,
    HourPart,
    MinutePart,
	TotalQty,
	B.ClosePrice,
	B.MinuteVol,
	B.PctChg,
	B.BBandUpper,
	B.BBandLower,
	
	A.[1MinQty],
	A.[5MinAvgQty],
    A.[20MinAvgQty],

	Min_MatchPrice,
	Max_MatchPrice,
	OpenPrice,
	AvgPrice,
    SumQtyOnBid,
    SumQtyOnAsk,
    CountEntries_OnBid,
    CountEntries_OnAsk,
    OnBid_Count,
    AccQtyOnBid,
    OnAsk_Count,
    AccQtyOnAsk,

	-- new columns
	A.MinPriceBeforeCurrentTime,
	A.MaxPriceBeforeCurrentTime,
	
	-- Breakthrough or Break OpenPrice Signal (only when crossing from below to above or from above to below)
    CASE 
        WHEN Max_MatchPrice &gt; OpenPrice 
             AND LAG(Max_MatchPrice, 1, OpenPrice) OVER (PARTITION BY A.StockNumber ORDER BY GroupedTime) &lt;= OpenPrice 
        THEN 1
		WHEN Max_MatchPrice &lt; OpenPrice 
             AND LAG(Max_MatchPrice, 1, OpenPrice) OVER (PARTITION BY A.StockNumber ORDER BY GroupedTime) &gt;= OpenPrice 
        THEN 2
        ELSE 0 
    END AS BreakThrough_OpenPrice,

    -- Breakthrough or Break AvgPrice Signal (only when crossing from below to above or from above to below)
    CASE 
        WHEN Max_MatchPrice &gt; AvgPrice 
             AND LAG(Max_MatchPrice, 1, AvgPrice) OVER (PARTITION BY A.StockNumber ORDER BY GroupedTime) &lt;= AvgPrice 
        THEN 1
		WHEN Max_MatchPrice &lt; AvgPrice 
             AND LAG(Max_MatchPrice, 1, AvgPrice) OVER (PARTITION BY A.StockNumber ORDER BY GroupedTime) &gt;= AvgPrice 
        THEN 2
        ELSE 0 
    END AS BreakThrough_AvgPrice
FROM AccumulatedData A
FULL OUTER JOIN DayTradeData B 
ON A.StockNumber = B.StockNumber
AND A.HourPart = DATEPART(HOUR, B.PriceDateTime)
AND A.MinutePart = DATEPART(MINUTE, B.PriceDateTime)
WHERE 
    GroupedTime &gt;= @start_time AND GroupedTime &lt; @end_time 
    AND ((OnBid_Count &gt; 0 AND NextBidCount = 0) OR 
    (OnAsk_Count &gt; 0 AND NextAskCount = 0))
ORDER BY A.StockNumber, GroupedTime desc;</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Row_No">
          <DataField>Row_No</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="StockNumber">
