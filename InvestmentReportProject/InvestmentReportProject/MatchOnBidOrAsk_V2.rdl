    <DataSet Name="DataSet3_TimeIntervales">
      <Query>
        <DataSourceName>InMemoryOLTP_KGI_DB</DataSourceName>
        <CommandText>WITH TimeIntervals AS (
    SELECT CAST('09:00' AS TIME) AS TimeInterval
    UNION ALL
    SELECT DATEADD(MINUTE, 3, TimeInterval) 
    FROM TimeIntervals
    WHERE TimeInterval &lt; '13:30'
)
SELECT 
    CONVERT(VARCHAR(5), TimeInterval, 108) AS TimeIntervalFormatted,
    CAST(
        RIGHT('0' + CAST(DATEPART(HOUR, TimeInterval) AS VARCHAR), 2) +
        RIGHT('0' + CAST(DATEPART(MINUTE, TimeInterval) AS VARCHAR), 2) +
        '00' AS INT
    ) AS TimeInt
FROM TimeIntervals
OPTION (MAXRECURSION 1000);</CommandText>
      </Query>
      <Fields>
        <Field Name="TimeIntervalFormatted">
          <DataField>TimeIntervalFormatted</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="TimeInt">
          <DataField>TimeInt</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
