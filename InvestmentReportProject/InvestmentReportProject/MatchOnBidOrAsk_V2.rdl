    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>Investment_DB</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@stockNo">
            <Value>=Parameters!stockNo.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select top 1 A.*, temp_sdd.* from company as A 
inner join temp_company_sdd as temp_sdd on A.CompanyID=temp_sdd.CID and temp_sdd.PriceDate&gt;=(select top 1 PriceDate from temp_company_sdd where CID=282 order by PriceDate desc)
where status=1 and countrycode='TW' and symbol like '%'+@stockNo+'%' 
order by temp_sdd.PriceDate desc</CommandText>
      </Query>
