Fields!Close_Chg60.Value&gt;100,"Yellow",
Fields!Close_Chg60.Value&gt;30,"Pink",
Fields!Close_Chg60.Value&lt;=-30,"LightGreen",
Fields!Close_Chg60.Value&lt;-50,"LightBlue",
0=0,"White")</BackgroundColor>
