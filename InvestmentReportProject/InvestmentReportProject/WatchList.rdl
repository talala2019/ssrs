                          <Style>
                            <Border>
                              <Color>LightGrey</Color>
                              <Style>Solid</Style>
                            </Border>
                            <BackgroundColor>=Switch(
Fields!Close_Chg20.Value&gt;80,"Yellow",
Fields!Close_Chg20.Value&gt;30,"Pink",
Fields!Close_Chg20.Value&lt;=-50,"LightBlue",
Fields!Close_Chg20.Value&lt;=-30,"LightGreen",
0=0,"White")</BackgroundColor>
                            <VerticalAlign>Middle</VerticalAlign>
