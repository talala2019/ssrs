<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource_localhost">
      <DataSourceReference>DataSource_localhost</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>bba00835-7eea-4eb5-b47c-7dee51f4f348</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="HoldingsDataSet">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@pid1">
            <Value>=Parameters!pid1.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@pricedate">
            <Value>=Parameters!pricedate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@symbol">
            <Value>=Parameters!symbol.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@ma20_slope">
            <Value>=Parameters!ma20_slope.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@row_no">
            <Value>=Parameters!row_no.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>;WITH RankedData AS (
select 
ROW_NUMBER() OVER (PARTITION BY SDD.CID ORDER BY SDD.PriceDate, Spi.Day0_W55) AS row_no,
SDD.CID, Com.ChtName, Com.Symbol, Com.CountryCode, Com.Industry, Com.Capital,
SDD.PriceDate, SDD.DayOpen, SDD.DayHigh, SDD.DayLow, SDD.DayClose, CONVERT(DECIMAL(10,2),Spi.Close_Chg1) as 'CloseChg',
SDD.Volume,
SDD.Vol_MA3,
SDD.Vol_MA10,
SDD.Vol_MA20,
SDD.MA5,
SDD.MA11, 
ISNULL(CONVERT(DECIMAL(10,2), (SDD.DayClose / NULLIF(SDD.MA11, 0))), 0) as 'ma11_div', 
SDD.MA20, 
ISNULL(CONVERT(DECIMAL(10,2), (SDD.DayClose / NULLIF(SDD.MA20, 0))), 0) as 'ma20_div',
SDD.MA42,
SDD.MA60,
SDD.MA240,
SDD.MA20_Slope,
FE.Memo,
FE.DS_HR,
FE.DS_PR,
FE.FI_HR,
FE.EstDividend,
INS.ForeignInvest,INS.InvestTrust, 
-- 2. Institutional Ratios (Using NULLIF on Capital)
CONVERT(DECIMAL(10,2),((INS.ForeignInvest + INS.InvestTrust) / NULLIF(Com.Capital, 0)) * 100) as 'FIRatio1',
CONVERT(DECIMAL(10,2),((INS.ForeignInvest_MA3 + INS.InvestTrust_MA3) / NULLIF(Com.Capital, 0)) * 100) as 'FIRatio3',
CONVERT(DECIMAL(10,2),((INS.ForeignInvest_MA6 + INS.InvestTrust_MA6) / NULLIF(Com.Capital, 0)) * 100) as 'FIRatio6',
CONVERT(DECIMAL(10,2),((INS.ForeignInvest_MA12 + INS.InvestTrust_MA12) / NULLIF(Com.Capital, 0)) * 100) as 'FIRatio12',
CONVERT(DECIMAL(10,2),((INS.ForeignInvest_MA20 + INS.InvestTrust_MA20) / NULLIF(Com.Capital, 0)) * 100) as 'FIRatio20',
CONVERT(DECIMAL(10,2),((INS.ForeignInvest_MA40 + INS.InvestTrust_MA40) / NULLIF(Com.Capital, 0)) * 100) as 'FIRatio40',
CONVERT(DECIMAL(10,2),((INS.ForeignInvest_MA60 + INS.InvestTrust_MA60) / NULLIF(Com.Capital, 0)) * 100) as 'FIRatio60',
CONVERT(DECIMAL(10,2),((INS.ForeignInvest_MA120 + INS.InvestTrust_MA120) / NULLIF(Com.Capital, 0)) * 100) as 'FIRatio120',
SWD.WeekTrend, SWD.WeekMACDStatus, SWD.WeekDMI, SWD.WeekADX14,

Spi.Days_CloseOnMa5,
Spi.Days_CloseOnMa20,
Spi.Day0_Bar,
Spi.Day0_Bar_Status as 'BarStatus', 
CONVERT(DECIMAL(10,1),Spi.Day0_W55) as 'W55', 
CONVERT(DECIMAL(10,1),Spi.Day0_W9) as 'W9',   
Spi.VolAvg3_Status as 'VolAvg3_Status', 
CONVERT(DECIMAL(10,2), (SDD.Vol_MA3 / NULLIF(SDD.Vol_MA15, 0))) as 'Vol 3/15',
Spi.Days_VolMa3OnMa15,
Spi.MA5_Status, Spi.Days_Ma5OnMa20 ,Spi.MA20_Status, Spi.MA42_Status, Spi.MA60_Status,
Spi.Close_Chg3,
Spi.Close_Chg6,
Spi.Close_Chg10,
Spi.Close_Chg12,
Spi.Close_Chg20,
Spi.Close_Chg40,
Spi.Close_Chg60,
Spi.Close_Chg120,
Spi.Day0_Dif, Spi.Day0_Macd,
Spi.Day1_Dif, Spi.Day1_Macd,
Spi.Day0_K, Spi.Day0_D,
Spi.Day1_K, Spi.Day1_D,
Spi.KLine_Status,
Spi.Day1_Vol,
Spi.UpperBBand,
Spi.UpperSlope,
Spi.LowerBBand,
Spi.LowerSlope,
Spi.MinVol_In10Days,

msales.year, msales.month, msales.salesYoY, msales.msalesresult,
msales.msales, msales.lymsales,
msales.msales_pre1, msales.lymsales_pre1,
msales.msales_pre2, msales.lymsales_pre2,
msales.lytotalsales_wholeyear,

pe.name, pe.yield, pe.pe_ratio, pe.pb_ratio, pe.quarter,

TT.MaxAccInvestTrustBuy ,
TT.MaxAccInvestTrustBuyDay,
ISNULL((INS.InvestTrust / NULLIF(SDD.Volume - (DT.Volume / 1000.0), 0)), 0) as 'IT_Vol_Ratio1',

case
when TT.SignalType is null then 'n/a'
else TT.SignalType
end as 'SignalType',

case
when TT.TrendTrackingSignal is null then 'n/a'
else TT.TrendTrackingSignal
end as 'TTSignal',

case
when CST.Signal is null then 'n/a'
else CST.Signal
end as 'CompanySignal',

detailed_indus_names.IndustryNames as 'Detailed_Industry_Names',

SMD_0.Volume as 'Vol_M0',
SMD_1.Volume as 'Vol_M1',
SMD_2.Volume as 'Vol_M2',
SMD_3.Volume as 'Vol_M3',
PS.PID,
DT.Volume as 'DayTrade_Vol',
mt.PreMarginRmng,
mt.MarginRmng

from Company as Com
inner join PortfolioStock as PS on Com.CompanyID=PS.CompanyID
inner join temp_company_sdd as SDD on Com.CompanyID=SDD.CID
inner join temp_company_spi as Spi on SDD.CID=Spi.CompanyID and SDD.PriceDate=Spi.PriceDate
LEFT JOIN temp_company_swd AS SWD ON SDD.CID = SWD.CompanyID AND SDD.PriceDate = SWD.EndDate
--LEFT JOIN CompanyInfo as Cinfo on Com.CompanyID=Cinfo.CompanyID
LEFT JOIN temp_company_instilinvest as INS on SDD.CID=INS.CID AND SDD.PriceDate=INS.DataDate
LEFT JOIN Trend_Tracking as TT on SDD.CID=TT.CID and SDD.PriceDate=TT.PriceDate
LEFT JOIN CompanySignalTracking as CST on SDD.CID=CST.CompanyID and SDD.PriceDate=CST.PriceDate
LEFT JOIN FinancialEst as FE on SDD.CID=FE.CompanyID and SDD.PriceDate=CONVERT(varchar(10),FE.Year)+'-'+CONVERT(varchar(10),FE.Month)+'-'+CONVERT(varchar(10),FE.Day)
LEFT JOIN temp_company_msalesYoY as msales on com.CompanyID=msales.cid
LEFT JOIN temp_company_pe as pe on SUBSTRING(com.Symbol,0,5)=ltrim(rtrim(pe.symbol))
LEFT JOIN DayTrading as DT on com.CompanyID=DT.CID and SDD.PriceDate=DT.DataDate

left join MarginTrading as mt on Com.CompanyID=mt.CID and mt.DataDate=SDD.PriceDate

Left join CompanyDetailedIndustry as detailed_indus_names on com.CompanyID=detailed_indus_names.CompanyID

Left join StockMonthlyData SMD_0 on Spi.CompanyID=SMD_0.CompanyID and YEAR(Spi.PriceDate)=SMD_0.Year and MONTH(Spi.PriceDate)= SMD_0.Month
Left join StockMonthlyData SMD_1 on Spi.CompanyID=SMD_1.CompanyID and  YEAR(DATEADD(month, -1, Spi.PriceDate))=SMD_1.Year and MONTH(DATEADD(month, -1, Spi.PriceDate))= SMD_1.Month
Left join StockMonthlyData SMD_2 on Spi.CompanyID=SMD_2.CompanyID and  YEAR(DATEADD(month, -2, Spi.PriceDate))=SMD_2.Year and MONTH(DATEADD(month, -2, Spi.PriceDate))= SMD_2.Month
Left join StockMonthlyData SMD_3 on Spi.CompanyID=SMD_3.CompanyID and  YEAR(DATEADD(month, -3, Spi.PriceDate))=SMD_3.Year and MONTH(DATEADD(month, -3, Spi.PriceDate))= SMD_3.Month
Left join StockMonthlyData SMD_4 on Spi.CompanyID=SMD_4.CompanyID and  YEAR(DATEADD(month, -4, Spi.PriceDate))=SMD_4.Year and MONTH(DATEADD(month, -4, Spi.PriceDate))= SMD_4.Month
Left join StockMonthlyData SMD_5 on Spi.CompanyID=SMD_5.CompanyID and  YEAR(DATEADD(month, -5, Spi.PriceDate))=SMD_5.Year and MONTH(DATEADD(month, -5, Spi.PriceDate))= SMD_5.Month
Left join StockMonthlyData SMD_6 on Spi.CompanyID=SMD_6.CompanyID and  YEAR(DATEADD(month, -6, Spi.PriceDate))=SMD_6.Year and MONTH(DATEADD(month, -6, Spi.PriceDate))= SMD_6.Month
Left join StockMonthlyData SMD_7 on Spi.CompanyID=SMD_7.CompanyID and  YEAR(DATEADD(month, -7, Spi.PriceDate))=SMD_7.Year and MONTH(DATEADD(month, -7, Spi.PriceDate))= SMD_7.Month

where 
PS.PID in (@pid1)
and SDD.PriceDate=@pricedate 
and (Com.Symbol like '%'+ltrim(rtrim(@symbol))+'%' or Com.Chtname like N'%'+ltrim(rtrim(@symbol))+'%') 
and SDD.MA20_Slope&gt;@ma20_slope
)

SELECT *
FROM RankedData
WHERE row_no&lt;=@row_no
ORDER BY PriceDate;</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
