                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!Close_Chg20.Value</Value>
                                  <Style>
                                    <FontWeight>Bold</FontWeight>
                                    <Format>0.0</Format>
                                    <Color>=Switch(Fields!Close_Chg20.Value&gt;0,"Red",
Fields!Close_Chg20.Value&lt;=0,"Green",
0=0,"Black")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Center</TextAlign>
                              </Style>
                            </Paragraph>
