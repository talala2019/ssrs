                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Symbol5">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=LTrim(RTrim(Fields!Symbol.Value))</Value>
                                  <Style>
                                    <FontWeight>Bold</FontWeight>
                                    <Color>DarkBlue</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Center</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>Symbol</rd:DefaultName>
                          <ActionInfo>
                            <Actions>
                              <Action>
                                <Hyperlink>=IIf(Fields!CountryCode.Value="TW","javascript:void(window.open('/InvestmentReports/report/InvestmentReportProject/StockDetails_V3?symbol=" + Fields!Symbol.Value + "&amp;rc:Zoom=82','_blank'))",
"javascript:void(window.open('/InvestmentReports/report/InvestmentReportProject/StockDetails_V1?symbol=" + Fields!Symbol.Value + "&amp;rc:Zoom=82','_blank'))")</Hyperlink>
                              </Action>
                            </Actions>
                          </ActionInfo>
                          <Style>
                            <Border>
                              <Color>LightGrey</Color>
                              <Style>Solid</Style>
                            </Border>
                            <BackgroundColor>=Switch(Fields!CompanySignal.Value="[黃]","Yellow",
Fields!CompanySignal.Value="[紅]","Red",
Fields!CompanySignal.Value="[綠]","Green",
""="","White"
)</BackgroundColor>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="ChtName">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!ChtName.Value</Value>
                                  <Style>
                                    <FontSize>12pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Color>DarkBlue</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Center</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>ChtName</rd:DefaultName>
                          <ActionInfo>
                            <Actions>
                              <Action>
                                <Hyperlink>=IIf(Fields!CountryCode.Value = "TW", "javascript:void(window.open('http://localhost/InvestmentReports/report/InvestmentReportProject/Stock_21Days?symbol=" + Fields!Symbol.Value + "&amp;rc:Zoom=100','_blank'))", "javascript:void(window.open('http://localhost/InvestmentReports/report/InvestmentReportProject/Stock_21Days?symbol=" + Fields!Symbol.Value + "&amp;rc:Zoom=100','_blank'))")</Hyperlink>
                              </Action>
                            </Actions>
                          </ActionInfo>
                          <Style>
                            <Border>
                              <Color>LightGrey</Color>
                              <Style>Solid</Style>
                            </Border>
                            <BackgroundColor>=IIf( Fields!row_no.Value Mod 2 = 0,"LightGoldenrodYellow","White")</BackgroundColor>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="PriceDate2">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Month(Fields!PriceDate.Value) &amp; "/" &amp; Day(Fields!PriceDate.Value)</Value>
                                  <Style>
                                    <FontWeight>Bold</FontWeight>
                                    <Color>DarkBlue</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Center</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>PriceDate</rd:DefaultName>
                          <Style>
                            <Border>
                              <Color>LightGrey</Color>
                              <Style>Solid</Style>
                            </Border>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="DayClose">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Format(Fields!DayClose.Value,"#,#.0")+" "</Value>
                                  <Style>
                                    <FontWeight>Bold</FontWeight>
                                    <Format>0.0</Format>
                                    <Color>=Switch(Fields!DayClose.Value=Fields!DayOpen.Value,"DarkBlue",
Fields!DayClose.Value&gt;Fields!DayOpen.Value,"Red",
Fields!DayClose.Value&lt;Fields!DayOpen.Value,"Green")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>DayClose</rd:DefaultName>
                          <Style>
                            <Border>
                              <Color>LightGrey</Color>
                              <Style>Solid</Style>
                            </Border>
                            <BackgroundColor>=Switch(Fields!DayClose.Value&gt;=Fields!UpperBBand.Value,"Yellow",
Fields!DayClose.Value&lt;=Fields!LowerBBand.Value,"LightGreen",
0=0,"White")</BackgroundColor>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Textbox50">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Switch(Fields!DayClose.Value&gt;=Fields!UpperBBand.Value,"開布林",
Fields!DayClose.Value&lt;=Fields!LowerBBand.Value,"開布林",
0=0,Fields!KLine_Status.Value)</Value>
                                  <Style>
                                    <FontSize>=Switch(Fields!DayClose.Value&gt;=Fields!UpperBBand.Value,"11pt",
Fields!DayClose.Value&lt;=Fields!LowerBBand.Value,"11pt",
0=0,"10pt")</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Format>0.0</Format>
                                    <Color>=Switch(Fields!DayClose.Value&gt;=Fields!UpperBBand.Value,"Red",
Fields!DayClose.Value&lt;=Fields!LowerBBand.Value,"Green",
0=0,"Blue")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Center</TextAlign>
                                <LineHeight>=IIf(Fields!DayClose.Value&gt;=Fields!UpperBBand.Value,"11pt","10pt")</LineHeight>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>Textbox50</rd:DefaultName>
                          <Style>
                            <Border>
                              <Color>LightGrey</Color>
                              <Style>Solid</Style>
                            </Border>
                            <BackgroundColor>=Switch(Fields!DayClose.Value&gt;=Fields!UpperBBand.Value,"Yellow",
Fields!DayClose.Value&lt;=Fields!LowerBBand.Value,"LightGreen",
0=0,"White")</BackgroundColor>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Volume1">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Format((Fields!Volume.Value/Fields!Capital.Value)*100,"#,#.0")+"   "</Value>
                                  <Style>
                                    <FontWeight>Bold</FontWeight>
                                    <Color>=IIf((Fields!Volume.Value/Fields!Capital.Value)*100&gt;10,"Red","Black")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>Volume1</rd:DefaultName>
                          <Style>
                            <Border>
                              <Color>LightGrey</Color>
                              <Style>Solid</Style>
                            </Border>
                            <BackgroundColor>=Switch(
(Fields!Volume.Value/Fields!Capital.Value)*100&gt;50,"Yellow",
(Fields!Volume.Value/Fields!Capital.Value)*100&gt;30,"Pink",
(Fields!Volume.Value/Fields!Capital.Value)*100&gt;10,"LightGoldenrodYellow",
0=0,"White")</BackgroundColor>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
