                      <CellContents>
                        <Textbox Name="Textbox112">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Format(((Fields!DayHigh.Value - Fields!DayLow.Value) / Fields!DayLow.Value) * 100, "#,#.0") + "  "</Value>
                                  <Style>
                                    <FontWeight>Bold</FontWeight>
                                    <Color>=IIF((((Fields!DayHigh.Value-Fields!DayLow.Value)/Fields!DayLow.Value)*100)&gt;=5,"Red","DarkBlue")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
