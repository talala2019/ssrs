    <DataSet Name="PriceDateList">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <CommandText>SELECT DISTINCT PriceDate
FROM   temp_company_sdd
WHERE (PriceDate &gt; GETDATE() - 30) 
and CID in (282,291)
ORDER BY PriceDate Desc</CommandText>
      </Query>
      <Fields>
        <Field Name="PriceDate">
          <DataField>PriceDate</DataField>
          <rd:UserDefined>true</rd:UserDefined>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="PortfolioList1">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <CommandText>select PID, REPLACE(REPLACE(Name, '_000', ''), '_002', ''), REPLACE(REPLACE(Name, '_000', ''), '_002', '')+' '+CAST(PID as varchar(10)) as'NameID' from PortfolioMain
where Name like '%1T_000%' or Name like '%1T_002%' or userid='myreport'
order by name, priority, pid</CommandText>
      </Query>
      <Fields>
        <Field Name="PID">
          <DataField>PID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ID">
          <DataField />
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NameID">
          <DataField>NameID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
