<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource_localhost">
      <DataSourceReference>DataSource_localhost</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>cdd8b137-c843-42c2-bb45-8620437d415d</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@industry">
            <Value>=Parameters!industry.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@pricedate">
            <Value>=Parameters!pricedate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@volume">
            <Value>=Parameters!volume.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@msales">
            <Value>=Parameters!msales.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@WeekMa24">
            <Value>=Parameters!WeekMa24.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@WeekMa48">
            <Value>=Parameters!WeekMa48.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FIRatio1">
            <Value>=Parameters!FIRatio1.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FIRatio12">
            <Value>=Parameters!FIRatio12.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@FIRatio60">
            <Value>=Parameters!FIRatio60.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@signal_type">
            <Value>=Parameters!signal_type.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@ty_vol_ratio">
            <Value>=Parameters!ty_vol_ratio.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@cst_signal">
            <Value>=Parameters!cst_signal.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT 
ROW_NUMBER() over (order by SPI.Days_Ma5OnMa20, Com.Symbol ) as Row_No,
Com.CompanyID, Com.Symbol, Com.ChtName, Com.CountryCode, Com.Industry, Com.Capital,
TT.TrendTrackingSignal,
CST.Signal,
TT.SignalType,
SWD.WeekTrend, SWD.WeekMACDStatus, SWD.WeekDMI, SWD.WeekADX14, SWD.WeekMA20, SWD.WeekMA35, SWD.WeekMA60,
CONVERT(DECIMAL(10, 2), SDD.Vol_MA3 / SDD.Vol_MA15) AS 'Vol_3_15',
SDD.PriceDate,
SDD.Volume,
SDD.Vol_MA20,
SDD.DayOpen,
SDD.DayClose,
SDD.MA5,SDD.MA20,SDD.MA42, 
SDD.Vol_MA3,SDD.Vol_MA15,
SPI.Close_Chg1,
SPI.Close_Chg3,
SPI.Close_Chg12,
SPI.Close_Chg60,
SPI.Day0_Bar,
SPI.Day0_Bar_Status,
SPI.Day1_Vol, -- 昨量
SPI.MA5_Status,
SPI.Days_CloseOnMa20,
SPI.Days_Ma5OnMa20,
SPI.MA20_Status,
SPI.MA42_Status,
SPI.MA60_Status,
SPI.Day0_Dif, 
SPI.Day0_Macd,
SPI.Day0_K, SPI.Day0_D,
SPI.Day0_W9,
SPI.Day0_W55,
SPI.VolAvg3_Status,
SPI.Days_VolMa3OnMa15,
SPI.KLine_Status,
PE.pe_ratio, PE.pb_ratio, PE.yield,
CONVERT(DECIMAL(10,2),((INS.ForeignInvest+INS.InvestTrust)/Com.Capital)*100) as 'FIRatio1',
CONVERT(DECIMAL(10,2),((INS.ForeignInvest_MA3+INS.InvestTrust_MA3)/Com.Capital)*100) as 'FIRatio3',
CONVERT(DECIMAL(10,2),((INS.ForeignInvest_MA12+INS.InvestTrust_MA12)/Com.Capital)*100) as 'FIRatio12',
CONVERT(DECIMAL(10,2),((INS.ForeignInvest_MA60+INS.InvestTrust_MA60)/Com.Capital)*100) as 'FIRatio60',
INS.ForeignInvest,
INS.ForeignInvestCost,
INS.ForeignInvestCostStartDate,
INS.InvestTrust,
INS.InvestTrustCost,
INS.InvestTrustCostStartDate,
MSales.salesYoY,
com_status.Status,
com_status.Status_StartDate,
com_status.BreakTh_High,
com_status.FallBelow_Low,
dt.Volume/1000 as 'DayTrade_Vol'
FROM Company AS Com 
INNER JOIN temp_company_sdd AS SDD ON Com.CompanyID = SDD.CID
INNER JOIN temp_company_spi AS SPI ON SDD.CID = SPI.CompanyID AND SDD.PriceDate = SPI.PriceDate 
LEFT JOIN temp_company_instilinvest as INS on SDD.CID=INS.CID AND SDD.PriceDate=INS.DataDate
LEFT JOIN temp_company_swd AS SWD ON SDD.CID = SWD.CompanyID AND SDD.PriceDate = SWD.EndDate
LEFT JOIN Trend_Tracking AS TT on SDD.CID=TT.CID and SDD.PriceDate=TT.PriceDate
LEFT JOIN DayTrading as dt on SDD.CID=dt.cid and SDD.PriceDate=dt.DataDate
LEFT JOIN temp_company_msalesYoY AS MSales on Com.CompanyID=MSales.cid
LEFT JOIN CompanyStatus as com_status on Com.CompanyID=com_status.CompanyID and SDD.PriceDate=com_status.PriceDate
LEFT JOIN CompanySignalTracking as CST on com.CompanyID=CST.CompanyID and SDD.PriceDate=CST.PriceDate
LEFT JOIN temp_company_pe AS PE ON ltrim(rtrim(substring(Com.Symbol,0,5))) = ltrim(rtrim(PE.symbol))
WHERE
Com.Status=1 
AND Com.Capital&lt;&gt;0
AND (Com.industry like N'%'+@industry+'%')							-- Industry
AND (SDD.PriceDate = @pricedate) 
AND (SDD.Volume*SDD.DayClose &gt;= @volume) 
AND ((MSales.salesYoY &gt;= @msales) or (MSales.salesYoY is null))

-- 週線基期 判斷偏離盤區幅度
AND (SDD.DayClose/SWD.WeekMA20&lt;=@WeekMa24)
AND (SWD.WeekMA20/SWD.WeekMA35&lt;=@WeekMa48)

-- 籌碼
AND ((((INS.ForeignInvest+INS.InvestTrust)/Com.Capital)*100 &gt;= @FIRatio1) or (INS.ForeignInvest is Null) or (INS.InvestTrust is Null))
--AND ((((INS.ForeignInvest_MA3+INS.InvestTrust_MA3)/Com.Capital)*100 &gt;= @FIRatio3) or (INS.ForeignInvest_MA3 is Null) or (INS.InvestTrust_MA3 is Null))
AND ((((INS.ForeignInvest_MA12+INS.InvestTrust_MA12)/Com.Capital)*100 &gt;= @FIRatio12) or (INS.ForeignInvest_MA12 is Null) or (INS.InvestTrust_MA12 is Null))
AND ((((INS.ForeignInvest_MA60+INS.InvestTrust_MA60)/Com.Capital)*100 &gt;= @FIRatio60) or (INS.ForeignInvest_MA60 is Null) or (INS.InvestTrust_MA60 is Null))

-- 多頭趨勢
AND 
(
	(SDD.DayClose&gt;=SDD.MA20)	
	AND	
	(SDD.DayClose&gt;=SDD.MA60) 
	AND
	(SPI.MA20_Status = N'向上' OR SPI.MA20_Status = N'轉上' OR SPI.MA60_Status = N'向上' OR SPI.MA60_Status = N'轉上')
)

-- 量能
AND ((SDD.Volume/SPI.Day1_Vol) &gt;= @ty_vol_ratio) --今昨量
--AND ((SPI.VolAvg3_Status = N'轉上' OR SPI.VolAvg3_Status = N'增加' OR SPI.VolAvg3_Status = N'突破') 
--or ((SDD.Vol_MA3 / SDD.Vol_MA15) &lt;=0.8))

-- 目前訊號
AND (CST.Signal LIKE N'%'+@cst_signal+'%')  -- CompanySignalTracking 
-- 今訊號
AND (TT.SignalType LIKE N'%'+@signal_type+'%' or TT.SignalType is null) -- Trend_Tracking
--and (com_status.BreakTh_High like '%'+@breakth_high+'%' or com_status.BreakTh_High is null) -- 今過黑Ｋ高點

Order by SPI.Days_Ma5OnMa20, Com.Symbol</CommandText>
      </Query>
