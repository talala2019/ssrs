(Fields!DayClose.Value - Fields!MA20.Value) / Fields!MA20.Value&gt;0.1 and Fields!MA20.Value&lt;&gt;0,"Pink",
(Fields!DayClose.Value - Fields!MA20.Value) / Fields!MA20.Value&gt;0.2 and Fields!MA20.Value&lt;&gt;0,"Yellow",
0=0,"White")</BackgroundColor>
                            <VerticalAlign>Middle</VerticalAlign>
