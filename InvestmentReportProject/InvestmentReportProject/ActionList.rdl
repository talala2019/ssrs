                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=IIf(((Fields!MA11.Value * 11)-Fields!DayClose.Value)&gt;0,((Fields!MA11.Value * 11)-Fields!DayClose.Value)/10,"")</Value>
                                  <Style>
                                    <FontWeight>Bold</FontWeight>
                                    <Format>0</Format>
                                    <Color>=IIf(Fields!DayClose.Value&lt;Fields!MA20.Value,"DimGray","DarkBlue")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
