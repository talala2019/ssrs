                            </Border>
                            <BackgroundColor>=Switch((Fields!DayClose.Value - Fields!MA60.Value) / Fields!MA60.Value&lt;0 and Fields!MA60.Value&lt;&gt;0, "LightGreen",
(Fields!DayClose.Value - Fields!MA60.Value) / Fields!MA60.Value&gt;0.1 and Fields!MA60.Value&lt;&gt;0,"Pink",
(Fields!DayClose.Value - Fields!MA60.Value) / Fields!MA60.Value&gt;0.2 and Fields!MA60.Value&lt;&gt;0,"Yellow",
0=0,"White")</BackgroundColor>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="DayClose7">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Format(Fields!DayClose.Value, "#,#") + "  "</Value>
                                  <Style>
                                    <FontWeight>Bold</FontWeight>
                                    <Format>0.0</Format>
                                    <Color>=Switch(Fields!DayClose.Value=Fields!DayOpen.Value,"DarkBlue",
Fields!DayClose.Value&gt;Fields!DayOpen.Value,"Red",
Fields!DayClose.Value&lt;Fields!DayOpen.Value,"Green")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
