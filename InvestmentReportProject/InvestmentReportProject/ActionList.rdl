    <DataSet Name="PriceDateList">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <CommandText>SELECT DISTINCT PriceDate
FROM  StockDailyData
WHERE (PriceDate &gt; GETDATE() - 30) 
and CompanyID=282
ORDER BY PriceDate Desc</CommandText>
      </Query>
      <Fields>
        <Field Name="PriceDate">
          <DataField>PriceDate</DataField>
          <rd:UserDefined>true</rd:UserDefined>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="PortfolioList">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <CommandText>select PID, Name, Name+' '+CAST(PID as varchar(10)) as'NameID' from PortfolioMain
where pid in (28, 33, 38, 58, 63, 68, 81, 82, 83, 85, 86, 88, 89, 112, 124, 133, 136, 138, 140, 141 )
order by priority, name, pid</CommandText>
      </Query>
      <Fields>
        <Field Name="PID">
          <DataField>PID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Name">
          <DataField>Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NameID">
          <DataField>NameID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
