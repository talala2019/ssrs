                              <TextRuns>
                                <TextRun>
                                  <Value>=IIf(Fields!MA20.Value&lt;&gt;0,(Fields!DayClose.Value - Fields!MA20.Value)/Fields!MA20.Value,"")</Value>
                                  <Style>
                                    <FontWeight>Bold</FontWeight>
                                    <Format>0.0%</Format>
                                    <Color>=Switch((Fields!DayClose.Value-Fields!MA20.Value)/Fields!MA20.Value&gt;0 and Fields!MA20.Value&lt;&gt;0,"Red",
(Fields!DayClose.Value-Fields!MA20.Value)/Fields!MA20.Value&lt;0 and Fields!MA20.Value&lt;&gt;0,"Green",
0=0,"Black")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Center</TextAlign>
                              </Style>
                            </Paragraph>
