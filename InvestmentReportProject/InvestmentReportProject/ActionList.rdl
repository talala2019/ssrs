                      <CellContents>
                        <Textbox Name="Action2">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Switch(Fields!Action.Value &lt;&gt; "", Fields!Action.Value, (Fields!DayClose.Value &lt; Fields!StopLossPoint.Value) And (Fields!StopLossPoint.Value &gt; 0) And (Fields!Quantity.Value &gt; 0), "&lt;停損&gt;", 0 = 0, Fields!Action.Value)</Value>
                                  <Style>
                                    <FontWeight>Bold</FontWeight>
                                    <Color>=Switch(InStr(Fields!Action.Value,"買")&gt;0,"Red",
InStr(Fields!Action.Value,"多")&gt;0,"Red",
InStr(Fields!Action.Value,"加碼")&gt;0,"Red",
InStr(Fields!Action.Value,"賣")&gt;0,"Green",
InStr(Fields!Action.Value,"空")&gt;0,"Green",
InStr(Fields!Action.Value,"減碼")&gt;0,"Green",
InStr(Fields!Action.Value,"開高走低")&gt;0,"Green",
0=0,"DarkBlue")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Center</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>Action</rd:DefaultName>
                          <Style>
                            <Border>
                              <Color>LightGrey</Color>
                              <Style>Solid</Style>
                            </Border>
                            <BackgroundColor>=Switch(InStr(Fields!Action.Value,"停損")&gt;0,"LightGreen",
(Fields!DayClose.Value&lt;Fields!StopLossPoint.Value) and (Fields!StopLossPoint.Value&gt;0) and (Fields!Quantity.Value&gt;0),"LightGreen",
Fields!row_no.Value Mod 2=0,"LightGoldenrodYellow",
0=0,"White")</BackgroundColor>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
