                              <Color>LightGrey</Color>
                              <Style>Solid</Style>
                            </Border>
                            <BackgroundColor>=Switch(
Fields!DayClose.Value&lt;Fields!MA20.Value,"LightGreen",
Fields!MA20_Status.Value="轉下","LightGreen",
Fields!MA20_Status.Value="向下","LightGreen",
0=0,"White")</BackgroundColor>
                            <VerticalAlign>Middle</VerticalAlign>
