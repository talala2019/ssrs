	(Fields!SortOrder.Value = 1 OR Fields!SortOrder.Value = 2) AND Fields!OriginalDate.Value&lt;=Fields!DisposeEndDate.Value AND Fields!OriginalDate.Value&gt;=Fields!DisposeStartDate.Value AND Fields!MatchType.Value="5分鐘", "LightGreen",
	Fields!SortOrder.Value = 4 AND Fields!DayClose.Value&gt; 0, "#FFD9D9",
	Fields!SortOrder.Value = 4 AND Fields!DayClose.Value&lt; 0, "#E2F0D9",
	Fields!SortOrder.Value = 5 AND Fields!DayClose.Value&gt; 0, "#FFD9D9",
	Fields!SortOrder.Value = 5 AND Fields!DayClose.Value&lt; 0, "#E2F0D9",
    Fields!SortOrder.Value = 6 AND Fields!DayClose.Value&gt;= 3, "#FFD9D9",
    Fields!SortOrder.Value = 6 AND Fields!DayClose.Value&lt;= -3, "#E2F0D9",
    True, "Transparent"
)</BackgroundColor>
