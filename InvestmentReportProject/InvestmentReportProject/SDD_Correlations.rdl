	Fields!SortOrder.Value = 6, "Bold",
    True, "Default"
)</FontWeight>
                                    <Color>=Switch(
    Fields!SortOrder.Value = 4 AND Fields!DayClose.Value&gt; 0, "Red",
	Fields!SortOrder.Value = 4 AND Fields!DayClose.Value&lt; 0, "Green",
	Fields!SortOrder.Value = 5 AND Fields!DayClose.Value&gt; 0, "Red",
	Fields!SortOrder.Value = 5 AND Fields!DayClose.Value&lt; 0, "Green",
    Fields!SortOrder.Value = 6 AND Fields!DayClose.Value&gt; 0, "Red",
    Fields!SortOrder.Value = 6 AND Fields!DayClose.Value&lt; 0, "Green",
	Fields!SortOrder.Value = 7, "White",
    True, "Black"
)</Color>
                                  </Style>
