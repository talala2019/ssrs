<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource_localhost">
      <DataSourceReference>DataSource_localhost</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>febada7d-33a9-4ce5-824c-96980664d78d</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@MarketType">
            <Value>=Parameters!MarketType.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select Com.Industry as 'Industry'
, CONVERT(DECIMAL(10, 2),SUM(Ins.ForeignInvest*(  (DayHigh+DayLow)/2 ))/100000000) as 'ForeignInvest_Amt'
, CONVERT(DECIMAL(10, 2),SUM(Ins.InvestTrust*(  (DayHigh+DayLow)/2 ))/100000000) as 'InvestTrust_Amt'
, CONVERT(DECIMAL(10, 2),SUM(Ins.Dealer*(  (DayHigh+DayLow)/2 ))/100000000) as 'Dealer_Amt'
, CONVERT(DECIMAL(10, 2),SUM((Ins.ForeignInvest+Ins.InvestTrust+Ins.Dealer)*((DayHigh+DayLow)/2))/100000000) as 'Total_BuySell_Amount'
, Sum((Com.Capital*SDD.DayClose/100000)) as 'Today_MarketValue',
Max(DataDate) as 'EndDate'
from InstitutionalInvest as Ins 
inner join StockDailyData as SDD on Ins.CID=SDD.CompanyID and Ins.DataDate=SDD.PriceDate and Ins.DataDate&gt;=@StartDate and Ins.DataDate&lt;=@EndDate
inner join Company as Com on SDD.CompanyID=Com.CompanyID and Com.Status=1 and Com.CountryCode='TW' and ltrim(rtrim(Com.Symbol)) like '%'+ @MarketType
Group by Com.Industry
Having ltrim(rtrim(com.Industry))&lt;&gt;''
order by Total_BuySell_Amount desc</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Industry">
          <DataField>Industry</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ForeignInvest_Amt">
          <DataField>ForeignInvest_Amt</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="InvestTrust_Amt">
          <DataField>InvestTrust_Amt</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Dealer_Amt">
          <DataField>Dealer_Amt</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Total_BuySell_Amount">
          <DataField>Total_BuySell_Amount</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Today_MarketValue">
          <DataField>Today_MarketValue</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="EndDate">
          <DataField>EndDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet2">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@MarketType">
            <Value>=Parameters!MarketType.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Industry">
            <Value>=Parameters!Industry.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select CONVERT(VARCHAR(10), Ins.DataDate, 111) as 'Date'
, Com.Industry as 'Industry'
, CONVERT(DECIMAL(10, 2),SUM(Ins.ForeignInvest*(  (DayHigh+DayLow)/2 ))/100000000) as 'ForeignInvest_Amt'
, CONVERT(DECIMAL(10, 2),SUM(Ins.InvestTrust*(  (DayHigh+DayLow)/2 ))/100000000) as 'InvestTrust_Amt'
, CONVERT(DECIMAL(10, 2),SUM(Ins.Dealer*(  (DayHigh+DayLow)/2 ))/100000000) as 'Dealer_Amt'
, CONVERT(DECIMAL(10, 2),SUM((Ins.ForeignInvest+Ins.InvestTrust+Ins.Dealer)*((DayHigh+DayLow)/2))/100000000) as 'Total_BuySell_Amount'
,Sum((Com.Capital*SDD.DayClose/100000)) as 'Today_MarketValue'
from InstitutionalInvest as Ins 
inner join StockDailyData as SDD on Ins.CID=SDD.CompanyID and Ins.DataDate=SDD.PriceDate
inner join Company as Com on SDD.CompanyID=Com.CompanyID and Com.Status=1 and Com.CountryCode='TW' and ltrim(rtrim(Com.Symbol)) like '%'+ @MarketType 
Group by Ins.DataDate, Com.Industry
Having Ins.DataDate&gt;=@StartDate and Ins.DataDate&lt;=@EndDate
and (( ltrim(rtrim(Com.Industry)) = N'' + ltrim(rtrim(@Industry)) + '' ))
and ltrim(rtrim(Com.Industry))&lt;&gt;''
order by Com.Industry, Ins.DataDate desc</CommandText>
      </Query>
      <Fields>
        <Field Name="Date">
          <DataField>Date</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="Industry">
          <DataField>Industry</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ForeignInvest_Amt">
          <DataField>ForeignInvest_Amt</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="InvestTrust_Amt">
          <DataField>InvestTrust_Amt</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Dealer_Amt">
          <DataField>Dealer_Amt</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Total_BuySell_Amount">
          <DataField>Total_BuySell_Amount</DataField>
          <rd:TypeName>System.Decimal</rd:TypeName>
        </Field>
        <Field Name="Today_MarketValue">
          <DataField>Today_MarketValue</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet3">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select Com.Industry as 'Industry'
, CONVERT(DECIMAL(10, 2),SUM((Ins.ForeignInvest+Ins.InvestTrust+Ins.Dealer)*((DayHigh+DayLow)/2))/100000000)/Sum((Com.Capital*SDD.DayClose/100000)) as 'BuySell_Ratio'
from InstitutionalInvest as Ins 
inner join StockDailyData as SDD on Ins.CID=SDD.CompanyID and Ins.DataDate=SDD.PriceDate and Ins.DataDate&gt;=@StartDate and Ins.DataDate&lt;=@EndDate
inner join Company as Com on SDD.CompanyID=Com.CompanyID and Com.Status=1 and Com.CountryCode='TW'
Group by Com.Industry
Having ltrim(rtrim(com.Industry))&lt;&gt;''
order by BuySell_Ratio desc</CommandText>
      </Query>
      <Fields>
        <Field Name="Industry">
          <DataField>Industry</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="BuySell_Ratio">
          <DataField>BuySell_Ratio</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="DataSet4">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <CommandText>select top 1 PriceDate as 'LastDay' from temp_company_sdd where 
 CID=282 and PriceDate&gt;getdate()-7 ORDER BY PriceDate</CommandText>
      </Query>
      <Fields>
        <Field Name="LastDay">
          <DataField>LastDay</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
