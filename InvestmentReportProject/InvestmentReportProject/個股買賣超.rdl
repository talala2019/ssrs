    <DataSet Name="DataSet2_TimeIntervals">
      <Query>
        <DataSourceName>DataSource_InMemoryOLTP_KGI_DB</DataSourceName>
        <CommandText>WITH TimeIntervals AS (
    SELECT CAST('09:03' AS TIME) AS TimeInterval
    UNION ALL
    SELECT DATEADD(MINUTE, 3, TimeInterval) 
    FROM TimeIntervals
    WHERE TimeInterval &lt; '13:30' -- Adjusted to '13:30'
)
SELECT CONVERT(VARCHAR(5), TimeInterval, 108) AS TimeIntervalFormatted
FROM TimeIntervals
OPTION (MAXRECURSION 0);</CommandText>
      </Query>
      <Fields>
        <Field Name="TimeIntervalFormatted">
          <DataField>TimeIntervalFormatted</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
