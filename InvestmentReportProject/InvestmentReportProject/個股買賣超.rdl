    <DataSet Name="DataSet_temp_company_sdd">
      <Query>
        <DataSourceName>Investment_DB</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@stockno">
            <Value>=Parameters!stockno.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT TOP (1) Com.Capital, temp_sdd.CID, temp_sdd.PriceDate, temp_sdd.DayOpen, temp_sdd.DayHigh, temp_sdd.DayLow, temp_sdd.DayClose, temp_sdd.Volume, temp_sdd.Vol_MA3, temp_sdd.Vol_MA5, temp_sdd.Vol_MA10, temp_sdd.Vol_MA15, temp_sdd.Vol_MA20, temp_sdd.MA5, temp_sdd.MA10, temp_sdd.MA11, temp_sdd.MA20, temp_sdd.MA42, temp_sdd.MA60, 
            temp_sdd.MA100, temp_sdd.PreClose, temp_sdd.Min_Vol20, temp_sdd.MA240, daytrade.Name, daytrade.Volume / 1000 AS 'DayTrade_Vol', CONVERT(DECIMAL(10, 2), temp_sdd.Volume * 1000 / Com.Capital / 10) AS 'TurnOverRate'
FROM   INVESTMENT_DB.dbo.temp_company_sdd AS temp_sdd INNER JOIN
            INVESTMENT_DB.dbo.Company AS Com ON temp_sdd.CID = Com.CompanyID INNER JOIN
            INVESTMENT_DB.dbo.DayTrading AS daytrade ON temp_sdd.CID = daytrade.CID AND temp_sdd.PriceDate = daytrade.DataDate
WHERE (temp_sdd.CID IN (SELECT CompanyId FROM Company as Com WHERE com.CountryCode='TW' and com.Status=1 and Com.Symbol LIKE '%' + ltrim(rtrim(@stockno)) + '%'))
ORDER BY temp_sdd.PriceDate DESC</CommandText>
      </Query>
      <Fields>
        <Field Name="Capital">
          <DataField>Capital</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="CID">
          <DataField>CID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="PriceDate">
          <DataField>PriceDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="DayOpen">
