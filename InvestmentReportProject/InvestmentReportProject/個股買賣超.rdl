                                  <Style>
                                    <FontFamily />
                                    <FontWeight>Bold</FontWeight>
                                    <Color>=Switch(Min(Fields!PctChg_Open.Value)&gt;0,"Red",
Min(Fields!PctChg_Open.Value)&lt;0,"Green",
0=0,"Black")</Color>
