(Fields!TradeType.Value="long" and Fields!PctChg_Open.Value&gt;=2 and Fields!PctChg_Open.Value&gt;=Previous(Fields!PctChg_Open.Value)),"Pink",
(Fields!TradeType.Value="long" and Fields!PctChg_Open.Value&lt;0),"LightGreen",
(Fields!TradeType.Value="short" and Fields!PctChg_Open.Value&lt;=-2 and Fields!PctChg_Open.Value&lt;Previous(Fields!PctChg_Open.Value)),"LightGreen",
(Fields!TradeType.Value="short" and Fields!PctChg_Open.Value&gt;0),"Pink",
(Fields!PctChg_Open.Value&lt;=-1.5),"LightGreen",
0=0,"White")</BackgroundColor>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
