                            <FontFamily />
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="DayOpen">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Format(Fields!DayOpen.Value,"#,#.0")+"    "</Value>
                                  <Style>
                                    <FontFamily />
                                    <FontSize>11pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Color>DarkViolet</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>DayOpen</rd:DefaultName>
                          <Style>
                            <Border>
                              <Style>None</Style>
                            </Border>
                            <BackgroundColor>Gainsboro</BackgroundColor>
                            <FontFamily />
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="DayHigh2">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Format(((Fields!CurrentPrice.Value/Fields!DayHigh.Value)-1)*100,"#.0")+"% "</Value>
                                  <Style>
                                    <FontFamily />
                                    <FontSize>11pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Color>DarkBlue</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>DayHigh</rd:DefaultName>
                          <Style>
                            <Border>
                              <Style>None</Style>
                            </Border>
                            <BackgroundColor>=Switch(
((Fields!CurrentPrice.Value/Fields!DayHigh.Value)-1)*100&lt;-3,"LightBlue",
((Fields!CurrentPrice.Value/Fields!DayHigh.Value)-1)*100&lt;-2,"LightGreen",
0=0,"White")</BackgroundColor>
                            <FontFamily />
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="DayLow2">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Format(((Fields!CurrentPrice.Value/Fields!DayLow.Value)-1)*100,"#.0")+"% "</Value>
                                  <Style>
                                    <FontFamily />
                                    <FontSize>11pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Color>DarkBlue</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>DayLow</rd:DefaultName>
                          <Style>
                            <Border>
                              <Style>None</Style>
                            </Border>
                            <BackgroundColor>=Switch(
((Fields!CurrentPrice.Value/Fields!DayLow.Value)-1)*100&gt;=5,"Yellow",
((Fields!CurrentPrice.Value/Fields!DayLow.Value)-1)*100&gt;=3,"Pink",
((Fields!CurrentPrice.Value/Fields!DayLow.Value)-1)*100&gt;=2,"LightGoldenrodYellow",
0=0,"White")</BackgroundColor>
                            <FontFamily />
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="CurrentPrice">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Format(Fields!CurrentPrice.Value,"#,#.0")+"  "</Value>
                                  <Style>
                                    <FontFamily />
                                    <FontSize>=Switch(Fields!CurrentPrice.Value=Fields!DayHigh.Value,"12pt",
Fields!CurrentPrice.Value=Fields!DayLow.Value,"12pt",
0=0,"11pt")</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <TextDecoration>Underline</TextDecoration>
                                    <Color>=Switch(
(Fields!CurrentPrice.Value&gt;Fields!AvgPrz.Value and Fields!CurrentPrice.Value&gt;Fields!DayOpen.Value),"Red",
(Fields!CurrentPrice.Value&lt;Fields!AvgPrz.Value and Fields!CurrentPrice.Value&lt;Fields!DayOpen.Value),"DarkGreen",
0=0,"DarkBlue")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                                <LineHeight>=Switch(Fields!CurrentPrice.Value=Fields!DayHigh.Value,"11pt",
Fields!CurrentPrice.Value=Fields!DayLow.Value,"11pt",
0=0,"10pt")</LineHeight>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>CurrentPrice</rd:DefaultName>
                          <Style>
                            <Border>
                              <Style>None</Style>
                            </Border>
                            <BackgroundColor>=Switch(
(Fields!CurrentPrice.Value&lt;Fields!DayOpen.Value),"LightBlue",
(Fields!CurrentPrice.Value&lt;Fields!AvgPrz.Value),"LightGreen",
0=0,"White")</BackgroundColor>
                            <FontFamily />
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="PctChg">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Format(Fields!PctChg.Value,"#,#.00")+"%   "</Value>
                                  <Style>
                                    <FontFamily />
                                    <FontSize>11pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Color>=Switch(
Fields!PctChg.Value&gt;3,"Red",
Fields!PctChg.Value&gt;0,"DarkBlue",
Fields!PctChg.Value&lt;0,"Green",
0=0,"Black")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>PctChg</rd:DefaultName>
                          <Style>
                            <Border>
                              <Style>None</Style>
                            </Border>
                            <BackgroundColor>=Switch(
(Fields!PctChg.Value&gt;=6),"Yellow",
(Fields!PctChg.Value&gt;=3),"Pink",
(Fields!PctChg.Value&gt;=0),"LemonChiffon",
(Fields!PctChg.Value&lt;=-6),"LightBlue",
(Fields!PctChg.Value&lt;=-2),"LightGreen",
0=0,"White")</BackgroundColor>
                            <FontFamily />
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="PctChg_Open">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Switch((Fields!PctChg_Open.Value=Max(Fields!PctChg_Open.Value, "DataSet3")),"最高 "+Format(Fields!PctChg_Open.Value,"#,#.00")+"%   ",
0=0,Format(Fields!PctChg_Open.Value,"#,#.00")+"%   ")</Value>
                                  <Style>
                                    <FontFamily />
                                    <FontWeight>Bold</FontWeight>
                                    <Color>=Switch(Fields!PctChg_Open.Value&gt;0,"Red",
Fields!PctChg_Open.Value&lt;0,"Green",
0=0,"Black")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>PctChg_Open</rd:DefaultName>
                          <Style>
                            <Border>
                              <Style>None</Style>
                            </Border>
                            <BackgroundColor>=Switch(
(Fields!PctChg_Open.Value&gt;=5),"Yellow",
(Fields!PctChg_Open.Value&gt;=3),"Pink",
(Fields!PctChg_Open.Value&lt;=-5),"LightBlue",
(Fields!PctChg_Open.Value&lt;=-3),"LightGreen",
0=0,"White")</BackgroundColor>
                            <FontFamily />
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="CurrentQty">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Format(Fields!CurrentQty.Value,"#,#")+"  "</Value>
                                  <Style>
                                    <FontFamily />
                                    <Color>#333333</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>CurrentQty</rd:DefaultName>
                          <Style>
                            <Border>
                              <Style>None</Style>
                            </Border>
                            <BackgroundColor>=IIF(RowNumber(Nothing) = CountRows("DataSet1"), "LightBlue", "Transparent")</BackgroundColor>
                            <FontFamily />
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Textbox235">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Format(Fields!CurrentQty.Value-Previous(Fields!CurrentQty.Value),"#,#")+"  "</Value>
                                  <Style>
                                    <FontFamily />
                                    <FontSize>=IIf((Fields!BS_Qty.Value-Previous(Fields!BS_Qty.Value))&gt;(Fields!CurrentQty.Value-Previous(Fields!CurrentQty.Value)),"12pt","10pt")</FontSize>
                                    <FontWeight>=IIf((Fields!BS_Qty.Value-Previous(Fields!BS_Qty.Value))&gt;(Fields!CurrentQty.Value-Previous(Fields!CurrentQty.Value)),"Bold","Default")</FontWeight>
                                    <Color>=IIf((Fields!BS_Qty.Value-Previous(Fields!BS_Qty.Value))&gt;(Fields!CurrentQty.Value-Previous(Fields!CurrentQty.Value)),"Red","Black")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>Textbox235</rd:DefaultName>
                          <Style>
                            <Border>
                              <Style>None</Style>
                            </Border>
                            <BackgroundColor>=IIf(Abs(Fields!BS_Qty.Value-Previous(Fields!BS_Qty.Value))&gt;(Fields!CurrentQty.Value-Previous(Fields!CurrentQty.Value)),"LightGreen","White")</BackgroundColor>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Textbox77">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Format(((Fields!CurrentQty.Value-Previous(Fields!CurrentQty.Value))/Previous(Fields!CurrentQty.Value))*100,"#,#.0")+"  "</Value>
                                  <Style>
                                    <FontFamily />
                                    <Color>DarkBlue</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>Textbox77</rd:DefaultName>
                          <Style>
                            <Border>
                              <Style>None</Style>
                            </Border>
                            <BackgroundColor>=Switch(
((Fields!CurrentQty.Value-Previous(Fields!CurrentQty.Value))/Previous(Fields!CurrentQty.Value))*100&gt;50,"Yellow",
((Fields!CurrentQty.Value-Previous(Fields!CurrentQty.Value))/Previous(Fields!CurrentQty.Value))*100&gt;20,"Pink",
((Fields!CurrentQty.Value-Previous(Fields!CurrentQty.Value))/Previous(Fields!CurrentQty.Value))*100&gt;10,"LemonChiffon",
0=0,"White")</BackgroundColor>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="QtyEst">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Format(Fields!QtyEst.Value,"#,#")+"    "</Value>
                                  <Style>
                                    <FontFamily />
                                    <FontWeight>Bold</FontWeight>
                                    <Color>#333333</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>QtyEst</rd:DefaultName>
                          <Style>
                            <Border>
                              <Style>None</Style>
                            </Border>
                            <FontFamily />
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Textbox56">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Format(Fields!QtyEst.Value / Last(Fields!Vol_MA20.Value, "DataSet_temp_company_sdd"), "#,#.0") + " 倍 "</Value>
                                  <Style>
                                    <FontFamily />
                                    <FontSize>11pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Color>Blue</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>Textbox51</rd:DefaultName>
                          <Style>
                            <Border>
                              <Style>None</Style>
                            </Border>
                            <BackgroundColor>=Switch(
Fields!QtyEst.Value / Last(Fields!Vol_MA20.Value, "DataSet_temp_company_sdd")&gt;6,"Yellow",
Fields!QtyEst.Value / Last(Fields!Vol_MA20.Value, "DataSet_temp_company_sdd")&gt;5,"Pink",
0=0,"White")</BackgroundColor>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="AvgPrz">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Format(Fields!AvgPrz.Value,"#,#.0")+"   "</Value>
                                  <Style>
                                    <FontFamily />
                                    <FontWeight>Bold</FontWeight>
                                    <Color>DarkBlue</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>AvgPrz</rd:DefaultName>
                          <Style>
                            <Border>
                              <Style>None</Style>
                            </Border>
                            <BackgroundColor>=Switch(
Fields!BS_Qty.Value&gt;=Max(Fields!BS_Qty.Value, "DataSet1"),"Pink",
Fields!CurrentPrice.Value&lt;Fields!AvgPrz.Value,"LightGreen",
0=0,"White")</BackgroundColor>
                            <FontFamily />
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Textbox21">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Format(((Fields!CurrentPrice.Value / Fields!AvgPrz.Value) - 1) * 100, "#,#.00") + "  "</Value>
                                  <Style>
                                    <FontFamily />
                                    <FontWeight>Bold</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                    <Color>DarkBlue</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>Textbox21</rd:DefaultName>
                          <Style>
                            <Border>
                              <Style>None</Style>
                            </Border>
                            <BackgroundColor>=Switch(
((Fields!CurrentPrice.Value / Fields!AvgPrz.Value) - 1) * 100&gt;=3.5,"Yellow",
((Fields!CurrentPrice.Value / Fields!AvgPrz.Value) - 1) * 100&gt;=1.9,"Pink",
((Fields!CurrentPrice.Value / Fields!AvgPrz.Value) - 1) * 100&gt;0,"LightGoldenrodYellow",
((Fields!CurrentPrice.Value / Fields!AvgPrz.Value) - 1) * 100&lt;=-1.9,"LightBlue",
((Fields!CurrentPrice.Value / Fields!AvgPrz.Value) - 1) * 100&lt;0,"LightGreen",
0=0,"White")</BackgroundColor>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Textbox323">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Switch(
((((Fields!CurrentPrice.Value / Fields!AvgPrz.Value) - 1)-((Previous(Fields!CurrentPrice.Value) / Previous(Fields!AvgPrz.Value)) - 1))*100)&gt;2,"急漲",
((((Fields!CurrentPrice.Value / Fields!AvgPrz.Value) - 1)-((Previous(Fields!CurrentPrice.Value) / Previous(Fields!AvgPrz.Value)) - 1))*100)&lt;-2,"急跌",
0=0,"")</Value>
                                  <Style>
                                    <FontFamily />
                                    <FontWeight>Bold</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                    <Color>=Switch(
((((Fields!CurrentPrice.Value / Fields!AvgPrz.Value) - 1)-((Previous(Fields!CurrentPrice.Value) / Previous(Fields!AvgPrz.Value)) - 1))*100)&gt;2.5,"Red",
((((Fields!CurrentPrice.Value / Fields!AvgPrz.Value) - 1)-((Previous(Fields!CurrentPrice.Value) / Previous(Fields!AvgPrz.Value)) - 1))*100)&lt;-2.5,"Green",
0=0,"Black")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Center</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>Textbox323</rd:DefaultName>
                          <Style>
                            <Border>
                              <Style>None</Style>
                            </Border>
                            <BackgroundColor>=Switch(
((Fields!CurrentPrice.Value / Fields!AvgPrz.Value) - 1) * 100&gt;=3.5,"Yellow",
((Fields!CurrentPrice.Value / Fields!AvgPrz.Value) - 1) * 100&gt;=1.9,"Pink",
((Fields!CurrentPrice.Value / Fields!AvgPrz.Value) - 1) * 100&gt;0,"LightGoldenrodYellow",
((Fields!CurrentPrice.Value / Fields!AvgPrz.Value) - 1) * 100&lt;=-1.9,"LightBlue",
((Fields!CurrentPrice.Value / Fields!AvgPrz.Value) - 1) * 100&lt;0,"LightGreen",
0=0,"White")</BackgroundColor>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="BS_Qty">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Switch((Fields!BS_Qty.Value=Max(Fields!BS_Qty.Value, "DataSet1")),"最高 "+Format(Fields!BS_Qty.Value,"#,#")+"   ",
(Fields!BS_Qty.Value=Min(Fields!BS_Qty.Value, "DataSet1")),"最低 "+Format(Fields!BS_Qty.Value,"#,#")+"   ",
0=0,Format(Fields!BS_Qty.Value,"#,#")+"   ")</Value>
                                  <Style>
                                    <FontFamily />
                                    <FontSize>=Switch((Fields!BS_Qty.Value=Max(Fields!BS_Qty.Value, "DataSet1")),"11pt",
(Fields!BS_Qty.Value=Min(Fields!BS_Qty.Value, "DataSet1")),"11pt",
0=0,"10pt")</FontSize>
                                    <FontWeight>=Switch((Fields!BS_Qty.Value=Max(Fields!BS_Qty.Value, "DataSet1")),"Bold",
(Fields!BS_Qty.Value=Min(Fields!BS_Qty.Value, "DataSet1")),"Bold",
0=0,"Default")</FontWeight>
                                    <TextDecoration>=IIF(RowNumber(Nothing) = CountRows("DataSet1"), "Underline", "Default")</TextDecoration>
                                    <Color>=IIf(Fields!BS_Qty.Value&gt;0,"Red","Green")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>BS_Qty</rd:DefaultName>
                          <Style>
                            <Border>
                              <Style>None</Style>
                            </Border>
