                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Format(Fields!DayOpen.Value, "#,#.0") + "  "</Value>
                                  <Style>
                                    <FontFamily />
