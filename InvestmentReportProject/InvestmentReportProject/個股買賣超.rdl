  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource_InMemoryOLTP_KGI_DB</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@messagetime">
            <Value>=Parameters!messagetime.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@sender">
            <Value>=Parameters!sender.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@tradetype">
            <Value>=Parameters!tradetype.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@stockno">
            <Value>=Parameters!stockno.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@pattern">
            <Value>=Parameters!pattern.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@StartTime">
            <Value>=Parameters!StartTime.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndTime">
            <Value>=Parameters!EndTime.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@stockfuture">
            <Value>=Parameters!stockfuture.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@grouptype">
            <Value>=Parameters!grouptype.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@pid">
            <Value>=Parameters!pid.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT ROW_NUMBER() over (order by StockNo, MessageTime) as row_no, 
MessageTime, StockNo, StockName, TradeType, YtdClose, DayOpen, DayHigh, DayLow, CurrentPrice, PctChg, PctChg_Open, CurrentQty, QtyEst, AvgPrz, BS_Qty, BS_Ratio, OpenPosnPrz, StopProfitPrz, StopLossPrz, Pattern1, Pattern2, 
                  Pattern3, Pattern4, Sender, FIRatio1, FIRatio3, FIRatio12, FIRatio20, StockFuture, StockFuturePrice, Status, ThresHoldQty, GroupType, Pid, KGI_Group
FROM     line_message_log
WHERE  (MessageTime &gt;= @messagetime) AND (Sender LIKE '%' + @sender + '%') AND (TradeType LIKE N'%' + @tradetype + '%') AND (StockNo LIKE '%' + @stockno + '%')
AND ((Pattern1 LIKE N'%' + @pattern + '%' ) or (Pattern2 LIKE N'%' + @pattern + '%' ) or (Pattern3 LIKE N'%' + @pattern + '%' ) or (Pattern4 LIKE N'%' + @pattern + '%' ))
AND (CAST(MessageTime AS TIME)  BETWEEN @StartTime AND @EndTime)
AND (StockFuture LIKE '%' + @stockfuture + '%' ) 
AND (GroupType LIKE N'%' + @grouptype + '%' )
AND (Pid LIKE '' + @pid + '%' )
ORDER BY StockNo, MessageTime</CommandText>
      </Query>
      <Fields>
        <Field Name="row_no">
          <DataField>row_no</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="MessageTime">
