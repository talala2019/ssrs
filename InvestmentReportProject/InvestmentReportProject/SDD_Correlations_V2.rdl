                                      <Color>Gainsboro</Color>
                                      <Style>None</Style>
                                    </Border>
                                    <FontSize>8pt</FontSize>
                                    <Color>#5c5c5c</Color>
                                  </Style>
                                  <ChartAxisTitle>
                                    <Caption />
                                    <Style>
                                      <FontSize>9pt</FontSize>
                                      <Color>#5c5c5c</Color>
                                    </Style>
                                  </ChartAxisTitle>
                                  <Margin>False</Margin>
                                  <ChartMajorGridLines>
                                    <Enabled>False</Enabled>
                                    <Style>
