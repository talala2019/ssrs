<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource_localhost">
      <DataSourceReference>DataSource_localhost</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>0c8b0029-2251-4660-b70d-f20c6ab2028e</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@InputCode1">
            <Value>=Parameters!InputCode1.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@InputCode2">
            <Value>=Parameters!InputCode2.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>WITH RawData AS (
    SELECT 
        CASE 
            WHEN com.Symbol LIKE @InputCode1 + '%' THEN 1 
            WHEN com.Symbol LIKE @InputCode2 + '%' THEN 2 
        END AS SortOrder,
        LEFT(com.Symbol, 4) AS Symbol, 
        com.ChtName, 
        sdd.PriceDate AS OriginalDate, 
        FORMAT(sdd.PriceDate, 'MM-dd') AS FormattedDate, 
        sdd.DayClose,
        sdd.Close_Chg1 -- 這裡是第 7 個欄位
    FROM company com 
    INNER JOIN temp_sdd_for_correlations sdd ON com.CompanyID = sdd.CID
    WHERE com.Status = 1 AND (com.Symbol LIKE @InputCode1 + '%' OR com.Symbol LIKE @InputCode2 + '%')
      AND sdd.PriceDate &gt; GETDATE() - 120
),
RatioData AS (
    SELECT 
        3 AS SortOrder, N'比值' AS Symbol, '' AS ChtName, 
        MAX(OriginalDate) AS OriginalDate, FormattedDate, 
        CAST(SUM(CASE WHEN SortOrder = 1 THEN DayClose END) / 
              NULLIF(SUM(CASE WHEN SortOrder = 2 THEN DayClose END), 0) AS DECIMAL(10, 2)) AS DayClose,
        0 AS Close_Chg1 -- [修正] 補上第 7 個欄位
    FROM RawData GROUP BY FormattedDate
)
SELECT * FROM RawData
UNION ALL
SELECT * FROM RatioData
UNION ALL
SELECT 
    4 AS SortOrder, N'乖離 %' AS Symbol, '' AS ChtName, 
    OriginalDate, FormattedDate, 
    Round(((DayClose / AVG(DayClose) OVER()) - 1)*100,1) AS DayClose,
    0 AS Close_Chg1 -- [修正] 補上第 7 個欄位
FROM RatioData
UNION ALL
SELECT 
    5, 'Baseline', '', OriginalDate, FormattedDate, 
    0 AS DayClose, 
    0 AS Close_Chg1 -- [修正] 補上第 7 個欄位
FROM RatioData
ORDER BY SortOrder, OriginalDate DESC;</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="SortOrder">
          <DataField>SortOrder</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Symbol">
          <DataField>Symbol</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="ChtName">
          <DataField>ChtName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="OriginalDate">
          <DataField>OriginalDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="FormattedDate">
          <DataField>FormattedDate</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="DayClose">
          <DataField>DayClose</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Close_Chg1">
          <DataField>Close_Chg1</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
