                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Textbox33">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Format(((Fields!UpperBBand.Value / Fields!LowerBBand.Value) - 1) * 100, "#,#") + "      "</Value>
                                  <Style>
                                    <FontFamily>Tahoma</FontFamily>
                                    <FontWeight>Bold</FontWeight>
                                    <Color>=Switch(
((Fields!UpperBBand.Value/Fields!LowerBBand.Value)-1)*100&lt;=5,"White",
((Fields!UpperBBand.Value/Fields!LowerBBand.Value)-1)*100&lt;=10,"Green",
((Fields!UpperBBand.Value/Fields!LowerBBand.Value)-1)*100&gt;10,"Red",
0=0,"Gray")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>Textbox31</rd:DefaultName>
                          <Style>
                            <Border>
                              <Color>LightGrey</Color>
                              <Style>Solid</Style>
                            </Border>
                            <BackgroundColor>=Switch(
(Fields!DayClose.Value&gt;=Fields!UpperBBand.Value and (Fields!UpperBBand.Value/Fields!LowerBBand.Value)&lt;1.2),"LightBlue",
(Fields!UpperBBand.Value/Fields!LowerBBand.Value)&lt;=1.15,"LightBlue",
(Fields!UpperBBand.Value/Fields!LowerBBand.Value)&lt;=1.05,"LightGreen",
(Fields!UpperBBand.Value/Fields!LowerBBand.Value)&gt;=1.5,"Pink",
0=0,"White")</BackgroundColor>
