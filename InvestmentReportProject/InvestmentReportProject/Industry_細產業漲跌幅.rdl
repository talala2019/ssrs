Code.CalculatePriceLevel(Fields!DayClose.Value,Fields!UpperBBand.Value,Fields!LowerBBand.Value,(Fields!UpperBBand.Value+Fields!LowerBBand.Value)/2)&lt;=-9,"LightGreen",
