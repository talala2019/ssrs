<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource_localhost">
      <DataSourceReference>DataSource_localhost</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>dcd0c7f8-3f84-4537-8301-c081afa9a5f6</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@PriceDate">
            <Value>=Parameters!PriceDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@DayClose">
            <Value>=Parameters!DayClose.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@DaysOnMa5">
            <Value>=Parameters!DaysOnMa5.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@BandWidth">
            <Value>=Parameters!BandWidth.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Ma20Slope">
            <Value>=Parameters!Ma20Slope.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@PriceLevel">
            <Value>=Parameters!PriceLevel.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Symbol">
            <Value>=Parameters!Symbol.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select ROW_NUMBER() over (order by SPI.Close_Chg10 desc) as row_no, 
Com.CompanyID, Com.ChtName, Com.Symbol, Indus.IndustryID,
SPI.PriceDate,
SPI.DayClose, SPI.Close_Chg1, SPI.Close_Chg3, SPI.Close_Chg6, SPI.Close_Chg10, SPI.Close_Chg12, SPI.Close_Chg20, 
SPI.Close_Chg40, SPI.Close_Chg60, SPI.Close_Chg120,
SPI.Days_CloseOnMa5, SPI.Days_Ma5OnMa20, SPI.MA5_Status, SPI.MA20_Status, SPI.MA60_Status,
SPI.KLine_Status,
SPI.UpperBBand,
SPI.UpperSlope,
SPI.LowerBBand,
SPI.LowerSlope,
SDD.MA20_Slope,
SWD.WeekMA20, SWD.WeekMA35
from Company as Com
inner join IndustryIndex as Indus on Com.Symbol=Indus.IndustryCode
inner join StockPriceIndicator as SPI on Com.CompanyID=SPI.CompanyID
inner join temp_company_sdd as SDD on SPI.CompanyID=SDD.CID and SPI.PriceDate=SDD.PriceDate
left join StockWeeklyData as SWD on SPI.CompanyID=SWD.CompanyID and SPI.PriceDate=SWD.EndDate
CROSS APPLY (
    SELECT
        CASE
				WHEN SPI.UpperBBand = SPI.LowerBBand THEN 0
				ELSE
					CEILING(
						(SPI.DayClose - ((SPI.UpperBBand + SPI.LowerBBand) / 2.0)) /
						((SPI.UpperBBand - SPI.LowerBBand) / 20.0)
					)
        END AS PriceLevel
) pl
where Com.CompanyID in ( select CompanyID from Company where symbol in ( select IndustryCode from IndustryIndex ) ) and SPI.PriceDate=@PriceDate
and SPI.DayClose&gt;=@DayClose
and SPI.Days_CloseOnMa5&lt;=@DaysOnMa5
and (((SPI.UpperBBand/SPI.LowerBBand)-1)*100)&lt;=@BandWidth
and SDD.MA20_Slope&lt;=@Ma20Slope
and pl.PriceLevel&lt;=@PriceLevel
and ( Indus.IndustryCode like '%'+ltrim(rtrim(@Symbol))+'%' or Indus.IndustryName like N'%'+ltrim(rtrim(@Symbol))+'%' ) 	
order by SPI.Close_Chg10 desc</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="row_no">
          <DataField>row_no</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="CompanyID">
