                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Format(Code.CalculatePriceLevel(Fields!DayClose.Value,Fields!UpperBBand.Value,Fields!LowerBBand.Value,(Fields!UpperBBand.Value+Fields!LowerBBand.Value)/2), "#,#") + "      "</Value>
                                  <Style>
                                    <FontFamily>Tahoma</FontFamily>
                                    <FontWeight>Bold</FontWeight>
                                    <Format>+#;-#;0</Format>
                                    <Color>=Switch(
Code.CalculatePriceLevel(Fields!DayClose.Value,Fields!UpperBBand.Value,Fields!LowerBBand.Value,(Fields!UpperBBand.Value+Fields!LowerBBand.Value)/2)&gt;4,"Red",
Code.CalculatePriceLevel(Fields!DayClose.Value,Fields!UpperBBand.Value,Fields!LowerBBand.Value,(Fields!UpperBBand.Value+Fields!LowerBBand.Value)/2)&gt;0,"Blue",
Code.CalculatePriceLevel(Fields!DayClose.Value,Fields!UpperBBand.Value,Fields!LowerBBand.Value,(Fields!UpperBBand.Value+Fields!LowerBBand.Value)/2)&lt;0,"Green",
0=0,"DarkBlue")</Color>
                                  </Style>
