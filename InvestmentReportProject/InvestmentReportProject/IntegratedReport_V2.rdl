    <DataSet Name="IndustryList">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@countryCode">
            <Value>=Parameters!countryCode.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT DISTINCT Industry
FROM   Company AS A
WHERE (CountryCode LIKE '%' + @countryCode + '%') AND (Status = 1)
UNION
SELECT '' AS Industry
FROM   Company AS B</CommandText>
      </Query>
      <Fields>
        <Field Name="Industry">
          <DataField>Industry</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="CountryCodeList">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <CommandText>SELECT DISTINCT CountryCode
FROM   Company</CommandText>
      </Query>
      <Fields>
        <Field Name="CountryCode">
          <DataField>CountryCode</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="PriceDateList">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <CommandText>SELECT DISTINCT PriceDate
FROM   temp_company_sdd
WHERE (PriceDate &gt; GETDATE() - 90)
ORDER BY PriceDate desc</CommandText>
      </Query>
      <Fields>
        <Field Name="PriceDate">
          <DataField>PriceDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
