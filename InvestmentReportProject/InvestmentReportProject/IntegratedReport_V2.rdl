                                    <Format>0.0</Format>
                                    <Color>=Switch(Fields!DayClose.Value&gt;Fields!DayOpen.Value,"Red",
Fields!DayClose.Value&lt;Fields!DayOpen.Value,"Green",
Fields!DayClose.Value=Fields!DayOpen.Value,"Black")</Color>
