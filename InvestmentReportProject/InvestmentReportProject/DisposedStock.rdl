                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=((Fields!ForeignInvest.Value + Fields!InvestTrust.Value + Fields!Dealer.Value) / Fields!Capital.Value)</Value>
                                  <Style>
                                    <FontFamily>Tahoma</FontFamily>
                                    <FontSize>12pt</FontSize>
                                    <Format>0.0%</Format>
                                    <Color>=IIF(Fields!ForeignInvest.Value+Fields!InvestTrust.Value++Fields!Dealer.Value&gt;0,"Red","Green")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>Textbox66</rd:DefaultName>
                          <Style>
                            <Border>
                              <Color>LightGrey</Color>
                              <Style>Solid</Style>
