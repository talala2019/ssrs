<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource_localhost">
      <DataSourceReference>DataSource_localhost</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>a113d449-e1ae-4bf6-9995-6fe88267b75c</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <CommandText>select A.*, B.CompanyID, B.ChtName, B.Sector, B.Industry, B.Capital, C.IndustryNames,
Spi.PriceDate,
Spi.DayClose,
Spi.Close_Chg1,
Spi.UpperBBand,
Spi.LowerBBand,
instilinvest.ForeignInvest,
instilinvest.ForeignInvest_MA6,
instilinvest.ForeignInvest_MA12,
instilinvest.ForeignInvest_MA20,
instilinvest.ForeignInvest_MA60,
instilinvest.InvestTrust,
instilinvest.InvestTrust_MA6,
instilinvest.InvestTrust_MA12,
instilinvest.InvestTrust_MA20,
instilinvest.InvestTrust_MA60,
instilinvest.Dealer,
instilinvest.Dealer_MA6,
instilinvest.Dealer_MA12,
instilinvest.Dealer_MA20,
instilinvest.Dealer_MA60,
CASE 
        WHEN DisposeEndDate &lt; CAST(GETDATE() AS DATE) THEN 0
        ELSE
            DATEDIFF(DAY, CAST(GETDATE() AS DATE), DisposeEndDate)
            - (DATEDIFF(WEEK, CAST(GETDATE() AS DATE), DisposeEndDate) * 2)
            - CASE WHEN DATENAME(WEEKDAY, CAST(GETDATE() AS DATE)) = 'Sunday' THEN 1 ELSE 0 END
            - CASE WHEN DATENAME(WEEKDAY, DisposeEndDate) = 'Saturday' THEN 1 ELSE 0 END
    END AS BusinessDaysLeft
from DisposedStock as A
inner join Company as B on A.StockNo=Left(B.Symbol,4)
inner join temp_company_spi as Spi on B.CompanyID=Spi.CompanyID and Spi.PriceDate=(select top 1 PriceDate from temp_company_spi where CompanyID=282 order by PriceDate desc)
left join CompanyDetailedIndustry as C on B.CompanyID=C.CompanyID
left join temp_company_instilinvest as instilinvest on B.CompanyID=instilinvest.CID and instilinvest.DataDate=Spi.PriceDate
where B.Status=1 and B.CountryCode='TW'
and A.DisposeEndDate&gt;getdate()-1
order by DisposeEndDate</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
