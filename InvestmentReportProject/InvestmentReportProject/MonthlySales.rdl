<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource_localhost">
      <DataSourceReference>DataSource_localhost</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>56cd27f5-46d2-4105-a744-8706f1cbd54f</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="MonthlySalesData">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@symbol">
            <Value>=Parameters!symbol.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@startYear">
            <Value>=Parameters!StartYear.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>
DECLARE @CID INT
SELECT TOP 1 @CID = CompanyID FROM Company
WHERE LEFT(Symbol, 4) = LEFT(LTRIM(RTRIM(@symbol)), 4)

DECLARE @ChtName NVARCHAR(200)
SELECT @ChtName = ChtName FROM Company WHERE CompanyID = @CID

DECLARE @LatestYear INT
SELECT TOP 1 @LatestYear = Year FROM MonthlySales WHERE CompanyId = @CID ORDER BY Year DESC

DECLARE @MonthCount INT
SELECT @MonthCount =
    (CASE WHEN ISNULL(Jan,0) &gt; 0 THEN 1 ELSE 0 END +
     CASE WHEN ISNULL(Feb,0) &gt; 0 THEN 1 ELSE 0 END +
     CASE WHEN ISNULL(Mar,0) &gt; 0 THEN 1 ELSE 0 END +
     CASE WHEN ISNULL(April,0) &gt; 0 THEN 1 ELSE 0 END +
     CASE WHEN ISNULL(May,0) &gt; 0 THEN 1 ELSE 0 END +
     CASE WHEN ISNULL(June,0) &gt; 0 THEN 1 ELSE 0 END +
     CASE WHEN ISNULL(July,0) &gt; 0 THEN 1 ELSE 0 END +
     CASE WHEN ISNULL(Aug,0) &gt; 0 THEN 1 ELSE 0 END +
     CASE WHEN ISNULL(Sep,0) &gt; 0 THEN 1 ELSE 0 END +
     CASE WHEN ISNULL(Oct,0) &gt; 0 THEN 1 ELSE 0 END +
     CASE WHEN ISNULL(Nov,0) &gt; 0 THEN 1 ELSE 0 END +
     CASE WHEN ISNULL(Dec,0) &gt; 0 THEN 1 ELSE 0 END)
FROM MonthlySales
WHERE CompanyId = @CID AND Year = @LatestYear

;WITH Base AS (
    SELECT
        ms.Year,
        ISNULL(ms.Jan,0)/1000.0 AS Jan,
        ISNULL(ms.Feb,0)/1000.0 AS Feb,
        ISNULL(ms.Mar,0)/1000.0 AS Mar,
        ISNULL(ms.April,0)/1000.0 AS April,
        ISNULL(ms.May,0)/1000.0 AS May,
        ISNULL(ms.June,0)/1000.0 AS June,
        ISNULL(ms.July,0)/1000.0 AS July,
        ISNULL(ms.Aug,0)/1000.0 AS Aug,
        ISNULL(ms.Sep,0)/1000.0 AS Sep,
        ISNULL(ms.Oct,0)/1000.0 AS Oct,
        ISNULL(ms.Nov,0)/1000.0 AS Nov,
        ISNULL(ms.Dec,0)/1000.0 AS Dec,
        ISNULL(ms.TotalSales,0)/1000.0 AS TotalSales,
        (CASE WHEN @MonthCount &gt;= 1 THEN ISNULL(ms.Jan,0) ELSE 0 END +
         CASE WHEN @MonthCount &gt;= 2 THEN ISNULL(ms.Feb,0) ELSE 0 END +
         CASE WHEN @MonthCount &gt;= 3 THEN ISNULL(ms.Mar,0) ELSE 0 END +
         CASE WHEN @MonthCount &gt;= 4 THEN ISNULL(ms.April,0) ELSE 0 END +
         CASE WHEN @MonthCount &gt;= 5 THEN ISNULL(ms.May,0) ELSE 0 END +
         CASE WHEN @MonthCount &gt;= 6 THEN ISNULL(ms.June,0) ELSE 0 END +
         CASE WHEN @MonthCount &gt;= 7 THEN ISNULL(ms.July,0) ELSE 0 END +
         CASE WHEN @MonthCount &gt;= 8 THEN ISNULL(ms.Aug,0) ELSE 0 END +
         CASE WHEN @MonthCount &gt;= 9 THEN ISNULL(ms.Sep,0) ELSE 0 END +
         CASE WHEN @MonthCount &gt;= 10 THEN ISNULL(ms.Oct,0) ELSE 0 END +
         CASE WHEN @MonthCount &gt;= 11 THEN ISNULL(ms.Nov,0) ELSE 0 END +
         CASE WHEN @MonthCount &gt;= 12 THEN ISNULL(ms.Dec,0) ELSE 0 END
        ) / 1000.0 AS SamePeriodYTD,
        CASE WHEN ms.Year = @LatestYear THEN 1 ELSE 0 END AS IsCurrentYear
    FROM MonthlySales ms
    WHERE ms.CompanyId = @CID
),
WithLag AS (
    SELECT
        b.*,
        LAG(b.Jan)   OVER (ORDER BY b.Year) AS PrevJan,
        LAG(b.Feb)   OVER (ORDER BY b.Year) AS PrevFeb,
        LAG(b.Mar)   OVER (ORDER BY b.Year) AS PrevMar,
        LAG(b.April) OVER (ORDER BY b.Year) AS PrevApril,
        LAG(b.May)   OVER (ORDER BY b.Year) AS PrevMay,
        LAG(b.June)  OVER (ORDER BY b.Year) AS PrevJune,
        LAG(b.July)  OVER (ORDER BY b.Year) AS PrevJuly,
        LAG(b.Aug)   OVER (ORDER BY b.Year) AS PrevAug,
        LAG(b.Sep)   OVER (ORDER BY b.Year) AS PrevSep,
        LAG(b.Oct)   OVER (ORDER BY b.Year) AS PrevOct,
        LAG(b.Nov)   OVER (ORDER BY b.Year) AS PrevNov,
        LAG(b.Dec)   OVER (ORDER BY b.Year) AS PrevDec,
        LAG(b.TotalSales)    OVER (ORDER BY b.Year) AS PrevTotalSales,
        LAG(b.SamePeriodYTD) OVER (ORDER BY b.Year) AS PrevSamePeriodYTD
    FROM Base b
)
SELECT
    @ChtName AS ChtName,
    w.Year,
    w.Jan, w.Feb, w.Mar, w.April, w.May, w.June,
    w.July, w.Aug, w.Sep, w.Oct, w.Nov, w.Dec,
    w.TotalSales,
    w.IsCurrentYear,
    ISNULL(w.PrevJan,0)   AS PrevJan,   ISNULL(w.PrevFeb,0)   AS PrevFeb,
    ISNULL(w.PrevMar,0)   AS PrevMar,   ISNULL(w.PrevApril,0) AS PrevApril,
    ISNULL(w.PrevMay,0)   AS PrevMay,   ISNULL(w.PrevJune,0)  AS PrevJune,
    ISNULL(w.PrevJuly,0)  AS PrevJuly,  ISNULL(w.PrevAug,0)   AS PrevAug,
    ISNULL(w.PrevSep,0)   AS PrevSep,   ISNULL(w.PrevOct,0)   AS PrevOct,
    ISNULL(w.PrevNov,0)   AS PrevNov,   ISNULL(w.PrevDec,0)   AS PrevDec,
    CASE WHEN ISNULL(w.PrevTotalSales,0) &gt; 0
         THEN CAST(w.TotalSales / w.PrevTotalSales AS DECIMAL(10,3))
         ELSE NULL END AS YoY,
    CASE WHEN ISNULL(w.PrevSamePeriodYTD,0) &gt; 0 AND w.IsCurrentYear = 1
         THEN CAST(w.SamePeriodYTD / w.PrevSamePeriodYTD AS DECIMAL(10,3))
         ELSE NULL END AS MoM,
    CASE WHEN ISNULL(w.PrevSamePeriodYTD,0) &gt; 0 AND ISNULL(w.PrevTotalSales,0) &gt; 0 AND w.IsCurrentYear = 1
         THEN CAST(w.SamePeriodYTD / w.PrevSamePeriodYTD * w.PrevTotalSales AS BIGINT)
         ELSE 0 END AS EstSales
FROM WithLag w
WHERE w.Year >= @startYear
ORDER BY w.Year
        </CommandText>
      </Query>
      <Fields>
        <Field Name="ChtName"><DataField>ChtName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Year"><DataField>Year</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="Jan"><DataField>Jan</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="Feb"><DataField>Feb</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="Mar"><DataField>Mar</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="April"><DataField>April</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="May"><DataField>May</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="June"><DataField>June</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="July"><DataField>July</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="Aug"><DataField>Aug</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="Sep"><DataField>Sep</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="Oct"><DataField>Oct</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="Nov"><DataField>Nov</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="Dec"><DataField>Dec</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="TotalSales"><DataField>TotalSales</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="IsCurrentYear"><DataField>IsCurrentYear</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="PrevJan"><DataField>PrevJan</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="PrevFeb"><DataField>PrevFeb</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="PrevMar"><DataField>PrevMar</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="PrevApril"><DataField>PrevApril</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="PrevMay"><DataField>PrevMay</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="PrevJune"><DataField>PrevJune</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="PrevJuly"><DataField>PrevJuly</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="PrevAug"><DataField>PrevAug</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="PrevSep"><DataField>PrevSep</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="PrevOct"><DataField>PrevOct</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="PrevNov"><DataField>PrevNov</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="PrevDec"><DataField>PrevDec</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="YoY"><DataField>YoY</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="MoM"><DataField>MoM</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="EstSales"><DataField>EstSales</DataField><rd:TypeName>System.Int64</rd:TypeName></Field>
      </Fields>
    </DataSet>
    <DataSet Name="MonthlyTrendData">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@symbol">
            <Value>=Parameters!symbol.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@startYear">
            <Value>=Parameters!StartYear.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>
DECLARE @CID INT
SELECT TOP 1 @CID = CompanyID FROM Company
WHERE LEFT(Symbol, 4) = LEFT(LTRIM(RTRIM(@symbol)), 4)

SELECT ms.Year, v.MonthNum, v.MonthName, v.Amount
FROM MonthlySales ms
CROSS APPLY (VALUES
    (1,  'Jan', ISNULL(ms.Jan,0)/1000.0),
    (2,  'Feb', ISNULL(ms.Feb,0)/1000.0),
    (3,  'Mar', ISNULL(ms.Mar,0)/1000.0),
    (4,  'Apr', ISNULL(ms.April,0)/1000.0),
    (5,  'May', ISNULL(ms.May,0)/1000.0),
    (6,  'Jun', ISNULL(ms.June,0)/1000.0),
    (7,  'Jul', ISNULL(ms.July,0)/1000.0),
    (8,  'Aug', ISNULL(ms.Aug,0)/1000.0),
    (9,  'Sep', ISNULL(ms.Sep,0)/1000.0),
    (10, 'Oct', ISNULL(ms.Oct,0)/1000.0),
    (11, 'Nov', ISNULL(ms.Nov,0)/1000.0),
    (12, 'Dec', ISNULL(ms.Dec,0)/1000.0)
) AS v(MonthNum, MonthName, Amount)
WHERE ms.CompanyId = @CID AND ms.Year &gt;= @startYear AND v.Amount &gt; 0
ORDER BY ms.Year, v.MonthNum
        </CommandText>
      </Query>
      <Fields>
        <Field Name="Year"><DataField>Year</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="MonthNum"><DataField>MonthNum</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="MonthName"><DataField>MonthName</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="Amount"><DataField>Amount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="symbol">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value>2317</Value>
        </Values>
      </DefaultValue>
      <Prompt>Symbol</Prompt>
    </ReportParameter>
    <ReportParameter Name="StartYear">
      <DataType>Integer</DataType>
      <DefaultValue>
        <Values>
          <Value>=Year(Today()) - 6</Value>
        </Values>
      </DefaultValue>
      <Prompt>起始年份</Prompt>
    </ReportParameter>
  </ReportParameters>
  <ReportSections>
