  <Code>
Public Function MonthDisplay(val As Decimal) As String
    If val = 0 Then
        Return ""
    Else
        Return Format(val, "#,0")
    End If
End Function

Public Function MonthColor(currentVal As Decimal, prevVal As Decimal) As String
    If currentVal &gt; 0 And prevVal &gt; 0 And currentVal &lt; prevVal Then
        Return "Red"
    Else
        Return "Black"
    End If
End Function

Public Function RowBg(isCurrentYear As Integer) As String
    If isCurrentYear = 1 Then
        Return "#D6EAF8"
    Else
        Return "White"
    End If
End Function

Public Function YoYBg(yoy As Object) As String
    If IsNothing(yoy) Then
        Return "White"
    ElseIf CDec(yoy) &gt;= 1.0D Then
        Return "#FFFACD"
    Else
        Return "White"
    End If
End Function
  </Code>
