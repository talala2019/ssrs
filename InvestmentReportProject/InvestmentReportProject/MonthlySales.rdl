                  <TextRun>
                    <Value>="月營收報表 - " &amp; Parameters!symbol.Value &amp; "  " &amp; First(Fields!ChtName.Value, "MonthlySalesData")</Value>
                    <Style>
                      <FontFamily>Segoe UI Light</FontFamily>
                      <FontSize>20pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                    </Style>
