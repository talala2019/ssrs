                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Format(Fields!TWII_ChgRatio.Value,"#,#.00")+"       "</Value>
                                  <Style>
                                    <FontFamily />
                                    <Color>=IIf(Fields!TWII_ChgRatio.Value&gt;0,"Red","Green")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
