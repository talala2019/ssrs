Fields!Future_TradeCount.Value&gt;5000,"Yellow",
Fields!Future_TradeCount.Value&gt;2500,"Pink",
Fields!Future_TradeCount.Value&lt;-5000,"LightBlue",
Fields!Future_TradeCount.Value&lt;-2500,"LightGreen",
0=0,"White")</BackgroundColor>
