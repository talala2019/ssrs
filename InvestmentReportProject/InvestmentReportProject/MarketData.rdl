                                    <FontWeight>=IIf(Weekday(Fields!PriceDate.Value)=4 and Day(Fields!PriceDate.Value)&gt;=15 and Day(Fields!PriceDate.Value)&lt;=21, "Bold","Default" )</FontWeight>
                                    <Format>0</Format>
                                    <TextDecoration>=IIf(Weekday(Fields!PriceDate.Value)=4 and Day(Fields!PriceDate.Value)&gt;=15 and Day(Fields!PriceDate.Value)&lt;=21, "Underline","None" )</TextDecoration>
                                    <Color>=Switch(Fields!Future_TradeCount.Value&gt;0,"Red",
Fields!Future_TradeCount.Value&lt;0,"Green",
0=0,"Black")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
