<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource_localhost">
      <DataSourceReference>DataSource_localhost</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>f817a45b-8a74-4096-9ecc-3a0b2010aaa3</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <CommandText>select A.PriceDate, A.TWII_Close, A.TWII_Chg, A.TWII_ChgRatio,
SDD6.DayOpen as 'TX_Open',
SDD6.DayHigh as 'TX_High',
SDD6.DayLow as 'TX_Low',
SDD6.DayClose as 'TX_Close',
SDD6.DayHigh-SDD6.DayLow as 'TX_Volatility',

SDD.DayClose,
temp_sdd.MA20, temp_sdd.MA60, temp_sdd.MA20_Slope,
SPI.Close_Chg1,SDD.Volume, SPI.Day1_Vol, SPI.Days_CloseOnMa5, SPI.MA5_Status, 
SPI.MA20_Status, SPI.MA60_Status,
SPI.Day0_Dif, SPI.Day0_Macd,SPI.Day0_Bar,SPI.Day0_Bar_Status,
SPI.Day1_Dif, SPI.Day1_Macd,
A.LongCount, A.ShortCount,
B.ForeignInvest, 
B.InvestTrust,
B.Dealer,
B.BuySellTotal,
institu_invest_dealer_total.Volume as 'institu_invest_dealer_bs_total',
foreign_invest_total.Volume as 'foreign_investor_bs_total',
Future.Total_TradeCount as 'Future_TradeCount',
Future.Total_UnCloseCount as 'Future_UnCloseCount',
Future.Total_UnCloseAmount as 'Future_UnCloseAmount',
ForeignFuture.Foreign_UnCloseCount as 'Foreign_UnCloseCount',
Opt.Total_TradeCount as 'Opt_TradeCount',
Opt.Total_UnCloseCount as 'Opt_UnCloseCount',
SDD2.DayClose as 'TWD=X_Close',
SDD2J.DayClose as 'JPYTWD=X',
SDD3.DayClose as '0050',
SPI3.Close_Chg1 as '0050_Close_Chg1',
SPI3.Day0_K as '0050_9K',
SPI3.Day0_D as '0050_9D',
SPI3.Day1_D as '0050_9D_Pre',
SDD4.DayClose as '00632R',
SDD5.DayClose as 'CADTWD=X',
SDD5C.DayClose as 'CAD=X',
MT.Margin_Amt,

sox_spi.Days_CloseOnMa5 as 'SOX_Days_CloseOnMa5',
sox_spi.Days_CloseOnMa20 as 'SOX_Days_CloseOnMa20',

ixic_spi.Days_CloseOnMa5 as 'IXIC_Days_CloseOnMa5',
ixic_spi.Days_CloseOnMa20 as 'IXIC_Days_CloseOnMa20',

vix_sdd.DayClose as 'VIX_DayClose',
sp500_vix_sdd.DayClose as 'SP500_VIX_DayClose',

tlt_spi.DayClose as 'TLT_DayClose',
tlt_spi.Close_Chg1 as  'TLT_CloseChg',
iei_spi.DayClose as 'IEI_DayClose',
iei_spi.Close_Chg1 as 'IEI_CloseChg',

etf_679b_spi.DayClose as 'ETF_679B_DayClose',
etf_679b_spi.Close_Chg1 as 'ETF_679B_CloseChg',
etf_687b_spi.DayClose as 'ETF_687B_DayClose',
etf_687b_spi.Close_Chg1 as 'ETF_687B_CloseChg'

from TWII_BigData as A 
inner join StockDailyData as SDD on A.PriceDate=SDD.PriceDate and SDD.CompanyID=1490
inner join StockPriceIndicator as SPI on A.PriceDate=SPI.PriceDate and SPI.CompanyID=1490
left join TWII_BuySellData as B on A.PriceDate=B.PriceDate

--匯率
left join StockDailyData as SDD2 on A.PriceDate=SDD2.PriceDate and SDD2.CompanyID=3099
left join StockDailyData as SDD2J on A.PriceDate=SDD2J.PriceDate and SDD2J.CompanyID=3102
left join StockDailyData as SDD3 on A.PriceDate=SDD3.PriceDate and SDD3.CompanyID=1747
left join StockDailyData as SDD4 on A.PriceDate=SDD4.PriceDate and SDD4.CompanyID=1974
left join StockDailyData as SDD5 on A.PriceDate=SDD5.PriceDate and SDD5.CompanyID=3098
left join StockDailyData as SDD5C on A.PriceDate=SDD5C.PriceDate and SDD5C.CompanyID=1995

--台指期
left join StockDailyData as SDD6 on A.PriceDate=SDD6.PriceDate and SDD6.CompanyID=4779

--VIX 
left join StockDailyData as vix_sdd on A.PriceDate=vix_sdd.PriceDate and vix_sdd.CompanyID=4797
left join StockDailyData as sp500_vix_sdd on A.PriceDate=sp500_vix_sdd.PriceDate and sp500_vix_sdd.CompanyID=4795

--三大法人買賣超
left join StockDailyData as institu_invest_dealer_total on A.PriceDate=institu_invest_dealer_total.PriceDate and institu_invest_dealer_total.CompanyID=4794

-- 外資買賣超
left join StockDailyData as foreign_invest_total on A.PriceDate=foreign_invest_total.PriceDate and foreign_invest_total.CompanyID=4800

--加權指數
left join temp_company_sdd as temp_sdd on A.PriceDate=temp_sdd.PriceDate and temp_sdd.CID=1490

--費半
left join StockPriceIndicator as sox_spi on A.PriceDate=sox_spi.PriceDate and sox_spi.CompanyID=3541
--那指 
left join StockPriceIndicator as ixic_spi on A.PriceDate=ixic_spi.PriceDate and ixic_spi.CompanyID=1651

--0050
left join StockPriceIndicator as SPI3 on A.PriceDate=SPI3.PriceDate and SPI3.CompanyID=1747

--TLT 美債20+年ETF 
left join StockPriceIndicator as tlt_spi on A.PriceDate=tlt_spi.PriceDate and tlt_spi.CompanyID=4802

--TLT 美債3-7年ETF
left join StockPriceIndicator as iei_spi on A.PriceDate=iei_spi.PriceDate and iei_spi.CompanyID=4803

--00679B ETF
left join StockPriceIndicator as etf_679b_spi on A.PriceDate=etf_679b_spi.PriceDate and etf_679b_spi.CompanyID=4804

--00687B ETF
left join StockPriceIndicator as etf_687b_spi on A.PriceDate=etf_687b_spi.PriceDate and etf_687b_spi.CompanyID=4805

left join (select PriceDate, Commodity, SUM(TradeCount) as 'Total_TradeCount', SUM(TradeAmount) as 'Total_TradeAmount', Sum(UnCloseCount) as 'Total_UnCloseCount', Sum(UnCloseAmount) as 'Total_UnCloseAmount' from TW_Commodity
group by PriceDate, Commodity
having Commodity=N'臺股期貨') as Future on A.PriceDate=Future.PriceDate

left join (select PriceDate, Commodity, UnCloseCount as 'Foreign_UnCloseCount' from TW_Commodity where Commodity=N'臺股期貨' and Type=N'外資及陸資') 
as ForeignFuture on A.PriceDate=ForeignFuture.PriceDate

left join (select PriceDate, Commodity, SUM(TradeCount) as 'Total_TradeCount', SUM(TradeAmount) as 'Total_TradeAmount', Sum(UnCloseCount) as 'Total_UnCloseCount', Sum(UnCloseAmount) as 'Total_UnCloseAmount' from TW_Commodity
group by PriceDate, Commodity
having Commodity=N'臺指選擇權') as Opt on A.PriceDate=Opt.PriceDate
left join(
	select Margin.DataDate, CONVERT(DECIMAL(10, 2),SUM( ((Margin.MarginRmng-Margin.PreMarginRmng)*((DayHigh+DayLow)/2)/100000 ))*0.6) as 'Margin_Amt' from MarginTrading as Margin 
	inner join StockDailyData as SDD on Margin.CID=SDD.CompanyID and Margin.DataDate=SDD.PriceDate
	Group by Margin.DataDate
) as MT on MT.DataDate=SDD.PriceDate
where (A.LongCount+A.ShortCount&lt;&gt;0)
order by A.PriceDate desc</CommandText>
      </Query>
