                              <Style>Solid</Style>
                            </BottomBorder>
                            <BackgroundColor>=Switch(Fields!TWII_ChgRatio.Value&gt;=0.9,"Pink",
Fields!TWII_ChgRatio.Value&lt;=-0.9,"LightGreen",
0=0,"White")</BackgroundColor>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Textbox13">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=(Fields!LongCount.Value/(Fields!LongCount.Value+Fields!ShortCount.Value))*100</Value>
                                  <Style>
                                    <FontFamily />
                                    <FontWeight>Bold</FontWeight>
                                    <Format>0.0</Format>
                                    <Color>DarkBlue</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Center</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>Textbox13</rd:DefaultName>
                          <Style>
                            <Border>
                              <Color>LightGrey</Color>
                            </Border>
                            <BottomBorder>
                              <Style>Solid</Style>
                            </BottomBorder>
                            <BackgroundColor>=Switch(
Fields!LongCount.Value/(Fields!LongCount.Value+Fields!ShortCount.Value)&lt;0.2,"LightBlue",
Fields!LongCount.Value/(Fields!LongCount.Value+Fields!ShortCount.Value)&lt;0.3,"LightGreen",
((Fields!LongCount.Value/(Fields!LongCount.Value+Fields!ShortCount.Value)&gt;0.5) 
and (Fields!LongCount.Value/(Fields!LongCount.Value+Fields!ShortCount.Value)&lt;0.6) ),"LightGray",
Fields!LongCount.Value/(Fields!LongCount.Value+Fields!ShortCount.Value)&gt;0.78,"Yellow",
Fields!LongCount.Value/(Fields!LongCount.Value+Fields!ShortCount.Value)&gt;0.70,"LightPink",
0=0,"White")</BackgroundColor>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
