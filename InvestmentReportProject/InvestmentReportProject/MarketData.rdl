                                    <FontWeight>=IIf(Weekday(Fields!PriceDate.Value)=4 and Day(Fields!PriceDate.Value)&gt;=15 and Day(Fields!PriceDate.Value)&lt;=21, "Bold","Default" )</FontWeight>
                                    <Format>0</Format>
                                    <TextDecoration>=IIf(Weekday(Fields!PriceDate.Value)=4 and Day(Fields!PriceDate.Value)&gt;=15 and Day(Fields!PriceDate.Value)&lt;=21, "LineThrough","None" )</TextDecoration>
