<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource_localhost">
      <DataSourceReference>DataSource_localhost</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>76e7e2c0-0340-4172-9470-9bdf53aa3787</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@MarketType">
            <Value>=Parameters!MarketType.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@StartDate">
            <Value>=Parameters!StartDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@EndDate">
            <Value>=Parameters!EndDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Yesterday">
            <Value>=Parameters!Yesterday.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Today">
            <Value>=Parameters!Today.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select A.Industry, A.PriceDate as 'StartDate', A.StartDate_MarketValue, B.PriceDate as 'EndDate', B.EndDate_MarketValue,
Yesterday.PriceDate as 'Yesterday', Yesterday.Yesterday_MarketValue, Today.PriceDate as 'Today', Today.Today_MarketValue,
EndDate_MarketValue/StartDate_MarketValue as 'Period_Change'
from (
		select PriceDate, Industry, Sum((Com.Capital/10000)*SDD.DayClose) as 'StartDate_MarketValue' from Company as Com 
		inner join StockDailyData as SDD on Com.CompanyID=SDD.CompanyID
		where Status=1 and (symbol like '%'+@MarketType or symbol='^TWII') and SDD.PriceDate=@StartDate and Com.CompanyID in ( select CompanyID from StockDailyData where PriceDate=@EndDate )
		group by PriceDate, Industry
		) as A 
		inner join 
		(	select PriceDate, Industry, Sum((Com.Capital/10000)*SDD.DayClose) as 'EndDate_MarketValue' from Company as Com 
		inner join StockDailyData as SDD on Com.CompanyID=SDD.CompanyID
		where Status=1 and (symbol like '%'+@MarketType or symbol='^TWII') and SDD.PriceDate=@EndDate and Com.CompanyID in ( select CompanyID from StockDailyData where PriceDate=@StartDate )
		group by PriceDate, Industry
		) as B on A.Industry=B.Industry
		inner join 
		(
		select PriceDate, Industry, Sum((Com.Capital/10000)*SDD.DayClose) as 'Yesterday_MarketValue' from Company as Com 
		inner join StockDailyData as SDD on Com.CompanyID=SDD.CompanyID
		where Status=1 and (symbol like '%'+@MarketType or symbol='^TWII') and SDD.PriceDate=@Yesterday and Com.CompanyID in ( select CompanyID from StockDailyData where PriceDate=@Today )
		group by PriceDate, Industry
		) as Yesterday on B.Industry=Yesterday.Industry
		inner join 
		(
		select PriceDate, Industry, Sum((Com.Capital/10000)*SDD.DayClose) as 'Today_MarketValue' from Company as Com 
		inner join StockDailyData as SDD on Com.CompanyID=SDD.CompanyID
		where Status=1 and (symbol like '%'+@MarketType or symbol='^TWII') and SDD.PriceDate=@Today and Com.CompanyID in ( select CompanyID from StockDailyData where PriceDate=@Yesterday )
		group by PriceDate, Industry
		) as Today on Yesterday.Industry=Today.Industry
order by Period_Change desc</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="Industry">
          <DataField>Industry</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="StartDate">
          <DataField>StartDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="StartDate_MarketValue">
          <DataField>StartDate_MarketValue</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="EndDate">
          <DataField>EndDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="EndDate_MarketValue">
          <DataField>EndDate_MarketValue</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Yesterday">
          <DataField>Yesterday</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Yesterday_MarketValue">
          <DataField>Yesterday_MarketValue</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Today">
          <DataField>Today</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
        <Field Name="Today_MarketValue">
          <DataField>Today_MarketValue</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Period_Change">
          <DataField>Period_Change</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="StartDate">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <CommandText>select top 1 PriceDate as 'StartDate' from temp_company_sdd where 
pricedate in (
SELECT top 10 PriceDate
FROM   temp_company_sdd
WHERE CID=282
) and CID=282 ORDER BY PriceDate</CommandText>
      </Query>
      <Fields>
        <Field Name="StartDate">
          <DataField>StartDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="EndDate">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <CommandText>select top 1 PriceDate as 'EndDate' from temp_company_sdd where 
CID=282 ORDER BY PriceDate desc  </CommandText>
      </Query>
      <Fields>
        <Field Name="EndDate">
          <DataField>EndDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="Yesterday">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <CommandText>select top 1 PriceDate as 'Yesterday' from temp_company_sdd where 
pricedate in (
SELECT top 2 PriceDate
FROM   temp_company_sdd
WHERE CID=282
) and CID=282 ORDER BY PriceDate</CommandText>
      </Query>
      <Fields>
        <Field Name="Yesterday">
          <DataField>Yesterday</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
