<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource_localhost">
      <DataSourceReference>DataSource_localhost</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>cdd8b137-c843-42c2-bb45-8620437d415d</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@industry">
            <Value>=Parameters!industry.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@pricedate">
            <Value>=Parameters!pricedate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@volume">
            <Value>=Parameters!volume.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@ma60_status">
            <Value>=Parameters!ma60_status.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT 
ROW_NUMBER() over (order by SPI.Days_Ma5OnMa20 desc, Com.Symbol ) as Row_No,
Com.CompanyID, Com.Industry, Com.Symbol, Com.ChtName, Com.CountryCode,
CS.Status, 
TT.TrendTrackingSignal,
SWD.WeekTrend, SWD.WeekMACDStatus, SWD.WeekDMI, SWD.WeekADX14, SWD.WeekMA60, SWD.WeekMA60_Div_Pct,
CONVERT(DECIMAL(10, 2), SDD.Vol_MA3 / SDD.Vol_MA15) AS 'Vol_3_15',
SDD.PriceDate,
SDD.Volume,
SDD.DayClose,
SDD.MA5,SDD.MA20,SDD.MA42, 
SDD.Vol_MA3,SDD.Vol_MA15,
SPI.Close_Chg1,
SPI.Close_Chg3,
SPI.Close_Chg12,
SPI.Close_Chg60,
SPI.Day0_Bar,
SPI.Day0_Bar_Status,
SPI.MA5_Status,
SPI.Days_CloseOnMa5,
SPI.Days_Ma5OnMa20,
SPI.MA20_Status,
SPI.MA42_Status,
SPI.MA60_Status,
SPI.Day0_Dif, 
SPI.Day0_Macd,
SPI.Day0_K, SPI.Day0_D,
SPI.Day0_W9,
SPI.Day0_W55,
SPI.VolAvg3_Status,
SPI.Days_VolMa3OnMa15,
PE.pe_ratio, PE.pb_ratio, PE.yield,
CONVERT(DECIMAL(10,2),((INS.ForeignInvest+INS.InvestTrust)/Com.Capital)*100) as 'FIRatio1',
CONVERT(DECIMAL(10,2),((INS.ForeignInvest_MA3+INS.InvestTrust_MA3)/Com.Capital)*100) as 'FIRatio3',
CONVERT(DECIMAL(10,2),((INS.ForeignInvest_MA12+INS.InvestTrust_MA12)/Com.Capital)*100) as 'FIRatio12',
CONVERT(DECIMAL(10,2),((INS.ForeignInvest_MA60+INS.InvestTrust_MA60)/Com.Capital)*100) as 'FIRatio60',
INS.ForeignInvestCost,
INS.ForeignInvestCostStartDate,
INS.InvestTrustCost,
INS.InvestTrustCostStartDate,
MSales.salesYoY
FROM Company AS Com 
INNER JOIN temp_company_sdd AS SDD ON Com.CompanyID = SDD.CID
INNER JOIN temp_company_spi AS SPI ON SDD.CID = SPI.CompanyID AND SDD.PriceDate = SPI.PriceDate 
LEFT JOIN CompanyStatus as CS on SDD.CID=CS.CompanyID AND SDD.PriceDate=CS.PriceDate
LEFT JOIN temp_company_instilinvest as INS on SDD.CID=INS.CID AND SDD.PriceDate=INS.DataDate
LEFT JOIN temp_company_swd AS SWD ON SDD.CID = SWD.CompanyID AND SDD.PriceDate = SWD.EndDate
LEFT JOIN Trend_Tracking AS TT on SDD.CID=TT.CID and SDD.PriceDate=TT.PriceDate
LEFT JOIN temp_company_pe AS PE ON ltrim(rtrim(substring(Com.Symbol,0,5))) = ltrim(rtrim(PE.symbol))
LEFT JOIN temp_company_msalesYoY AS MSales on Com.CompanyID=MSales.cid
WHERE
Com.Status=1 
AND Com.CountryCode='TW'
AND (Com.industry like '%'+@industry+'%')	-- Industry
AND (SDD.PriceDate = @pricedate) 
AND (SDD.Volume*SDD.DayClose &gt;= @volume) 

-- 偏空趨勢
AND 
(
(SDD.DayClose&lt;SDD.MA5 OR SDD.DayClose&lt;SDD.MA20) AND (SPI.MA20_Status = N'向下' OR SPI.MA20_Status = N'轉下' )
)

AND (SPI.MA60_Status like N'%' + @ma60_status +'%' )

-- Signal
--AND (TT.TrendTrackingSignal LIKE '%'+@ttsignal+'%') 
Order by SPI.Day0_W55 desc</CommandText>
      </Query>
