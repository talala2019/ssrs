                    <TablixCell>
                      <CellContents>
                        <Textbox Name="BreakTh_High3">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Switch(
Fields!BreakTh_High.Value = "Yes", "今過壓", 
Fields!Above_High.Value = "Yes", "過壓", 
Fields!FallBelow_Low.Value = "Yes", "今破撐",
Fields!Below_Low.Value = "Yes", "破撐",
0 = 0, "")</Value>
                                  <Style>
                                    <FontFamily>Tahoma</FontFamily>
                                    <FontSize>9pt</FontSize>
                                    <Color>=Switch(
Fields!BreakTh_High.Value = "Yes", "Red", 
Fields!Above_High.Value = "Yes", "Red", 
Fields!FallBelow_Low.Value = "Yes", "Green",
Fields!Below_Low.Value = "Yes", "Green",
0 = 0, "DarkBlue")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Center</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>BreakTh_High</rd:DefaultName>
                          <Style>
                            <Border>
                              <Color>LightGrey</Color>
                              <Style>Solid</Style>
                            </Border>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="DayClose4">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!DayClose.Value</Value>
                                  <Style>
                                    <FontFamily>Tahoma</FontFamily>
                                    <FontSize>9pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Format>0.0</Format>
                                    <Color>=Switch(Fields!DayClose.Value&gt;Fields!DayOpen.Value,"Red",
Fields!DayClose.Value&lt;Fields!DayOpen.Value,"Green",
Fields!DayClose.Value=Fields!DayOpen.Value,"Black")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>DayClose</rd:DefaultName>
                          <Style>
                            <Border>
                              <Color>LightGrey</Color>
                              <Style>Solid</Style>
                            </Border>
                            <BackgroundColor>=IIF(Fields!DayClose.Value&lt;((((Fields!MA11.Value*11)-Fields!DayClose.Value)/10)*0.99),"LightGreen","White")</BackgroundColor>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Textbox493">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!KLine_Status.Value</Value>
                                  <Style>
                                    <FontFamily>Tahoma</FontFamily>
                                    <FontSize>9pt</FontSize>
                                    <Format>0.0</Format>
                                    <Color>=Switch(Fields!DayClose.Value-Fields!DayOpen.Value&lt;0,"Green",
Fields!DayClose.Value-Fields!DayOpen.Value&gt;0,"Red",
Fields!DayClose.Value-Fields!DayOpen.Value=0,"DarkBlue")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
