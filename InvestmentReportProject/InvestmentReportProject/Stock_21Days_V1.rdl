                      <CellContents>
                        <Textbox Name="Textbox4783">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=(Fields!InvestTrust.Value/(Fields!Volume.Value-Fields!DayTrade_Vol.Value))</Value>
                                  <Style>
                                    <FontFamily>Tahoma</FontFamily>
                                    <FontSize>9pt</FontSize>
                                    <Format>0%</Format>
                                    <Color>=IIF(Fields!InvestTrust.Value&gt;0,"Red","Green")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>Textbox4783</rd:DefaultName>
