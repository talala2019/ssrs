    <DataSet Name="PriceDateList">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <CommandText>select PriceDate from temp_company_sdd where 
pricedate in (
SELECT top 21 PriceDate
FROM   temp_company_sdd
WHERE CID=282
ORDER BY PriceDate desc
) and CID=282 ORDER BY PriceDate </CommandText>
      </Query>
      <Fields>
        <Field Name="PriceDate">
          <DataField>PriceDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
