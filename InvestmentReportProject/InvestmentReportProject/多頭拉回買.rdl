                          <rd:DefaultName>Textbox18</rd:DefaultName>
                          <Style>
                            <Border>
                              <Color>LightGrey</Color>
                              <Style>Solid</Style>
                            </Border>
                            <BackgroundColor>=Switch(
(((Fields!MarginRmng.Value-Fields!PreMarginRmng.Value)/(Fields!Volume.Value-Fields!DayTrade_Vol.Value))*100&gt;=12) and (Fields!Volume.Value*Fields!DayClose.Value&gt;10000),"Yellow",
(((Fields!MarginRmng.Value-Fields!PreMarginRmng.Value)/(Fields!Volume.Value-Fields!DayTrade_Vol.Value))*100&lt;=-12) and (Fields!Volume.Value*Fields!DayClose.Value&gt;10000),"LightGreen",
0=0,"White")</BackgroundColor>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Textbox22">
