(Fields!UpperBBand.Value/Fields!LowerBBand.Value)&lt;=1.1,"LightBlue",
(Fields!UpperBBand.Value/Fields!LowerBBand.Value)&lt;=1.15,"LightGreen",
(Fields!UpperBBand.Value/Fields!LowerBBand.Value)&gt;=1.35,"Yellow",
(Fields!UpperBBand.Value/Fields!LowerBBand.Value)&gt;1.27,"Pink",
0=0,"White")</BackgroundColor>
