                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Format(((Fields!UpperBBand.Value / Fields!LowerBBand.Value) - 1) * 100, "#,#") + "  "</Value>
                                  <Style>
                                    <FontFamily>Tahoma</FontFamily>
                                    <FontSize>9pt</FontSize>
                                    <Color>=Switch(
((Fields!UpperBBand.Value/Fields!LowerBBand.Value)-1)*100&lt;=5,"White",
((Fields!UpperBBand.Value/Fields!LowerBBand.Value)-1)*100&lt;=10,"Green",
((Fields!UpperBBand.Value/Fields!LowerBBand.Value)-1)*100&gt;10,"Red",
0=0,"Gray")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
