<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource_localhost">
      <DataSourceReference>DataSource_localhost</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>5d8d3ed1-73cf-4076-b0ab-85dbc22f8840</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@PriceDate">
            <Value>=Parameters!PriceDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@symbol">
            <Value>=Parameters!symbol.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Industry">
            <Value>=Parameters!Industry.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@TurnOverRate">
            <Value>=Parameters!TurnOverRate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Volume">
            <Value>=Parameters!Volume.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@pid_start">
            <Value>=Parameters!pid_start.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@pid_end">
            <Value>=Parameters!pid_end.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>WITH LatestCompanyChips AS (
    SELECT
        cc.*,
        ROW_NUMBER() OVER (PARTITION BY cc.cid ORDER BY cc.pricedate DESC) AS rn
    FROM
        temp_company_chips cc
)

select ROW_NUMBER() over ( order by ((temp_sdd.Volume/Com.Capital)/10) desc ) as row_no, 
Com.CompanyID, Com.ChtName, Com.Symbol, Com.Industry, temp_sdd.PriceDate, temp_sdd.DayClose, CONVERT(DECIMAL(10, 2),temp_spi.Close_Chg1) as 'CloseChg', 
temp_sdd.Volume, Com.Capital,
CONVERT(DECIMAL(10, 2),(temp_sdd.Volume*1000/Com.Capital)/10) as 'TurnOverRate',
instilinvest.ForeignInvest, instilinvest.InvestTrust, instilinvest.Dealer, 
instilinvest.ForeignInvest_MA6, instilinvest.InvestTrust_MA6,
instilinvest.ForeignInvest_MA12, instilinvest.InvestTrust_MA12,
mt.MarginRmng, mt.PreMarginRmng, mt.ShortSellingRmng,
dt.Volume/1000 as 'DayTrade_Vol',
ComInfo.Pid,
temp_sdd.MA20,
temp_sdd.MA240,
spi.V_Avg1,
spi.V_Avg3,
spi.V_Avg5,
temp_spi.MA5_Status,
temp_spi.MA20_Status,
temp_spi.UpperBBand,
temp_spi.UpperSlope,
temp_spi.LowerBBand,
temp_spi.LowerSlope,
comDI.IndustryNames,
lcc.symbol as 'chip_symbol',
FORMAT(lcc.pricedate, 'yyyy-MM-dd') as 'chip_pricedate',
lcc.mi_buy,
lcc.mi_sell,
lcc.key_buy,
lcc.key_sell,
lcc.chip_good,
lcc.chip_bad,
lcc.floor,
lcc.call_warrant,
lcc.put_warrant,
lcc.bband_up,
lcc.bband_down
from Company as Com
inner join temp_company_sdd as temp_sdd on Com.CompanyID=temp_sdd.CID
inner join temp_company_spi as temp_spi on temp_sdd.CID=temp_spi.CompanyID and temp_spi.PriceDate=temp_sdd.PriceDate
inner join StockPriceIndicator as spi on Com.CompanyID=spi.CompanyID and spi.PriceDate=temp_spi.PriceDate
left join CompanyInfo as ComInfo on Com.CompanyID=ComInfo.CompanyID
left join temp_company_instilinvest as instilinvest on Com.CompanyID=instilinvest.CID and instilinvest.DataDate=temp_sdd.PriceDate
left join MarginTrading as mt on temp_sdd.CID=mt.cid and temp_sdd.PriceDate=mt.DataDate
left join DayTrading as dt on temp_sdd.CID=dt.cid and temp_sdd.PriceDate=dt.DataDate
left join CompanyDetailedIndustry as comDI on com.CompanyID=comDI.CompanyID
LEFT JOIN LatestCompanyChips lcc on com.CompanyID=lcc.cid and lcc.rn = 1 and lcc.pricedate&gt;getdate()-8
where 
temp_sdd.PriceDate=@PriceDate 
and Com.Capital&lt;&gt;0 
and (Com.Symbol like '%'+ltrim(rtrim(@symbol))+'%' or Com.Chtname like N'%'+ltrim(rtrim(@symbol))+'%') 
and ( ltrim(rtrim(Com.Industry)) like N'%' + ltrim(rtrim(@Industry)) + '%' )
and ((temp_sdd.Volume/Com.Capital)/10) &gt;= @TurnOverRate
and temp_sdd.Volume &gt; @Volume
--and (ComInfo.Pid LIKE '' + @pid + '%' )
and (ComInfo.Pid&gt;=@pid_start and ComInfo.Pid&lt;=@pid_end)
order by ((temp_sdd.Volume/Com.Capital)/10) desc</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
