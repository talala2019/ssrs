Fields!LowerSlope.Value&lt;=-10,"Blue",
Fields!LowerSlope.Value&lt;=-3,"LightBlue",
Fields!LowerSlope.Value&lt;=-1,"LightGreen",
0=0,"White")</BackgroundColor>
