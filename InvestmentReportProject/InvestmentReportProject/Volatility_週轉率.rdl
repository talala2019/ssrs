                            <Border>
                              <Color>LightGrey</Color>
                            </Border>
                            <BottomBorder>
                              <Style>Solid</Style>
                            </BottomBorder>
                            <BackgroundColor>=Switch(
((Fields!DayClose.Value / Fields!MA240.Value) - 1) * 100&gt;50,"Yellow",
((Fields!DayClose.Value / Fields!MA240.Value) - 1) * 100&gt;25,"Pink",
((Fields!DayClose.Value / Fields!MA240.Value) - 1) * 100&lt;-50,"LightBlue",
((Fields!DayClose.Value / Fields!MA240.Value) - 1) * 100&lt;-25,"LightGreen",
0=0,"White")</BackgroundColor>
