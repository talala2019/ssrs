Fields!UpperSlope.Value&gt;=10,"HotPink",
Fields!UpperSlope.Value&gt;=3,"Yellow",
Fields!UpperSlope.Value&gt;=1,"Pink",
Fields!UpperSlope.Value&lt;=-3,"LightBlue",
Fields!UpperSlope.Value&lt;=-1,"LightGreen",
0=0,"White")</BackgroundColor>
                            <VerticalAlign>Middle</VerticalAlign>
