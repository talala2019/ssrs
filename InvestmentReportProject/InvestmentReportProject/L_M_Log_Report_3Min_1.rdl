                                  <Value>=Format(Sum((Fields!BS_Qty.Value*Fields!AvgPrz.Value)/100000),"#,#.0")+" (億)"</Value>
                                  <Style>
                                    <FontFamily />
                                    <FontSize>12pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                    <Color>=IIf(Sum((Fields!BS_Qty.Value*Fields!AvgPrz.Value)/100000)&gt;0,"Red","Green")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
