  <ReportParameters>
    <ReportParameter Name="messagetime">
      <DataType>DateTime</DataType>
      <DefaultValue>
        <Values>
          <Value>=Today()</Value>
        </Values>
      </DefaultValue>
      <Prompt>Date</Prompt>
    </ReportParameter>
    <ReportParameter Name="StartTime">
      <DataType>String</DataType>
      <DefaultValue>
        <Values>
          <Value>=Switch(TimeValue(Now()) &gt;= TimeValue("13:20:00"), FormatDateTime(TimeValue("13:20"), DateFormat.ShortTime), 
0=0,FormatDateTime(DateAdd("n", -DatePart(DateInterval.Minute, Now()) Mod 5, Now()), DateFormat.ShortTime))</Value>
        </Values>
      </DefaultValue>
      <Prompt>Start Time &gt;=</Prompt>
      <ValidValues>
        <DataSetReference>
          <DataSetName>DataSet2_TimeIntervals</DataSetName>
