                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Format((((Fields!BS_Ratio.Value * Fields!BS_Qty.Value) / (Fields!BS_Ratio.Value - 1)) * Fields!AvgPrz.Value) / 100000, "#,#.0") + "   "</Value>
                                  <Style>
                                    <FontFamily />
                                    <FontSize>=Switch((Fields!BS_Qty.Value=Max(Fields!BS_Qty.Value, "DataSet1")),"11pt",
(Fields!BS_Qty.Value=Min(Fields!BS_Qty.Value, "DataSet1")),"11pt",
0=0,"10pt")</FontSize>
                                    <FontWeight>=Switch((Fields!BS_Qty.Value=Max(Fields!BS_Qty.Value, "DataSet1")),"Bold",
(Fields!BS_Qty.Value=Min(Fields!BS_Qty.Value, "DataSet1")),"Bold",
0=0,"Default")</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                    <Color>Red</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
