(Fields!TradeType.Value="long" and Fields!PctChg_Open.Value&gt;2),"Pink",
(Fields!TradeType.Value="short" and Fields!PctChg_Open.Value&lt;-2),"LightGreen",
0=0,"White")</BackgroundColor>
                            <FontFamily />
