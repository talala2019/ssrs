                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="CurrentPrice">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Switch(Fields!CurrentPrice.Value=Fields!DayHigh.Value,"今高   ",
Fields!CurrentPrice.Value=Fields!DayLow.Value,"今低   ",
0=0,Format(Fields!CurrentPrice.Value,"#,#.0")+"  ")</Value>
                                  <Style>
                                    <FontFamily />
                                    <FontSize>=Switch(Fields!CurrentPrice.Value=Fields!DayHigh.Value,"12pt",
Fields!CurrentPrice.Value=Fields!DayLow.Value,"12pt",
0=0,"11pt")</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <TextDecoration>None</TextDecoration>
                                    <Color>=Switch(Fields!CurrentPrice.Value&gt;=Fields!DayOpen.Value,"Red",
Fields!CurrentPrice.Value&lt;Fields!DayOpen.Value,"Green",
0=0,"Black")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                                <LineHeight>=Switch(Fields!CurrentPrice.Value=Fields!DayHigh.Value,"11pt",
Fields!CurrentPrice.Value=Fields!DayLow.Value,"11pt",
0=0,"10pt")</LineHeight>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>CurrentPrice</rd:DefaultName>
                          <Style>
                            <Border>
                              <Style>None</Style>
                            </Border>
                            <BackgroundColor>=Switch(
(Fields!CurrentPrice.Value&lt;Fields!DayOpen.Value),"LightGreen",
(Fields!CurrentPrice.Value&lt;Fields!AvgPrz.Value),"LightGreen",
0=0,"White")</BackgroundColor>
                            <FontFamily />
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Textbox26">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Format(((Fields!CurrentPrice.Value/Fields!ma5.Value)-1)*100,"#,#.0")+" "</Value>
                                  <Style>
                                    <FontFamily />
                                    <TextDecoration>None</TextDecoration>
                                    <Color>DarkBlue</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
