                            <Actions>
                              <Action>
                                <Hyperlink>="javascript:void(window.open('/InvestmentReports/report/InvestmentReportProject/StockDetails_V3?symbol=" + Fields!StockNo.Value + "&amp;rc:Zoom=82','_blank'))"</Hyperlink>
                              </Action>
                            </Actions>
                          </ActionInfo>
                          <Style>
                            <Border>
                              <Style>None</Style>
                            </Border>
