(Fields!CurrentPrice.Value&gt;Fields!ma20.Value*1.1),"Pink",
(Fields!CurrentPrice.Value&lt;Fields!ma20.Value),"LightGreen",
0=0,"White")</BackgroundColor>
                            <PaddingLeft>2pt</PaddingLeft>
