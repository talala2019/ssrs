(Fields!CurrentPrice.Value&gt;Fields!ma5.Value*1.1),"Pink",
(Fields!CurrentPrice.Value&lt;Fields!ma5.Value),"LightGreen",
0=0,"White")</BackgroundColor>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
