    <DataSet Name="DataSet2_TimeIntervals">
      <Query>
        <DataSourceName>DataSource_InMemoryOLTP_KGI_DB</DataSourceName>
        <CommandText>WITH TimeIntervals AS (
    SELECT CAST('09:03' AS TIME) AS TimeInterval
    UNION ALL
    SELECT DATEADD(MINUTE, 3, TimeInterval) 
    FROM TimeIntervals
    WHERE TimeInterval &lt; '13:30' -- Adjusted to '13:30'
)
SELECT CONVERT(VARCHAR(5), TimeInterval, 108) AS TimeIntervalFormatted
FROM TimeIntervals
OPTION (MAXRECURSION 0);</CommandText>
      </Query>
      <Fields>
        <Field Name="TimeIntervalFormatted">
          <DataField>TimeIntervalFormatted</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="PortfolioList">
      <Query>
        <DataSourceName>DS_Investment_DB</DataSourceName>
        <CommandText>select PID, Name, Name+' '+CAST(PID as varchar(10)) as'NameID' from PortfolioMain
where pid in (28, 33, 38, 63, 68, 81, 83, 86, 89, 112, 124, 139, 140, 141 )
order by priority, name, pid</CommandText>
      </Query>
      <Fields>
        <Field Name="PID">
          <DataField>PID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Name">
          <DataField>Name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="NameID">
          <DataField>NameID</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
