                            <BackgroundColor>=Switch(
((Fields!BS_Qty.Value/Fields!CurrentQty.Value)*100)-(Previous(Fields!BS_Qty.Value)/Previous(Fields!CurrentQty.Value)*100)&gt;=5 and Hour(Fields!MessageTime.Value)&gt;=10,"Yellow",
((Fields!BS_Qty.Value/Fields!CurrentQty.Value)*100)-(Previous(Fields!BS_Qty.Value)/Previous(Fields!CurrentQty.Value)*100)&lt;=-5 and Hour(Fields!MessageTime.Value)&gt;=10,"LightBlue",
((Fields!BS_Qty.Value/Fields!CurrentQty.Value)*100)-(Previous(Fields!BS_Qty.Value)/Previous(Fields!CurrentQty.Value)*100)&gt;=4 and Hour(Fields!MessageTime.Value)&gt;=11,"Yellow",
((Fields!BS_Qty.Value/Fields!CurrentQty.Value)*100)-(Previous(Fields!BS_Qty.Value)/Previous(Fields!CurrentQty.Value)*100)&lt;=-4 and Hour(Fields!MessageTime.Value)&gt;=11,"LightBlue",
0=0,"White")</BackgroundColor>
