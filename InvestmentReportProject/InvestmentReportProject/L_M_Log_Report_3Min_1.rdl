                              <TextRuns>
                                <TextRun>
                                  <Value>=Left(Fields!StockNo.Value,4)</Value>
                                  <Style>
                                    <FontFamily />
                                    <FontWeight>Bold</FontWeight>
                                    <Color>DarkBlue</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
