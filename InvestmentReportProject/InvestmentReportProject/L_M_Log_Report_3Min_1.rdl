                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>= Format((1 / (Fields!BS_Ratio.Value + 1)) * 100, "#,#")+ "  "</Value>
                                  <Style>
                                    <FontFamily />
