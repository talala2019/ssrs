  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@stockNo">
            <Value>=Parameters!stockNo.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@keyword">
            <Value>=Parameters!keyword.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select ROW_NUMBER() over (order by stockno) as row_no, * from CompanyBranch 
where stockno like '%' + @stockNo + '%'
and Memo like N'%' + @keyword + '%'
order by memo desc</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="row_no">
          <DataField>row_no</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="CompanyID">
