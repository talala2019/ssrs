                          <Style>
                            <Border>
                              <Color>LightGrey</Color>
                              <Style>Solid</Style>
                            </Border>
                            <BackgroundColor>=Switch(Fields!DayClose.Value&gt;=Fields!UpperBBand.Value,"Yellow",
Fields!DayClose.Value&lt;=Fields!LowerBBand.Value,"LightGreen",
0=0,"White")</BackgroundColor>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Textbox39">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!MarginRmng.Value-Fields!PreMarginRmng.Value</Value>
                                  <Style>
                                    <FontFamily>Tahoma</FontFamily>
                                    <Format>0</Format>
                                    <Color>=IIF((Fields!MarginRmng.Value-Fields!PreMarginRmng.Value)&gt;0,"Red","Green")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>Textbox39</rd:DefaultName>
                          <Style>
                            <Border>
                              <Color>LightGrey</Color>
                              <Style>Solid</Style>
                            </Border>
                            <BackgroundColor>=Switch(
(((Fields!MarginRmng.Value-Fields!PreMarginRmng.Value)/(Fields!Volume.Value-Fields!DayTrade_Vol.Value))*100&gt;=20) and (Fields!Volume.Value*Fields!DayClose.Value&gt;15000),"Yellow",
(((Fields!MarginRmng.Value-Fields!PreMarginRmng.Value)/(Fields!Volume.Value-Fields!DayTrade_Vol.Value))*100&lt;=-20) and (Fields!Volume.Value*Fields!DayClose.Value&gt;15000),"LightGreen",
0=0,"Pink")</BackgroundColor>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
