  <Code>Public Function Divider (ByVal Dividend As Double, ByVal Divisor As Double)
If IsNothing(Divisor) Or Divisor = 0
  Return 0
Else
  Return Dividend/Divisor
End If
End Function 

Public Function LowShadowLine(ByVal Open As Double, ByVal High As Double, ByVal Low As Double, ByVal Close As Double, ByVal PreClose As Double)

If (Close-Open) &gt; 0
	
	If ((Open-Low)/(Close-Open)) &gt;=0.5
	Return "L" 
	End If
		
End If

If (Close-Open) &lt; 0

    	If ((Close-Low)/(Open-Close)) &gt;=0.5 
	Return "L" 
	End If
	
End If

End Function 

Public Function UpperShadowLine(ByVal Open As Double, ByVal High As Double, ByVal Low As Double, ByVal Close As Double, ByVal PreClose As Double)

If (Close-Open) &gt; 0
	
   	If ((High-Close)/(Close-Open)) &gt;=1
	Return "L" 
	End If
	
End If

If (Close-Open) &lt; 0
	
    	If ((High-Open)/(Open-Close)) &gt;=1
	Return "L"
	End If
	
End If

End Function 

Public Function CalculatePriceLevel(closePrice As Double, upperBand As Double, lowerBand As Double, middleBand As Double) As Integer
    Dim levelRange As Double
    levelRange = (upperBand - middleBand) / 10 ' Calculate the range for each level

    If closePrice &gt; upperBand Then
        ' Calculate how many levels above the upper band
        Return 10 + CInt((closePrice - upperBand) / levelRange)
    ElseIf closePrice &lt; lowerBand Then
        ' Calculate how many levels below the lower band
        Return -10 + CInt((closePrice - lowerBand) / levelRange)
    Else
        ' Calculate the level within the bands
        Return CInt((closePrice - middleBand) / levelRange)
    End If
End Function</Code>
