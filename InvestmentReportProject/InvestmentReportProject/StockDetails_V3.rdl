    <DataSet Name="PriceDateList">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <CommandText>SELECT DISTINCT PriceDate
FROM   temp_company_sdd
WHERE (PriceDate &gt; GETDATE() - 100) -- top 60 = getdate()-90 
ORDER BY PriceDate</CommandText>
      </Query>
      <Fields>
        <Field Name="PriceDate">
          <DataField>PriceDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="PriceDateList_Desc">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <CommandText>SELECT DISTINCT PriceDate
FROM   temp_company_sdd
WHERE (PriceDate &gt; GETDATE() - 103)
and CID=282
ORDER BY PriceDate Desc</CommandText>
      </Query>
      <Fields>
        <Field Name="PriceDate">
          <DataField>PriceDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="LongStocks">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <CommandText>select symbol+' '+chtname as stockname from company where dlgroup=8
order by symbol</CommandText>
      </Query>
      <Fields>
        <Field Name="stockname">
          <DataField>stockname</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="ShortStocks">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <CommandText>select symbol+' '+chtname as stockname from company where dlgroup=9
order by symbol</CommandText>
      </Query>
      <Fields>
        <Field Name="stockname">
          <DataField>stockname</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="StockMain_DataSet">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@enddate">
            <Value>=Parameters!enddate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@symbol">
            <Value>=Parameters!symbol.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT Com.CompanyID AS 'CID', Com.Industry, Com.Sector, Com.DLGroup, Com.ChtName, Com.Symbol, SUBSTRING(Com.Symbol, 0, 5) AS 'Code', Com.CountryCode, 
		SDD.DayClose,
		Com.Capital, msales.year, msales.month, msales.msales, msales.msales_pre1, msales.msales_pre2, msales.lymsales, msales.lymsales_pre1, msales.lymsales_pre2, msales.salesYoY, msales.msalesresult, 
		pe.name, pe.yield, pe.pe_ratio, pe.pb_ratio, pe.quarter, temp_swd.WeekMA20, 
        temp_swd.WeekMA35, temp_swd.WeekMA60, temp_swd.WeekClose, temp_swd.WeekTrend, temp_swd.WeekDMI, temp_swd.WeekMACDStatus,
		cs.PriceDate, cs.Status, cs.Status_StartDate, cs.K_High, cs.BreakTh_High, cs.K_Low, cs.FallBelow_Low,
		div.DividendDate, div.Cash, div.SplitRatio, 
		--FE.Nav AS '董監%', FE.Yield AS '外資%', FE.Equity AS '負債%',
		CST.Signal,
		TT.SignalCount, TT.SignalDay,
		TT.AccCloseChg, TT.AccFI1, TT.MaxAccFI1Sell, 
		TT.MaxAccInvestTrustBuy, TT.MaxAccInvestTrustBuyDay,
		TT.MaxFI12, TT.MaxFI20,
		TT.AccMargin1, TT.MaxAccMargin1Sell,
		FI_Holdings.holding_ratio as 'FI_HoldingRatio',
		Director_Holdings.holding_ratio as 'Director_HoldingRatio'
FROM Company AS Com
LEFT OUTER JOIN temp_company_sdd as SDD on Com.CompanyID=SDD.CID and SDD.PriceDate=@enddate
LEFT OUTER JOIN CompanyStatus AS cs ON Com.CompanyID = cs.CompanyID and CS.PriceDate=@enddate 
LEFT OUTER JOIN CompanySignalTracking as CST on Com.CompanyID = CST.CompanyID and CST.PriceDate=@enddate
LEFT OUTER JOIN Trend_Tracking AS TT On Com.CompanyID = TT.CID and TT.PriceDate=@enddate
LEFT OUTER JOIN Dividend AS div ON Com.CompanyID = div.CompanyID  and div.DividendDate&gt;=getdate()
LEFT OUTER JOIN temp_company_swd AS temp_swd ON Com.CompanyID = temp_swd.CompanyID AND temp_swd.EndDate = @enddate 
LEFT OUTER JOIN temp_company_msalesYoY AS msales ON Com.CompanyID = msales.cid 
LEFT OUTER JOIN temp_company_pe AS pe ON SUBSTRING(Com.Symbol, 0, 5) = LTRIM(RTRIM(pe.symbol)) 
LEFT OUTER JOIN temp_foreigninvest_holdings AS FI_Holdings on Com.CompanyID=FI_Holdings.CID and FI_Holdings.latest_date=1
LEFT OUTER JOIN temp_director_holdings as Director_Holdings on Com.CompanyID=Director_Holdings.CID and Director_Holdings.latest_date=1
WHERE  (Com.Status = 1) AND (Com.Symbol LIKE '%' + LTRIM(RTRIM(@symbol)) + '%') OR (Com.Status = 1) AND (Com.ChtName LIKE N'%' + LTRIM(RTRIM(@symbol)) + '%')</CommandText>
      </Query>
      <Fields>
        <Field Name="CID">
          <DataField>CID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="Industry">
          <DataField>Industry</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
