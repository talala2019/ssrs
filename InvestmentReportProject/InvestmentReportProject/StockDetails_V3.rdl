                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Textbox70">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Code.CalculatePriceLevel(Fields!DayClose.Value,Fields!UpperBBand.Value,Fields!LowerBBand.Value,(Fields!UpperBBand.Value+Fields!LowerBBand.Value)/2)</Value>
                                  <Style>
                                    <FontFamily>Tahoma</FontFamily>
                                    <FontWeight>Bold</FontWeight>
                                    <Format>+#;-#;0</Format>
                                    <Color>=Switch(
Code.CalculatePriceLevel(Fields!DayClose.Value,Fields!UpperBBand.Value,Fields!LowerBBand.Value,(Fields!UpperBBand.Value+Fields!LowerBBand.Value)/2)&gt;4,"Red",
Code.CalculatePriceLevel(Fields!DayClose.Value,Fields!UpperBBand.Value,Fields!LowerBBand.Value,(Fields!UpperBBand.Value+Fields!LowerBBand.Value)/2)&gt;0,"Blue",
Code.CalculatePriceLevel(Fields!DayClose.Value,Fields!UpperBBand.Value,Fields!LowerBBand.Value,(Fields!UpperBBand.Value+Fields!LowerBBand.Value)/2)&lt;0,"Green",
0=0,"DarkBlue")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Right</TextAlign>
                              </Style>
                            </Paragraph>
                          </Paragraphs>
                          <rd:DefaultName>Textbox70</rd:DefaultName>
                          <Style>
                            <Border>
                              <Color>LightGrey</Color>
                              <Style>Solid</Style>
                            </Border>
                            <BackgroundColor>=Switch(
Code.CalculatePriceLevel(Fields!DayClose.Value,Fields!UpperBBand.Value,Fields!LowerBBand.Value,(Fields!UpperBBand.Value+Fields!LowerBBand.Value)/2)&gt;=9,"Pink",
Code.CalculatePriceLevel(Fields!DayClose.Value,Fields!UpperBBand.Value,Fields!LowerBBand.Value,(Fields!UpperBBand.Value+Fields!LowerBBand.Value)/2)&lt;=-9,"LightGreen",
0=0,"White")</BackgroundColor>
                            <VerticalAlign>Middle</VerticalAlign>
