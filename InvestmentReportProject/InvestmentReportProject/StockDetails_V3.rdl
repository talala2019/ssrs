<?xml version="1.0" encoding="utf-8"?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource_localhost">
      <DataSourceReference>DataSource_localhost</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>56cd27f5-46d2-4105-a744-8706f1cbd54f</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="StockDailyData_DataSet">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@symbol">
            <Value>=Parameters!symbol.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@startdate">
            <Value>=Parameters!startdate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@enddate">
            <Value>=Parameters!enddate.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>--Get Max BuySellRunningTotal from InstitutionalInvest
declare @temp_CID int
select @temp_CID=CompanyID from Company where CountryCode='TW' and substring(Symbol,0,5)=substring(ltrim(rtrim(@symbol)),0,5)
declare @MaxBuySellRunningTotal float
select @MaxBuySellRunningTotal=Max(BuySellRunningTotal)/1000 from InstitutionalInvest where CID=@temp_CID

-- Main Selection SQL
select ROW_NUMBER() over (order by temp_sdd.PriceDate) as row_no, Com.CompanyID as 'CID',
Com.ChtName, Com.Symbol, substring(Com.Symbol,0,5) as 'Code', 
Com.CountryCode, Com.Capital,
temp_sdd.PriceDate, temp_sdd.DayOpen, temp_sdd.DayHigh, temp_sdd.DayLow,  temp_sdd.DayClose, temp_sdd.PreClose,
Cast((temp_sdd.DayClose-temp_sdd.MA60)/temp_sdd.MA60 as DECIMAL(10,2)) as 'D_60_Div',
Cast((temp_sdd.DayClose-temp_sdd.MA100)/temp_sdd.MA100 as DECIMAL(10,2)) as 'D_100_Div', 
temp_sdd.Volume, temp_sdd.Vol_MA3, temp_sdd.Vol_MA5, temp_sdd.Vol_MA10, temp_sdd.Vol_MA15, temp_sdd.Vol_MA20, 
Cast(temp_sdd.Vol_MA5/temp_sdd.Vol_MA20 as DECIMAL(10,2)) as 'VolMul_5_20',
temp_sdd.MA5, temp_sdd.MA10, temp_sdd.MA11, temp_sdd.MA20, temp_sdd.MA42, temp_sdd.MA60, temp_sdd.MA100,
instilinvest.ForeignInvest,
instilinvest.ForeignInvest_MA3,
instilinvest.ForeignInvest_MA6,
instilinvest.ForeignInvest_MA12,
instilinvest.ForeignInvest_MA20,
instilinvest.ForeignInvest_MA40,
instilinvest.ForeignInvest_MA60,
instilinvest.ForeignInvest_MA120,
instilinvest.InvestTrust,
instilinvest.InvestTrust_MA3,
instilinvest.InvestTrust_MA6,
instilinvest.InvestTrust_MA12,
instilinvest.InvestTrust_MA20,
instilinvest.InvestTrust_MA40,
instilinvest.InvestTrust_MA60,
instilinvest.InvestTrust_MA120,
instilinvest.Dealer,
instilinvest.Dealer_MA3,
instilinvest.Dealer_MA6,
instilinvest.Dealer_MA12,
instilinvest.Dealer_MA20,
instilinvest.Dealer_MA40,
instilinvest.Dealer_MA60,
instilinvest.Dealer_MA120,
instilinvest.BuySellTotal,
instilinvest.BuySellRunningTotal,
@MaxBuySellRunningTotal as 'MaxBuySellRunningTotal',
instilinvest.BuySellTotal_MA3,
instilinvest.BuySellTotal_MA6,
instilinvest.BuySellTotal_MA12,
instilinvest.BuySellTotal_MA20,
instilinvest.BuySellTotal_MA40,
instilinvest.BuySellTotal_MA60,
instilinvest.BuySellTotal_MA120,
instilinvest.ForeignInvestCost,
instilinvest.ForeignInvestCostStartDate,
instilinvest.InvestTrustCost,
instilinvest.InvestTrustCostStartDate,
spi.Day0_K,
spi.Day0_D,
spi.Day0_Dif,
spi.Day0_Macd,
spi.Day1_K,
spi.Day1_D,
spi.Day1_Dif,
spi.Day1_Macd,
spi.Day1_Vol,
spi.MA5_Status,
spi.MA10_Status,
spi.MA20_Status,
spi.MA42_Status,
spi.MA60_Status,
spi.VolAvg3_Status,
spi.Days_CloseOnMa5,
spi.Days_Ma5OnMa20,
spi.Day0_W55,
spi.Day0_W9,
spi.Day0_Bar,
spi.Day0_Bar_Status,
spi.Close_Chg1,
spi.Close_Chg3,
spi.Close_Chg5,
spi.Close_Chg6,
spi.Close_Chg10,
spi.Close_Chg12,
spi.Close_Chg20,
spi.Close_Chg40,
spi.Close_Chg60,
spi.Close_Chg120,
spi.BT_60DaysHigh,
spi.BT_120DaysHigh,
spi.FB_60DaysLow,
spi.FB_120DaysLow,
spi.UpperBBand,
spi.LowerBBand,
spi.MinVol_In10Days,
mt.PreMarginRmng,
mt.MarginRmng,
mt.MarginTtl,
mt.PreShortSellingRmng,
mt.ShortSellingRmng,
mt.ShortSellingTtl,
dt.Volume/1000 as 'DayTrade_Vol',
temp_swd.WeekTrend,
temp_swd.WeekMACDStatus,
temp_swd.WeekDMI,
temp_swd.WeekADX14,
temp_swd.Major400,
temp_swd.Major1000,
temp_swd.MajorDiff,
TT.TrendTrackingSignal,
TT.SignalType,
CONVERT(DECIMAL(10, 2),(temp_sdd.Volume*1000/Com.Capital)/10) as 'TurnOverRate'
from Company as Com 
inner join temp_company_sdd as temp_sdd on Com.CompanyID=temp_sdd.CID
left join temp_company_swd as temp_swd on temp_sdd.CID=temp_swd.CompanyID and temp_sdd.PriceDate=temp_swd.EndDate
left join temp_company_spi as spi on Com.CompanyID=spi.CompanyID and spi.PriceDate=temp_sdd.PriceDate and spi.PriceDate&gt;=@startdate
left join MarginTrading as mt on Com.CompanyID=mt.CID and mt.DataDate=temp_sdd.PriceDate and mt.DataDate&gt;=@startdate
left join DayTrading as dt on Com.CompanyID=dt.CID and dt.DataDate=temp_sdd.PriceDate and dt.DataDate&gt;=@startdate
--left join companyinfo as cominfo on SUBSTRING(com.Symbol,0,5)=ltrim(rtrim(cominfo.Symbol)) 
left join temp_company_instilinvest as instilinvest on Com.CompanyID=instilinvest.CID and instilinvest.DataDate=temp_sdd.PriceDate and instilinvest.DataDate&gt;=@startdate
left join Trend_Tracking as TT on temp_sdd.CID=TT.CID and temp_sdd.PriceDate=TT.PriceDate
where 
Com.status=1
-- 參數		
and temp_sdd.PriceDate&gt;=@startdate									-- sdd pricedate
and temp_sdd.PriceDate&lt;=@enddate									-- sdd pricedate
and Com.CountryCode='TW'
and (Com.Symbol like '%'+ltrim(rtrim(@symbol))+'%' or Com.Chtname like N'%'+ltrim(rtrim(@symbol))+'%') 		-- symbol</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
