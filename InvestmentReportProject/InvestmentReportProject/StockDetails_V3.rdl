(Fields!DayClose.Value&gt;=Fields!UpperBBand.Value) and ((Fields!UpperBBand.Value/Fields!LowerBBand.Value)&lt;=1.2),"LightBlue",
(Fields!UpperBBand.Value/Fields!LowerBBand.Value)&lt;=1.05,"LightGreen",
(Fields!UpperBBand.Value/Fields!LowerBBand.Value)&gt;=1.2,"Pink",
0=0,"White")</BackgroundColor>
