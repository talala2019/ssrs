                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!ShortSellingRmng.Value-Fields!PreShortSellingRmng.Value</Value>
                                  <Style>
                                    <FontFamily>Tahoma</FontFamily>
                                    <Format>0</Format>
                                    <Color>=IIF((Fields!ShortSellingRmng.Value-Fields!PreShortSellingRmng.Value)&gt;0,"Red","Green")</Color>
                                  </Style>
