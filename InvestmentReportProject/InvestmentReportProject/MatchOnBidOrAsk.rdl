        </Field>
        <Field Name="SumQtyOnAsk">
          <DataField>SumQtyOnAsk</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="CountEntries_OnBid">
          <DataField>CountEntries_OnBid</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="CountEntries_OnAsk">
          <DataField>CountEntries_OnAsk</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="OnBid_Count">
          <DataField>OnBid_Count</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="AccQtyOnBid">
          <DataField>AccQtyOnBid</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="OnAsk_Count">
          <DataField>OnAsk_Count</DataField>
          <rd:TypeName>System.Int64</rd:TypeName>
        </Field>
        <Field Name="AccQtyOnAsk">
          <DataField>AccQtyOnAsk</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
