                              <Color>LightGrey</Color>
                              <Style>Solid</Style>
                            </Border>
                            <BackgroundColor>=Switch(
(Fields!UpperBBand.Value/Fields!LowerBBand.Value)&lt;=1.05,"LightGreen",
(Fields!UpperBBand.Value/Fields!LowerBBand.Value)&lt;=1.3,"LightBlue",
(Fields!UpperBBand.Value/Fields!LowerBBand.Value)&gt;=1.5,"Yellow",
(Fields!UpperBBand.Value/Fields!LowerBBand.Value)&gt;1.3,"Pink",
0=0,"White")</BackgroundColor>
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
