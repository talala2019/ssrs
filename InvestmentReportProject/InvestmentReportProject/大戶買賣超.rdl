<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource_localhost">
      <DataSourceReference>DataSource_localhost</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>7cd1813d-6632-4426-8149-0231cefea05e</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@major_holding_ratio_diff">
            <Value>=Parameters!major_holding_ratio_diff.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@date">
            <Value>=Parameters!date.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@vol">
            <Value>=Parameters!vol.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@fi_12_ratio">
            <Value>=Parameters!fi_12_ratio.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@pid">
            <Value>=Parameters!pid.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>-- Step 1: Map each StockDailyData row to the latest StockWeeklyData before or on its PriceDate
WITH LatestWeekly AS (
    SELECT
        sdd.CID as CompanyID,
        sdd.PriceDate,
        swd.EndDate,
        swd.Major1000
    FROM
        temp_company_sdd sdd
    OUTER APPLY (
        SELECT TOP 1 swd.*
        FROM temp_company_swd swd
        WHERE swd.CompanyID = sdd.CID
          AND swd.EndDate = sdd.PriceDate
		  AND swd.EndDate&gt;getdate()-90
        ORDER BY swd.EndDate DESC
    ) swd
	where sdd.PriceDate&gt;getdate()-90 and swd.Major1000 is not null
),

-- Step 2: Use LAG to get previous and 3-weeks-back weekly data
WithLags AS (
    SELECT
        CompanyID,
        PriceDate,
        EndDate,
        major1000,
        LAG(major1000, 1) OVER (PARTITION BY CompanyID ORDER BY EndDate) AS Prev1_Major1000,
        LAG(major1000, 2) OVER (PARTITION BY CompanyID ORDER BY EndDate) AS Prev2_Major1000,
        LAG(major1000, 3) OVER (PARTITION BY CompanyID ORDER BY EndDate) AS Prev3_Major1000
    FROM
        LatestWeekly
),

-- Step 3: 篩選7個交易日內個股的個股大戶持股變化
MajorIncrease AS (
	SELECT
		CompanyID,
		PriceDate,
		EndDate,
		major1000,
    
		Prev1_Major1000,
		Prev2_Major1000,
		Prev3_Major1000,

		round(major1000 - Prev1_Major1000,2) AS Diff_Major1000_Weeks,
		round(major1000 - Prev2_Major1000,2) AS Diff_Major1000_2Weeks,
		round(major1000 - Prev3_Major1000,2) AS Diff_Major1000_3Weeks
	FROM
		WithLags
	Where PriceDate&gt;getdate()-7
	and (major1000-Prev1_Major1000&gt;@major_holding_ratio_diff or major1000-Prev2_Major1000&gt;@major_holding_ratio_diff or major1000-Prev3_Major1000&gt;@major_holding_ratio_diff)
)


Select 
ROW_NUMBER() OVER (ORDER BY (weekly_maor.major1000 - Prev1_Major1000) DESC) AS RowNum, -- Added Row Number
com.CompanyID,  com.ChtName, com.Symbol, com.Industry, detailed_indus_names.IndustryNames, temp_sdd.PriceDate, 
temp_sdd.DayClose,
temp_sdd.Volume, 
round(temp_sdd.Volume/temp_sdd.Vol_MA20,2) as 'Vol_Ratio',
temp_spi.Days_CloseOnMa5,
round(temp_spi.Close_Chg1,2) as 'Close_Chg1', round(temp_spi.Close_Chg10,2) as 'Close_Chg10', round(temp_spi.Close_Chg20,2) as 'Close_Chg20', round(temp_spi.Close_Chg60,2) as 'Close_Chg60',
round(temp_spi.UpperBBand,2) as 'UpperBBand',
round(temp_spi.LowerBBand,2) as 'LowerBBand',
round(temp_spi.UpperSlope,2) as 'Upper_Slope',
round(temp_spi.LowerSlope,2) as 'Lower_Slope',
round(temp_sdd.MA20_Slope,2) as 'Ma20_Slope',
round((temp_sdd.DayClose/temp_sdd.MA20)-1,2) as 'Ma20_Bias',
round((temp_sdd.DayClose/temp_sdd.MA240)-1,2) as 'Ma240_Bias',
round(((instilinvest.ForeignInvest+instilinvest.InvestTrust)/Com.Capital)*100,3) as 'FIRatio1',
round(((instilinvest.ForeignInvest_MA6+instilinvest.InvestTrust_MA6)/Com.Capital)*100,3) as 'FIRatio6',
round(((instilinvest.ForeignInvest_MA12+instilinvest.InvestTrust_MA12)/Com.Capital)*100,3) as 'FIRatio12',
round(((instilinvest.ForeignInvest_MA60+instilinvest.InvestTrust_MA60)/Com.Capital)*100,3) as 'FIRatio60',
round((temp_sdd.Volume/com.Capital)*100,2) as 'TurnOver',
round(weekly_maor.major1000 - Prev1_Major1000,3) AS 'MajorHold_1W_Chg',
round((weekly_maor.major1000 - Prev1_Major1000)+(Prev1_Major1000-Prev2_Major1000),3) AS 'MajorHold_2W_Chg',
weekly_maor.major1000 'MajorHold_W0',
Prev1_Major1000 'MajorHold_W1',
Prev2_Major1000 'MajorHold_W2',
Prev3_Major1000 'MajorHold_W3'
from Company as com 
inner join temp_company_sdd as temp_sdd on com.CompanyID=temp_sdd.CID
inner join temp_company_spi as temp_spi on temp_sdd.CID=temp_spi.CompanyID and temp_sdd.PriceDate=temp_spi.PriceDate
left join temp_company_instilinvest as instilinvest on Com.CompanyID=instilinvest.CID and instilinvest.DataDate=temp_sdd.PriceDate
Left join CompanyDetailedIndustry as detailed_indus_names on com.CompanyID=detailed_indus_names.CompanyID
LEFT OUTER JOIN temp_company_swd AS temp_swd ON Com.CompanyID = temp_swd.CompanyID AND temp_swd.EndDate = @date
LEFT OUTER JOIN MajorIncrease as weekly_maor  on com.CompanyID = weekly_maor.CompanyID
where 
com.Status=1 and com.CountryCode='TW' and com.DLGroup=2
and weekly_maor.major1000 is not null
and temp_sdd.PriceDate=@date
and temp_sdd.Volume&gt;@vol -- 成交量 
and ((instilinvest.ForeignInvest_MA12+instilinvest.InvestTrust_MA12)/Com.Capital)*100&gt;@fi_12_ratio -- 12 外投本比
--本周&gt;3% or 近2周合計&gt;3%
and ((weekly_maor.major1000 - Prev1_Major1000&gt;@major_holding_ratio_diff) or ((weekly_maor.major1000 - Prev1_Major1000)+(Prev1_Major1000-Prev2_Major1000)&gt;@major_holding_ratio_diff))
and com.CompanyID in (SELECT CompanyID FROM PortfolioStock 
    -- If @pid is NULL, this condition becomes TRUE for all rows
    WHERE PID = @pid OR @pid is null )
order by (weekly_maor.major1000 - Prev1_Major1000) desc</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
