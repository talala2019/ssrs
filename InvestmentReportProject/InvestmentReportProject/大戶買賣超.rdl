                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Fields!IndustryNames.Value</Value>
                                  <Style>
                                    <FontFamily />
                                    <FontSize>11pt</FontSize>
                                    <Color>=Switch(
InStr(Fields!IndustryNames.Value,"光纖")&gt;0,"Gold",
InStr(Fields!IndustryNames.Value,"光收發")&gt;0,"Gold",
InStr(Fields!IndustryNames.Value,"散熱")&gt;0,"Red",
InStr(Fields!IndustryNames.Value,"記憶體")&gt;0,"Orange",
InStr(Fields!IndustryNames.Value,"IC基板")&gt;0,"Purple",
InStr(Fields!IndustryNames.Value,"印刷")&gt;0,"Purple",
InStr(Fields!IndustryNames.Value,"光學")&gt;0,"Green",
InStr(Fields!IndustryNames.Value,"電源")&gt;0,"Orange",
InStr(Fields!IndustryNames.Value,"電池")&gt;0,"Orange",
