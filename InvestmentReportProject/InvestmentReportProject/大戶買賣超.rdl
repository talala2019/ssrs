    <DataSet Name="PriceDateList">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <CommandText>SELECT DISTINCT EndDate
FROM   temp_company_swd
WHERE (EndDate &gt; GETDATE() - 90) 
and CompanyID in (282,291)
ORDER BY EndDate Desc</CommandText>
      </Query>
      <Fields>
        <Field Name="EndDate">
          <DataField>EndDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
