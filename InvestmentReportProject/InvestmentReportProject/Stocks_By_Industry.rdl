                              <Style>Solid</Style>
                            </BottomBorder>
                            <BackgroundColor>=IIf( (Fields!DayHigh.Value-Fields!DayLow.Value)/Fields!DayLow.Value&gt;=0.06,"Pink","LightGray" )</BackgroundColor>
                            <FontFamily />
                            <VerticalAlign>Middle</VerticalAlign>
                            <PaddingLeft>2pt</PaddingLeft>
                            <PaddingRight>2pt</PaddingRight>
                            <PaddingTop>2pt</PaddingTop>
                            <PaddingBottom>2pt</PaddingBottom>
                          </Style>
                        </Textbox>
                      </CellContents>
