<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource_localhost">
      <DataSourceReference>DataSource_localhost</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>63ccf33d-7617-4b16-b43e-3bd425920908</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Industry">
            <Value>=Parameters!Industry.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@PriceDate">
            <Value>=Parameters!PriceDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Volume">
            <Value>=Parameters!Volume.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@MarketType">
            <Value>=Parameters!MarketType.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select Com.CompanyID, Com.ChtName, Com.Symbol, 
Com.CountryCode, Com.Industry,Com.Sector,
Com.Capital,
CONVERT(VARCHAR(10),SPI.PriceDate, 111) as 'Date', 
SPI.DayClose,
SDD.DayHigh,
SDD.DayLow, 
SDD.Volume,
SDD.Vol_MA20,
SDD.MA5,
SDD.MA20,
SDD.MA60,
SPI.Days_CloseOnMa5,
SPI.Day1_Vol,
Ins.ForeignInvest,
Ins.InvestTrust,
Ins.Dealer,
Temp_Ins.ForeignInvest_MA6,
Temp_Ins.InvestTrust_MA6,
Temp_Ins.Dealer_MA6,
Temp_Ins.ForeignInvest_MA12,
Temp_Ins.InvestTrust_MA12,
Temp_Ins.Dealer_MA12,
Temp_Ins.ForeignInvest_MA20,
Temp_Ins.InvestTrust_MA20,
Temp_Ins.Dealer_MA20,
Temp_Ins.ForeignInvest_MA60,
Temp_Ins.InvestTrust_MA60,
Temp_Ins.Dealer_MA60,
Temp_Ins.ForeignInvest_MA120,
Temp_Ins.InvestTrust_MA120,
Temp_Ins.Dealer_MA120,
SPI.Close_Chg1,
SPI.Close_Chg3,
SPI.Close_Chg6,
SPI.Close_Chg10,
SPI.Close_Chg12,
SPI.Close_Chg20,
SPI.Close_Chg60,
SPI.Close_Chg120,
SPI.MA20_Status,
SPI.MA60_Status,
SPI.Day0_Dif,
SPI.Day0_Macd,
spi.UpperBBand,
spi.UpperSlope,
spi.LowerBBand,
spi.LowerSlope,
mt.PreMarginRmng,
mt.MarginRmng,
mt.MarginTtl,
mt.PreShortSellingRmng,
mt.ShortSellingRmng,
mt.ShortSellingTtl,
dt.Volume/1000 as 'DayTrade_Vol',
director.holding_ratio as 'dir_holding_ratio',
foreigninvest.holding_ratio as 'foreign_holding_ratio',
case
when TT.SignalType is null then 'n/a'
else TT.SignalType
end as 'SignalType',

SMD_0.Volume as 'Vol_M0',
SMD_1.Volume as 'Vol_M1',
SMD_2.Volume as 'Vol_M2',
SMD_3.Volume as 'Vol_M3',
SMD_4.Volume as 'Vol_M4',

pe.yield, pe.pe_ratio, pe.pb_ratio,
msales,salesYoY,
msales.lytotalsales_wholeyear

from Company as Com 
inner join temp_company_spi as SPI on Com.CompanyID=SPI.CompanyID
inner join temp_company_sdd as SDD on SPI.CompanyID=SDD.CID and SPI.PriceDate=SDD.PriceDate
inner join InstitutionalInvest as Ins on SDD.CID=Ins.CID and SDD.PriceDate=Ins.DataDate
LEFT JOIN Trend_Tracking as TT on SDD.CID=TT.CID and SDD.PriceDate=TT.PriceDate
left join temp_company_instilinvest as Temp_Ins on SDD.CID=Temp_Ins.CID and SDD.PriceDate=Temp_Ins.DataDate
left join MarginTrading as mt on SDD.CID=mt.cid and SDD.PriceDate=mt.DataDate
left join DayTrading as dt on SDD.CID=dt.cid and SDD.PriceDate=dt.DataDate
left join temp_director_holdings as director on SDD.CID=director.CID and director.latest_date=1
left join temp_foreigninvest_holdings as foreigninvest on SDD.CID=foreigninvest.CID and foreigninvest.latest_date=1

Left join StockMonthlyData SMD_0 on Spi.CompanyID=SMD_0.CompanyID and YEAR(Spi.PriceDate)=SMD_0.Year and MONTH(Spi.PriceDate)= SMD_0.Month
Left join StockMonthlyData SMD_1 on Spi.CompanyID=SMD_1.CompanyID and  YEAR(DATEADD(month, -1, Spi.PriceDate))=SMD_1.Year and MONTH(DATEADD(month, -1, Spi.PriceDate))= SMD_1.Month
Left join StockMonthlyData SMD_2 on Spi.CompanyID=SMD_2.CompanyID and  YEAR(DATEADD(month, -2, Spi.PriceDate))=SMD_2.Year and MONTH(DATEADD(month, -2, Spi.PriceDate))= SMD_2.Month
Left join StockMonthlyData SMD_3 on Spi.CompanyID=SMD_3.CompanyID and  YEAR(DATEADD(month, -3, Spi.PriceDate))=SMD_3.Year and MONTH(DATEADD(month, -3, Spi.PriceDate))= SMD_3.Month
Left join StockMonthlyData SMD_4 on Spi.CompanyID=SMD_4.CompanyID and  YEAR(DATEADD(month, -4, Spi.PriceDate))=SMD_4.Year and MONTH(DATEADD(month, -4, Spi.PriceDate))= SMD_4.Month

LEFT OUTER JOIN temp_company_msalesYoY AS msales ON Com.CompanyID = msales.cid 
LEFT OUTER JOIN temp_company_pe AS pe ON SUBSTRING(Com.Symbol, 0, 5) = LTRIM(RTRIM(pe.symbol)) 

where Status=1 
--and ( ltrim(rtrim(Industry)) like N'%' + ltrim(rtrim(@Industry)) + '%' )
and ( ltrim(rtrim(Industry)) = N'' + ltrim(rtrim(@Industry)) + '' )
and SPI.PriceDate=@PriceDate
and SDD.Volume&gt;@Volume -- 中大量 10000 張
and ltrim(rtrim(Com.Symbol)) like '%'+ @MarketType
--and SPI.Close_Chg20&lt;10
--and SPI.Close_Chg60&lt;10
--and ((((Ins.ForeignInvest+Ins.InvestTrust+Ins.Dealer)/1000)/SDD.Volume)*100) &gt;1
--and (SPI.Day0_Dif&gt;0 or SPI.Day0_Macd&gt;0)
order by Close_Chg10 desc</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
