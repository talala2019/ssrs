                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=(Fields!DayHigh.Value-Fields!DayLow.Value)/Fields!DayLow.Value</Value>
                                  <Style>
                                    <FontFamily />
                                    <Format>0.00%</Format>
                                    <Color>#333333</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
