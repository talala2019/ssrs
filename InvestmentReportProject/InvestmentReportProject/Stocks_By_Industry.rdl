                    <TablixCell>
                      <CellContents>
                        <Textbox Name="Textbox59">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=Format(Fields!UpperSlope.Value, "#,#.0") + "  "</Value>
                                  <Style>
                                    <FontFamily>Tahoma</FontFamily>
                                    <FontSize>9pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                    <Color>=IIf(Fields!UpperSlope.Value&gt;0,"Red","DarkBlue")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
