                              <TextRuns>
                                <TextRun>
                                  <Value>=(Fields!Vol_MA20.Value/Fields!Capital.Value)*100</Value>
                                  <Style>
                                    <FontFamily />
                                    <Format>0.00</Format>
                                    <Color>#333333</Color>
                                  </Style>
