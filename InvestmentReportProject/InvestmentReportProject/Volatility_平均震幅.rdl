            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>交易</Value>
                    <Style>
                      <FontSize>16pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value>股期</Value>
                    <Style>
