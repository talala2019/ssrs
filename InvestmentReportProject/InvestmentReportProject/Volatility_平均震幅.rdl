<?xml version="1.0" encoding="utf-8"?>
<Report MustUnderstand="df" xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner" xmlns:df="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition/defaultfontfamily">
  <df:DefaultFontFamily>Segoe UI</df:DefaultFontFamily>
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="DataSource_localhost">
      <DataSourceReference>DataSource_localhost</DataSourceReference>
      <rd:SecurityType>None</rd:SecurityType>
      <rd:DataSourceID>5d8d3ed1-73cf-4076-b0ab-85dbc22f8840</rd:DataSourceID>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@PriceDate">
            <Value>=Parameters!PriceDate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Sector">
            <Value>=Parameters!Sector.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@symbol">
            <Value>=Parameters!symbol.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Industry">
            <Value>=Parameters!Industry.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@TurnOverRate">
            <Value>=Parameters!TurnOverRate.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@V_Avg3">
            <Value>=Parameters!V_Avg3.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@Volume">
            <Value>=Parameters!Volume.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@pid">
            <Value>=Parameters!pid.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>select Com.CompanyID, Com.ChtName, Com.Symbol, Com.Industry, SDD.PriceDate, SDD.DayClose, CONVERT(DECIMAL(10, 2),SPI.Close_Chg1) as 'CloseChg', 
SDD.Volume, Com.Capital,
CONVERT(DECIMAL(10, 2),(SDD.Volume/Com.Capital)/10) as 'TurnOverRate',
SPI.V_Avg1, SPI.V_Avg3, SPI.V_Avg5,
instilinvest.ForeignInvest, instilinvest.InvestTrust, instilinvest.Dealer, instilinvest.ForeignInvest_MA12, instilinvest.InvestTrust_MA12,
mt.MarginRmng, mt.PreMarginRmng, mt.ShortSellingRmng,
dt.Volume/1000 as 'DayTrade_Vol',
ComInfo.Pid
from Company as Com
inner join StockDailyData as SDD on Com.CompanyID=SDD.CompanyID
inner join StockPriceIndicator as SPI on SDD.CompanyID=SPI.CompanyID and SDD.PriceDate=SPI.PriceDate
left join CompanyInfo as ComInfo on Com.CompanyID=ComInfo.CompanyID
left join temp_company_instilinvest as instilinvest on Com.CompanyID=instilinvest.CID and instilinvest.DataDate=SDD.PriceDate
left join MarginTrading as mt on SDD.CompanyID=mt.cid and SDD.PriceDate=mt.DataDate
left join DayTrading as dt on SDD.CompanyID=dt.cid and SDD.PriceDate=dt.DataDate
where 
SDD.PriceDate=@PriceDate 
and Com.Capital&lt;&gt;0 
and Com.Symbol like '%'+ltrim(rtrim(@Sector))
and (Com.Symbol like '%'+ltrim(rtrim(@symbol))+'%' or Com.Chtname like N'%'+ltrim(rtrim(@symbol))+'%') 
and ( ltrim(rtrim(Com.Industry)) like N'%' + ltrim(rtrim(@Industry)) + '%' )
and ((SDD.Volume/Com.Capital)/10) &gt;= @TurnOverRate
and SPI.V_Avg3 &gt;= @V_Avg3
and SDD.Volume/1000 &gt; @Volume
AND (ComInfo.Pid LIKE '' + @pid + '%' )
order by SPI.V_Avg3 desc</CommandText>
        <rd:UseGenericDesigner>true</rd:UseGenericDesigner>
      </Query>
      <Fields>
        <Field Name="CompanyID">
          <DataField>CompanyID</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="ChtName">
          <DataField>ChtName</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
