        </Field>
        <Field Name="ShortSellingRmng">
          <DataField>ShortSellingRmng</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="DayTrade_Vol">
          <DataField>DayTrade_Vol</DataField>
          <rd:TypeName>System.Double</rd:TypeName>
        </Field>
        <Field Name="Pid">
          <DataField>Pid</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="PriceDateList">
      <Query>
        <DataSourceName>DataSource_localhost</DataSourceName>
        <CommandText>SELECT DISTINCT PriceDate
FROM  StockDailyData
WHERE (PriceDate &gt; GETDATE() - 30) 
and CompanyID=282
ORDER BY PriceDate Desc</CommandText>
      </Query>
      <Fields>
        <Field Name="PriceDate">
          <DataField>PriceDate</DataField>
          <rd:TypeName>System.DateTime</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
