Fields!InvestTrust.Value/(Fields!Volume.Value-Fields!DayTrade_Vol.Value)&lt;=-0.1,"LightGreen",
0=0,"White")</BackgroundColor>
                            <VerticalAlign>Middle</VerticalAlign>
