                            <Border>
                              <Color>LightGrey</Color>
                              <Style>Solid</Style>
                            </Border>
                            <BackgroundColor>=Switch(
((Fields!DayClose.Value / Fields!MA240.Value) - 1)*100&lt;=-30,"LightBlue",
((Fields!DayClose.Value / Fields!MA240.Value) - 1)*100&lt;=-20,"LightGreen",
((Fields!DayClose.Value / Fields!MA240.Value) - 1)*100&gt;=100,"Yellow",
((Fields!DayClose.Value / Fields!MA240.Value) - 1)*100&gt;=50,"Pink",
0=0,"White")</BackgroundColor>
