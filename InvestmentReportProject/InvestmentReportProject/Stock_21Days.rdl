                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=(Fields!ShortSellingRmng.Value / Fields!MarginRmng.Value)</Value>
                                  <Style>
                                    <FontFamily>Tahoma</FontFamily>
                                    <FontSize>9pt</FontSize>
                                    <FontWeight>=IIf((Fields!ShortSellingRmng.Value/Fields!MarginRmng.Value)&gt;0.30,"Bold","Default")</FontWeight>
                                    <Format>0.0%</Format>
                                    <Color>=IIf((Fields!ShortSellingRmng.Value/Fields!MarginRmng.Value)&gt;0.30,"Red","Black")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
