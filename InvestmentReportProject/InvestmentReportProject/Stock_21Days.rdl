                              <TextRuns>
                                <TextRun>
                                  <Value>=((Fields!DayClose.Value / Fields!MA240.Value) - 1)</Value>
                                  <Style>
                                    <FontWeight>Bold</FontWeight>
                                    <Format>0%</Format>
                                    <Color>=IIf(((Fields!DayClose.Value / Fields!MA240.Value) - 1)*100&gt;0,"Red","Green")</Color>
                                  </Style>
                                </TextRun>
                              </TextRuns>
                              <Style>
                                <TextAlign>Center</TextAlign>
                              </Style>
