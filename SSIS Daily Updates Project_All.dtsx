    <DTS:Executable
      DTS:refId="Package\Update IndustryDailyValue"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{8A19C374-22B9-4AF7-81A4-1923DFD24679}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Update IndustryDailyValue"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{045A71CF-CF00-4833-8C2C-09F66CE84933}"
          SQLTask:SqlStatementSource="delete IndustryDailyValue where PriceDate=?&#xA;&#xA;INSERT INTO IndustryDailyValue(IndustryID, PriceDate, MarketValue)&#xA;select IndusIndex.IndustryID, SDD.PriceDate, &#xA;CONVERT(DECIMAL(10, 2),Sum(Com.Capital*SDD.DayClose/1000000))&#xA;from Company as Com &#xA;inner join IndustryCompany as IndusCom on Com.CompanyID=IndusCom.CompanyID&#xA;inner join IndustryIndex as IndusIndex on IndusCom.IndustryID=IndusIndex.IndustryID&#xA;inner join StockDailyData as SDD on Com.CompanyID=SDD.CompanyID&#xA;where Com.Status=1&#xA;group by IndusIndex.IndustryID, SDD.PriceDate&#xA;having SDD.PriceDate=?" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::Data_Date"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::Data_Date"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Update StockMonthlyData"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{fb363c2c-d643-4f81-8a23-5259cc8e317b}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Update StockMonthlyData"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{045A71CF-CF00-4833-8C2C-09F66CE84933}"
          SQLTask:SqlStatementSource="&#xA;--必須先刪除2023/03之後資料&#xA;Delete StockMonthlyData where (Year&gt;=2023 and Month&gt;=03) or (Year&gt;=2024)&#xA;&#xA;--再重新加入2023/03之後資料,Group By Month&#xA;INSERT INTO StockMonthlyData(CompanyID, Year, Month, Stage, StageIndex, Signal, Volume)&#xA;SELECT CompanyID, YEAR(PriceDate) AS year_number, MONTH(PriceDate) AS month_number, '', 0, '', sum(Volume) AS month_volume&#xA;FROM StockDailyData where CompanyID in (select CompanyID from Company where CountryCode='TW' and (Symbol like '%.TW' or Symbol like '%.TWO') and Status=1 ) and PriceDate&gt;='2023-03-01'&#xA;GROUP BY  CompanyID, YEAR(PriceDate), MONTH(PriceDate)" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Update temp_company_pe"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
