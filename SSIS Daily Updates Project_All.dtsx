        <SQLTask:SqlTaskData
          SQLTask:Connection="{045A71CF-CF00-4833-8C2C-09F66CE84933}"
          SQLTask:SqlStatementSource="delete temp_company_pe" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
