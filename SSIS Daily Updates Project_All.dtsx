    <DTS:Executable
      DTS:refId="Package\Execute Update CompanySignalTracking"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{B6AF441C-EFA0-4B1A-9BEE-6602306FF410}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Execute Update CompanySignalTracking"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{045A71CF-CF00-4833-8C2C-09F66CE84933}"
          SQLTask:SqlStatementSource="delete CompanySignalTracking where PriceDate=? or PriceDate is null or PriceDate&lt;getdate()-360&#xA;&#xA;/*&#xA;將個股最後出現的箭頭訊號, 延續地紀錄在 CompanySignalTracking 的 Signal 和 Signal_StartDate&#xA;&#xA;例如 : 個股 05/01 出現黃箭頭, 之後都沒有出現任何箭頭訊號, &#xA;那該個股從05/01之後每一天的 Signal 都為 [黃], Signal_StartDate 都為 05/01&#xA;&#xA;Signal=[綠]或[藍]的股票,之前一定有出現過黃箭頭或紅箭頭&#xA;*/&#xA;&#xA;DECLARE @CID int&#xA;DECLARE @PriceDate date&#xA;DECLARE @Symbol nvarchar(50)&#xA;&#xA;DECLARE db_cursor CURSOR FOR SELECT CompanyID FROM Company &#xA;WHERE Status = 1 and CountryCode='TW'&#xA;order by CompanyID&#xA;&#xA;OPEN db_cursor &#xA;&#xA;FETCH NEXT FROM db_cursor INTO @CID  &#xA;&#xA;WHILE @@FETCH_STATUS = 0 BEGIN&#xA;&#xA;&#x9;select @Symbol=Symbol from Company where CompanyID=@CID&#xA;&#xA;&#x9;-- Loop #2 db_cursor=@dateCurSor from Trend_Tracking&#xA;&#x9;DECLARE date_cursor CURSOR FOR SELECT PriceDate from Trend_Tracking where CID=@CID order by PriceDate desc&#xA;&#x9;OPEN date_cursor &#xA;&#x9;FETCH NEXT FROM date_cursor INTO @PriceDate  &#xA;&#xA;&#x9;WHILE @@FETCH_STATUS = 0 BEGIN&#xA;&#xA;&#x9;&#x9;declare @status nvarchar(100)&#xA;&#x9;&#x9;set @status=''&#xA;&#xA;&#x9;&#x9;-- ****************** Insert into CompanyStatus if not exists ******************&#xA;&#x9;&#x9;if not exists ( select * from CompanySignalTracking where CompanyID=@CID and PriceDate=@PriceDate )&#xA;&#x9;&#x9;Begin&#xA;&#xA;&#x9;&#x9;&#x9;-- Insert records into CompanyStatus&#xA;&#x9;&#x9;&#x9;insert into CompanySignalTracking values(@CID, @PriceDate, @Symbol, @status,'1900-01-01')&#xA;&#x9;&#xA;&#x9;&#x9;&#x9;-- Set Data Start Date&#xA;&#x9;&#x9;&#x9;declare @data_StartDate date&#xA;&#x9;&#x9;&#x9;set @data_StartDate = getdate()-180&#xA;&#xA;&#x9;&#x9;&#x9;print '------'&#xA;&#x9;&#x9;&#x9;print @CID&#xA;&#x9;&#x9;&#x9;print @PriceDate&#xA;&#xA;&#x9;&#x9;&#x9;-- Status Start Date 開始日期&#xA;&#x9;&#x9;&#x9;declare @status_StartDate date&#xA;&#x9;&#x9;&#x9;declare @yellow_StartDate date&#xA;&#x9;&#x9;&#x9;declare @red_StartDate date&#xA;&#x9;&#x9;&#x9;declare @green_StartDate date&#xA;&#x9;&#x9;&#x9;declare @blue_StartDate date&#xA;&#xA;&#x9;&#x9;&#x9;set @status_StartDate ='1900-01-01'&#xA;&#x9;&#x9;&#x9;set @yellow_StartDate ='1900-01-01'&#xA;&#x9;&#x9;&#x9;set @red_StartDate ='1900-01-01'&#xA;&#x9;&#x9;&#x9;set @green_StartDate ='1900-01-01'&#xA;&#x9;&#x9;&#x9;set @blue_StartDate ='1900-01-01'&#xA;&#x9;&#xA;&#x9;&#x9;&#x9;--Check Trend_Tracking Table&#xA;&#x9;&#x9;&#x9;select @blue_StartDate=&#xA;&#x9;&#x9;&#x9;CASE&#xA;&#x9;&#x9;&#x9;&#x9;WHEN Max(TT.PriceDate) is null THEN '1900-01-01'&#xA;&#x9;&#x9;&#x9;&#x9;ELSE Max(TT.PriceDate)&#xA;&#x9;&#x9;&#x9;END&#xA;&#x9;&#x9;&#x9;from Trend_Tracking as TT &#xA;&#x9;&#x9;&#x9;where TT.CID=@CID and TT.PriceDate&gt;=@data_StartDate and TT.PriceDate&lt;=@PriceDate and ( ltrim(rtrim(TT.SignalType)) like N'%藍箭頭%' )&#x9;&#xA;&#xA;&#x9;&#x9;&#x9;select @green_StartDate=&#xA;&#x9;&#x9;&#x9;CASE&#xA;&#x9;&#x9;&#x9;&#x9;WHEN Max(TT.PriceDate) is null THEN '1900-01-01'&#xA;&#x9;&#x9;&#x9;&#x9;ELSE Max(TT.PriceDate)&#xA;&#x9;&#x9;&#x9;END&#xA;&#x9;&#x9;&#x9;from Trend_Tracking as TT &#xA;&#x9;&#x9;&#x9;where TT.CID=@CID and TT.PriceDate&gt;=@data_StartDate and TT.PriceDate&lt;=@PriceDate and ( ltrim(rtrim(TT.SignalType)) like N'%綠箭頭%' )&#xA;&#xA;&#x9;&#x9;&#x9;select @yellow_StartDate=&#xA;&#x9;&#x9;&#x9;CASE&#xA;&#x9;&#x9;&#x9;&#x9;WHEN Max(TT.PriceDate) is null THEN '1900-01-01'&#xA;&#x9;&#x9;&#x9;&#x9;ELSE Max(TT.PriceDate)&#xA;&#x9;&#x9;&#x9;END&#xA;&#x9;&#x9;&#x9;from Trend_Tracking as TT &#xA;&#x9;&#x9;&#x9;where TT.CID=@CID and TT.PriceDate&gt;=@data_StartDate and TT.PriceDate&lt;=@PriceDate and ( ltrim(rtrim(TT.SignalType)) like N'%黃箭頭%' )&#xA;&#xA;&#x9;&#x9;&#x9;select @red_StartDate=&#xA;&#x9;&#x9;&#x9;CASE&#xA;&#x9;&#x9;&#x9;&#x9;WHEN Max(TT.PriceDate) is null THEN '1900-01-01'&#xA;&#x9;&#x9;&#x9;&#x9;ELSE Max(TT.PriceDate)&#xA;&#x9;&#x9;&#x9;END&#xA;&#x9;&#x9;&#x9;from Trend_Tracking as TT &#xA;&#x9;&#x9;&#x9;where TT.CID=@CID and TT.PriceDate&gt;=@data_StartDate and TT.PriceDate&lt;=@PriceDate and ( ltrim(rtrim(TT.SignalType)) like N'%紅箭頭%' )&#xA;&#xA;&#x9;&#x9;&#x9;--print 'Blue start date:' + convert(varchar,@blue_StartDate,101)&#xA;&#x9;&#x9;&#x9;--print 'Green start date:' + convert(varchar,@green_StartDate,101) &#xA;&#x9;&#x9;&#x9;--print 'Yello start date:' + convert(varchar,@yellow_StartDate,101) &#xA;&#x9;&#x9;&#x9;--print 'Red start date:' + convert(varchar,@red_StartDate,101) &#xA;&#x9;&#xA;&#x9;&#x9;&#x9;-- Set Status 和 Status_StartDate&#xA;&#x9;&#x9;&#x9;if (@yellow_StartDate&gt;=@data_StartDate and @yellow_StartDate&gt;@red_StartDate and @yellow_StartDate&gt;@green_StartDate and @yellow_StartDate&gt;@blue_StartDate)&#xA;&#x9;&#x9;&#x9;begin&#xA;&#x9;&#x9;&#x9;&#x9;set @status = N'[黃]'&#xA;&#x9;&#x9;&#x9;&#x9;set @status_StartDate = @yellow_StartDate&#xA;&#x9;&#x9;&#x9;end&#xA;&#xA;&#x9;&#x9;&#x9;if (@red_StartDate&gt;=@data_StartDate and @red_StartDate&gt;@yellow_StartDate and @red_StartDate&gt;@green_StartDate and @red_StartDate&gt;@blue_StartDate)&#xA;&#x9;&#x9;&#x9;begin&#xA;&#x9;&#x9;&#x9;&#x9;set @status = N'[紅]'&#xA;&#x9;&#x9;&#x9;&#x9;set @status_StartDate = @red_StartDate&#xA;&#x9;&#x9;&#x9;end&#xA;&#x9;&#xA;&#x9;&#x9;&#x9;-- 必須加入之前有出現[黃箭頭][紅箭頭]的條件, 之後要注意出現[黃][紅]的起算時間&#xA;&#x9;&#x9;&#x9;if (@blue_StartDate&gt;=@data_StartDate and @blue_StartDate&gt;@yellow_StartDate and @blue_StartDate&gt;@red_StartDate and @blue_StartDate&gt;@green_StartDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;and (@yellow_StartDate&gt;=@data_StartDate or @red_StartDate&gt;=@data_StartDate) )&#xA;&#x9;&#x9;&#x9;begin&#xA;&#x9;&#x9;&#x9;&#x9;set @status = N'[藍]'&#xA;&#x9;&#x9;&#x9;&#x9;set @status_StartDate = @blue_StartDate&#xA;&#x9;&#x9;&#x9;end&#xA;&#x9;&#xA;&#x9;&#x9;&#x9;-- 必須加入之前有出現[黃箭頭][紅箭頭]的條件, 之後要注意出現[黃][紅]的起算時間&#xA;&#x9;&#x9;&#x9;if (@green_StartDate&gt;=@data_StartDate and @green_StartDate&gt;@red_StartDate and @green_StartDate&gt;@yellow_StartDate and @green_StartDate&gt;@blue_StartDate&#xA;&#x9;&#x9;&#x9;&#x9;and (@yellow_StartDate&gt;=@data_StartDate or @red_StartDate&gt;=@data_StartDate) )&#xA;&#x9;&#x9;&#x9;begin&#xA;&#x9;&#x9;&#x9;&#x9;set @status = N'[綠]'&#xA;&#x9;&#x9;&#x9;&#x9;set @status_StartDate = @green_StartDate&#xA;&#x9;&#x9;&#x9;end&#xA;&#xA;&#x9;&#x9;&#x9;--print '*** Update  CompanyStatus *** '&#xA;&#x9;&#x9;&#x9;--print @CID&#xA;&#x9;&#x9;&#x9;--print @status&#xA;&#x9;&#x9;&#x9;--print @status_StartDate&#xA;&#xA;&#x9;&#x9;&#x9;update CompanySignalTracking set Signal=@status, Signal_StartDate=@status_StartDate where CompanyID=@CID and PriceDate=@PriceDate&#xA;&#x9;&#x9;END&#xA;&#x9;&#x9;-- End of Insert into CompanyStatus if not exists ******************&#xA;&#xA;&#x9;FETCH NEXT FROM  date_cursor INTO @PriceDate&#xA;&#x9;END &#xA;&#x9;-- end of while loop #2 &#xA;  &#xA;&#x9;CLOSE date_cursor &#xA;&#x9;DEALLOCATE date_cursor&#xA;&#xA;&#xA;&#xA;FETCH NEXT FROM   db_cursor INTO @CID&#xA;END &#xA;&#xA;CLOSE db_cursor &#xA;DEALLOCATE db_cursor&#xA;&#xA;-- 多[0] 的 60日 平均漲幅 16%&#xA;--select sum(Close_Chg60)/count(*) from temp_company_spi where CompanyID in (&#xA;--select CompanyID from CompanyStatus where Status like N'%[0]%'&#xA;--) and PriceDate='2020-01-10'" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::Data_Date"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Execute Update CompanyStatus"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{993FFC87-3064-4E32-9F13-A30CA75FA508}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Execute Update CompanyStatus"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{045A71CF-CF00-4833-8C2C-09F66CE84933}"
          SQLTask:SqlStatementSource="delete CompanyStatus where PriceDate=? or PriceDate is null or&#xA;PriceDate&lt;getdate()-360&#xA;&#xA;/*&#xA;由 CompanySignalTracking 取得 [黃][紅][綠] 訊號日期, 找帶量紅K低點 帶量黑K高點&#xA;如果 [藍] 訊號, 則 Reset&#xA;*/&#xA;&#xA;DECLARE @CID int&#xA;DECLARE db_cursor CURSOR FOR SELECT CompanyID FROM Company WHERE Status = 1 and CountryCode='TW'&#xA;&#xA;OPEN db_cursor &#xA;&#xA;FETCH NEXT FROM db_cursor INTO @CID  &#xA;&#xA;WHILE @@FETCH_STATUS = 0 BEGIN&#xA;&#xA;&#x9;DECLARE @CurrentDate date&#xA;&#x9;DECLARE @Symbol nvarchar(50)&#xA;&#xA;&#x9;select top 1 @Symbol=Symbol, @CurrentDate=PriceDate from CompanySignalTracking where CompanyID=@CID order by PriceDate desc&#xA;&#xA;&#x9;-- Insert records into CompanyStatus if not exists&#xA;&#x9;If not exists ( select * from CompanyStatus where CompanyID=@CID and PriceDate=@CurrentDate) &#xA;&#x9;Begin&#xA;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;Insert into CompanyStatus values(@CID, @CurrentDate, @Symbol,  '', '1900-01-01',  0, '', '',  0, '', '')&#xA;&#xA;&#x9;&#x9;&#x9;Declare @YR_Date date&#xA;&#x9;&#x9;&#x9;Declare @Blue_Date date&#xA;&#xA;&#x9;&#x9;&#x9;set @YR_Date = '1900-01-01'&#xA;&#x9;&#x9;&#x9;set @Blue_Date = '1900-01-01'&#xA;&#xA;&#x9;&#x9;&#x9;select @YR_Date=Max(PriceDate) from CompanySignalTracking where CompanyID=@CID and  (Signal=N'[黃]' or Signal=N'[紅]')&#xA;&#x9;&#x9;&#x9;select @Blue_Date=Max(PriceDate) from CompanySignalTracking where CompanyID=@CID and (Signal=N'[藍]')&#xA;&#xA;&#x9;&#x9;&#x9;print N'[黃][紅] Date' &#xA;&#x9;&#x9;&#x9;print @YR_Date&#xA;&#xA;&#x9;&#x9;&#x9;print N'[藍] Date'&#xA;&#x9;&#x9;&#x9;print @Blue_Date&#xA;&#xA;&#x9;&#x9;&#x9;if(@YR_Date is null)&#xA;&#x9;&#x9;&#x9;&#x9;set @YR_Date = '1900-01-01'&#xA;&#x9;&#x9;&#x9;if(@Blue_Date is null)&#xA;&#x9;&#x9;&#x9;&#x9;set @Blue_Date = '1900-01-01'&#xA;&#xA;&#x9;&#x9;&#x9;-- [黃][紅] 出現在 [藍] 之後&#xA;&#x9;&#x9;&#x9;if(@YR_Date &gt; @Blue_Date and @YR_Date&gt;'1900-01-01') &#xA;&#x9;&#x9;&#x9;Begin&#xA;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;Declare @K_Low float&#xA;&#x9;&#x9;&#x9;&#x9;Declare @K_High float&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;set @K_Low=0&#xA;&#x9;&#x9;&#x9;&#x9;set @K_High=0&#xA;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;-- Loop #2 從 @CurrentDate 往回日期&#xA;&#x9;&#x9;&#x9;&#x9;DECLARE @PriceDate date&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;DECLARE date_cursor CURSOR FOR SELECT PriceDate from temp_company_sdd where CID=@CID and PriceDate&lt;=@CurrentDate order by PriceDate desc&#xA;&#x9;&#x9;&#x9;&#x9;OPEN date_cursor &#xA;&#x9;&#x9;&#x9;&#x9;FETCH NEXT FROM date_cursor INTO @PriceDate  &#xA;&#xA;&#x9;&#x9;&#x9;&#x9;WHILE @@FETCH_STATUS = 0 BEGIN&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;-- 取紅K低點&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;if( @K_Low=0 )&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;begin&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;select  @K_Low = SDD.DayLow from CompanySignalTracking as CST &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;inner join temp_company_sdd as SDD on CST.CompanyID=SDD.CID and CST.PriceDate=SDD.PriceDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;inner join temp_company_spi as SPI on CST.CompanyID=SPI.CompanyID and CST.PriceDate=SPI.PriceDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;where CST.CompanyID=@CID and CST.PriceDate=@PriceDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;--and (CST.Signal=N'[黃]' or  CST.Signal=N'[紅]' or  CST.Signal=N'[綠]')&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;and (((SDD.Volume/SDD.Vol_MA10&gt;1) and (SDD.DayClose-SDD.DayOpen&gt;0)) or (SPI.Close_Chg1&gt;4)) --帶量紅K or 漲幅&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;end&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;-- 取黑K高點&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;if( @K_High=0 )&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;begin&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;select  @K_High = SDD.DayHigh from CompanySignalTracking as CST &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;inner join temp_company_sdd as SDD on CST.CompanyID=SDD.CID and CST.PriceDate=SDD.PriceDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;inner join temp_company_spi as SPI on CST.CompanyID=SPI.CompanyID and CST.PriceDate=SPI.PriceDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;where CST.CompanyID=@CID and CST.PriceDate=@PriceDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;--and (CST.Signal=N'[黃]' or  CST.Signal=N'[紅]' or  CST.Signal=N'[綠]')&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;and (((SDD.Volume/SDD.Vol_MA10&gt;1) and (SDD.DayClose-SDD.DayOpen&lt;0)) or (SPI.Close_Chg1&lt;-3)) --帶量黑K or 跌幅&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;end&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;FETCH NEXT FROM  date_cursor INTO @PriceDate&#xA;&#x9;&#x9;&#x9;&#x9;END &#xA;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;CLOSE date_cursor &#xA;&#x9;&#x9;&#x9;&#x9;DEALLOCATE date_cursor&#xA;&#x9;&#x9;&#x9;&#x9;-- end of while loop #2 &#xA;&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;DECLARE @FallBelow_Low varchar(50)&#xA;&#x9;&#x9;&#x9;&#x9;DECLARE @Below_Low varchar(50)&#xA;&#x9;&#x9;&#x9;&#x9;DECLARE @BreakTh_High varchar(50)&#xA;&#x9;&#x9;&#x9;&#x9;DECLARE @Above_High varchar(50)&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;Set @FallBelow_Low = 'No'&#xA;&#x9;&#x9;&#x9;&#x9;Set @Below_Low = 'No'&#xA;&#x9;&#x9;&#x9;&#x9;Set @BreakTh_High = 'No'&#xA;&#x9;&#x9;&#x9;&#x9;Set @Above_High = 'No'&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;DECLARE @DayClose float&#xA;&#x9;&#x9;&#x9;&#x9;DECLARE @PreClose float&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;-- 當日和前一日收盤價&#xA;&#x9;&#x9;&#x9;&#x9;select @DayClose=DayClose, @PreClose=PreClose from temp_company_sdd where CID=@CID and PriceDate=@CurrentDate&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;-- 當日收盤價 &gt;= 黑K高點&#xA;&#x9;&#x9;&#x9;&#x9;if( @DayClose &gt;= @K_High )&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;Set @Above_High = 'Yes'&#xA;&#x9;&#x9;&#x9;&#x9;-- 當日收盤價突破黑K高點&#xA;&#x9;&#x9;&#x9;&#x9;if( @PreClose&lt;@K_High and @DayClose &gt;= @K_High )&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;Set @BreakTh_High = 'Yes'&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;-- 當日收盤價 &lt; 紅K低點&#xA;&#x9;&#x9;&#x9;&#x9;if( @DayClose &lt; @K_Low )&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;Set @Below_Low = 'Yes'&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;-- 當日收盤價跌破紅K低點&#xA;&#x9;&#x9;&#x9;&#x9;if( @DayClose &lt; @K_Low and @PreClose&gt;= @K_Low )&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;Set @FallBelow_Low = 'Yes'&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;Declare @Status nvarchar(100)&#xA;&#x9;&#x9;&#x9;&#x9;Declare @Status_StartDate date&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;-- [黃][紅] 起始日&#xA;&#x9;&#x9;&#x9;&#x9;select @Status=Signal, @Status_StartDate=Signal_StartDate from CompanySignalTracking where CompanyID=@CID and PriceDate=@YR_Date&#x9;&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;if(@Status=N'[黃]' or @Status=N'[紅]')&#xA;&#x9;&#x9;&#x9;&#x9;begin&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;set @Status = N'[多]'&#xA;&#x9;&#x9;&#x9;&#x9;end&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;-- Update K線 高低點&#xA;&#x9;&#x9;&#x9;&#x9;update CompanyStatus set Status=@Status, Status_StartDate=@Status_StartDate, K_Low=@K_Low, FallBelow_Low=@FallBelow_Low, Below_Low=@Below_Low, &#xA;&#x9;&#x9;&#x9;&#x9;K_High=@K_High, BreakTh_High=@BreakTh_High, Above_High=@Above_High where CompanyID=@CID and PriceDate=@CurrentDate&#xA;&#xA;&#x9;&#x9;&#x9;End -- end of if(@YR_Date &gt; @Blue_Date)&#x9;&#x9;&#xA;&#xA;&#x9;End -- end of If not exists&#xA;&#xA;FETCH NEXT FROM   db_cursor INTO @CID&#xA;END &#xA;&#xA;CLOSE db_cursor &#xA;DEALLOCATE db_cursor" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::Data_Date"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Execute Update DayTrading"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{D68A1165-C10F-416C-B444-4EFB048321C2}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Execute Update DayTrading"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{045A71CF-CF00-4833-8C2C-09F66CE84933}"
          SQLTask:SqlStatementSource="Delete DayTrading where symbol is null&#xA;&#xA;-- update DataDate column after insert data&#xA;Update DayTrading set DataDate=? where DataDate is null&#xA;&#xA;-- update CID after insert data&#xA;DECLARE @CID int&#xA;DECLARE @Symbol varchar(50)&#xA;&#xA;DECLARE db_cursor CURSOR FOR SELECT CompanyID FROM Company WHERE Status = 1 and CountryCode='TW'&#xA;&#xA;OPEN db_cursor &#xA;&#xA;FETCH NEXT FROM db_cursor INTO @CID  &#xA;&#xA;WHILE @@FETCH_STATUS = 0 BEGIN&#xA;&#xA;select @Symbol=Symbol from Company where CompanyID=@CID&#xA;&#xA;Update DayTrading set CID=@CID where  DataDate = ? and ltrim(rtrim(Symbol))=SUBSTRING(@Symbol,0,CHARINDEX('.TW', @Symbol)) and CID is null&#xA;&#xA;FETCH NEXT FROM   db_cursor INTO @CID&#xA;&#xA;END &#xA;&#xA;CLOSE db_cursor &#xA;&#xA;DEALLOCATE db_cursor&#xA;&#xA;Delete DayTrading where CID is null&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::Data_Date"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::Data_Date"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Execute Update InsInvest Running Cost"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{7B9649CF-7189-4E06-BF12-F944B942140C}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Execute Update InsInvest Running Cost"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{045A71CF-CF00-4833-8C2C-09F66CE84933}"
          SQLTask:SqlStatementSource="DECLARE @CID int&#xA;&#xA;--DECLARE db_cursor CURSOR FOR SELECT CID FROM &#xA;--InstitutionalInvest WHERE DataDate=? order by CID&#xA;&#xA;--成交金額大於2000萬&#xA;DECLARE db_cursor CURSOR FOR SELECT CID FROM InstitutionalInvest WHERE DataDate=? and CID in (&#xA;select CompanyID from Company where CountryCode='TW' and DLGroup&lt;&gt;0 and (CompanyID in (&#xA;select CompanyID from StockDailyData where PriceDate=? and Volume*((DayHigh+DayLow)/2)&gt;20000000&#xA;) or CompanyID in ( select CompanyID from PortfolioStock where PID in (28,33,38,58,63,68,81,82,83,85,86,87,88,89,112,116,117,118,119,120,121,122,123,124,125,126,127,128,129,130,131,132,133) )))&#xA;&#xA;OPEN db_cursor &#xA;&#xA;FETCH NEXT FROM db_cursor INTO @CID  &#xA;&#xA;WHILE @@FETCH_STATUS = 0 BEGIN&#xA;&#xA;&#xA;--////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;&#xA;--print @CID&#xA;&#xA;-- Var for ForeignInvest&#xA;DECLARE @ForeignInvest float&#xA;DECLARE @ForeignInvest_Sum float&#xA;DECLARE @ForeignInvest_StartDate date&#xA;DECLARE @ForeignInvest_RunningCost float&#xA;&#xA;set @ForeignInvest = 0&#xA;set @ForeignInvest_Sum = 0&#xA;set @ForeignInvest_RunningCost = 0&#xA;&#xA;-- Var for InvestTrust&#xA;DECLARE @InvestTrust float&#xA;DECLARE @InvestTrust_Sum float&#xA;DECLARE @InvestTrust_StartDate date&#xA;DECLARE @InvestTrust_RunningCost float&#xA;&#xA;set @InvestTrust = 0&#xA;set @InvestTrust_Sum = 0&#xA;set @InvestTrust_RunningCost = 0&#xA;&#xA;&#xA;-- Var for temp calculation&#xA;DECLARE @temp_fi_sum_var_1 float&#xA;DECLARE @temp_fi_sum_var_2 float&#xA;DECLARE @temp_it_sum_var_1 float&#xA;DECLARE @temp_it_sum_var_2 float&#xA;&#xA;Declare @data60_startdate datetime&#xA;--前 60 筆資料 的日期&#xA;select @data60_startdate=min(DataDate) from InstitutionalInvest where DataDate in (&#xA;select top 60 DataDate from InstitutionalInvest where CID=@CID order by DataDate desc )&#xA;&#xA;DECLARE @dateCurSor date&#xA;DECLARE ins_cursor CURSOR FOR SELECT datadate from InstitutionalInvest where CID=@CID and datadate&gt;=@data60_startdate order by DataDate&#xA;&#xA;OPEN ins_cursor &#xA;&#xA;FETCH NEXT FROM ins_cursor INTO @dateCurSor  &#xA;&#xA;-- set data first date as startdate&#xA;set @ForeignInvest_StartDate = @dateCurSor&#xA;set @InvestTrust_StartDate = @dateCurSor&#xA;&#xA;WHILE @@FETCH_STATUS = 0 BEGIN&#xA;&#xA;select @ForeignInvest = ForeignInvest/1000, @InvestTrust = InvestTrust/1000 from InstitutionalInvest where CID=@CID and DataDate=@dateCurSor&#xA;&#xA;set @ForeignInvest_Sum = @ForeignInvest_Sum + @ForeignInvest&#xA;set @InvestTrust_Sum = @InvestTrust_Sum + @InvestTrust&#xA;&#xA;-- Reset the sum and first date when the sum of foreign invest &lt; =0&#xA;If @ForeignInvest_Sum &lt; =0 &#xA;Begin&#xA;&#x9;set @ForeignInvest_Sum = @ForeignInvest&#xA;&#x9;set @ForeignInvest_StartDate = @dateCurSor&#xA;End&#xA;&#xA;-- Reset the sum and first date when the sum of invest trust &lt;= 0&#xA;If @InvestTrust_Sum &lt; =0 &#xA;Begin&#xA;&#x9;set @InvestTrust_Sum = @InvestTrust&#xA;&#x9;set @InvestTrust_StartDate = @dateCurSor&#xA;End&#xA;&#xA;-- Calculate the ForeignInvest Running Cost from the start date&#xA;If @ForeignInvest_Sum &gt; 0&#xA;Begin&#xA;&#x9;&#xA;&#x9;set @temp_fi_sum_var_1 = 0&#xA;&#x9;set @temp_fi_sum_var_2 = 0&#xA;&#xA;&#x9;select @temp_fi_sum_var_1=Sum(((DayOpen+DayClose)/2)*ForeignInvest), @temp_fi_sum_var_2=Sum(ForeignInvest) from temp_company_sdd  as A inner join &#xA;&#x9;InstitutionalInvest as B on A.CID=B.CID and A.PriceDate=B.DataDate and A.PriceDate&gt;=@ForeignInvest_StartDate and A.CID=@CID&#xA;&#xA;&#x9;-- check divide by zero&#xA;&#x9;if @temp_fi_sum_var_2 &gt; 0 &#xA;&#x9;Begin&#xA;&#x9;&#x9;set @ForeignInvest_RunningCost=@temp_fi_sum_var_1/@temp_fi_sum_var_2&#xA;&#x9;End&#xA;&#x9;Else&#xA;&#x9;Begin&#xA;&#x9;&#x9;set @ForeignInvest_RunningCost = 0&#xA;&#x9;End&#xA;&#xA;End&#xA;&#xA;-- Calculate the InvestTrust Running Cost from the start date&#xA;If @InvestTrust_Sum &gt; 0&#xA;Begin&#xA;&#xA;&#x9;set @temp_it_sum_var_1 = 0&#xA;&#x9;set @temp_it_sum_var_2 = 0&#xA;&#xA;&#x9;select @temp_it_sum_var_1=Sum(((DayOpen+DayClose)/2)*InvestTrust), @temp_it_sum_var_2=Sum(InvestTrust) from temp_company_sdd  as A inner join &#xA;&#x9;InstitutionalInvest as B on A.CID=B.CID and A.PriceDate=B.DataDate and A.PriceDate&gt;=@InvestTrust_StartDate and A.CID=@CID&#xA;&#xA;&#x9;if @temp_it_sum_var_2 &gt; 0&#xA;&#x9;Begin&#xA;&#x9;&#x9;set @InvestTrust_RunningCost = @temp_it_sum_var_1/@temp_it_sum_var_2&#xA;&#x9;End &#xA;&#x9;Else&#xA;&#x9;Begin&#xA;&#x9;&#x9;set @InvestTrust_RunningCost = 0&#xA;&#x9;End&#xA;End&#xA;&#xA;FETCH NEXT FROM   ins_cursor INTO @dateCurSor&#xA;&#xA;END &#xA;&#xA;CLOSE ins_cursor &#xA;&#xA;DEALLOCATE ins_cursor&#xA;&#xA;&#xA;update InstitutionalInvest set ForeignInvestCost=@ForeignInvest_RunningCost, ForeignInvestCostStartDate=@ForeignInvest_StartDate where CID=@CID and DataDate=?&#xA;&#xA;update InstitutionalInvest set InvestTrustCost=@InvestTrust_RunningCost, InvestTrustCostStartDate=@InvestTrust_StartDate where CID=@CID and DataDate=?&#xA;&#xA;&#xA;--////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////&#xA;&#xA;&#xA;&#xA;FETCH NEXT FROM   db_cursor INTO @CID&#xA;&#xA;END &#xA;&#xA;CLOSE db_cursor &#xA;&#xA;DEALLOCATE db_cursor&#xA;&#xA;Delete InstitutionalInvest where CID is null " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::Data_Date"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::Data_Date"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="2"
            SQLTask:DtsVariableName="User::Data_Date"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="3"
            SQLTask:DtsVariableName="User::Data_Date"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Execute Update InstitutionalInvest"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{1BC9D7A6-E29C-440B-9625-6890BE5C6AEC}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Execute Update InstitutionalInvest"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{045A71CF-CF00-4833-8C2C-09F66CE84933}"
          SQLTask:SqlStatementSource="Delete InstitutionalInvest where symbol is null&#xA;&#xA;Declare @MaxSeqNo int&#xA;select @MaxSeqNo=max(SeqNo) from InstitutionalInvest where DataDate is not null&#xA;&#xA;-- update DataDate column after insert data&#xA;Update InstitutionalInvest set DataDate=? where DataDate is null&#xA;&#xA;-- update CID after insert data&#xA;DECLARE @CID int&#xA;DECLARE @Symbol varchar(50)&#xA;DECLARE @BuySellRunningTotal float&#xA;DECLARE @MaxBuySellRunningTotal float&#xA;&#xA;DECLARE db_cursor CURSOR FOR SELECT CompanyID FROM Company WHERE Status=1 and CountryCode='TW'&#xA;&#xA;OPEN db_cursor &#xA;&#xA;FETCH NEXT FROM db_cursor INTO @CID  &#xA;&#xA;WHILE @@FETCH_STATUS = 0 BEGIN&#xA;&#xA;select @Symbol=Symbol from Company where CompanyID=@CID&#xA;&#xA;-- Update CID&#xA;Update InstitutionalInvest set CID=@CID where SeqNo&gt;@MaxSeqNo and DataDate = ? and ltrim(rtrim(Symbol))=SUBSTRING(@Symbol,0,CHARINDEX('.TW', @Symbol)) and CID is null &#xA;&#xA;-- Update BuySellRunningTotla for the latest date&#xA;set @BuySellRunningTotal = 0&#xA;set @MaxBuySellRunningTotal = 0&#xA;select @BuySellRunningTotal=Sum(BuySellTotal), @MaxBuySellRunningTotal=Max(BuySellRunningTotal) from InstitutionalInvest where CID=@CID and DataDate&lt;=?&#xA;update InstitutionalInvest set BuySellRunningTotal=@BuySellRunningTotal, MaxBuySellRunningTotal=@MaxBuySellRunningTotal where CID=@CID and DataDate=?&#xA;&#xA;&#xA;FETCH NEXT FROM   db_cursor INTO @CID&#xA;&#xA;END &#xA;&#xA;CLOSE db_cursor &#xA;&#xA;DEALLOCATE db_cursor&#xA;&#xA;Delete InstitutionalInvest where CID is null " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::Data_Date"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::Data_Date"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="2"
            SQLTask:DtsVariableName="User::Data_Date"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="3"
            SQLTask:DtsVariableName="User::Data_Date"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Execute Update MarginTrading"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{5D301EB7-B55C-40C2-B1CB-A6FEB13879F0}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Execute Update MarginTrading"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{045A71CF-CF00-4833-8C2C-09F66CE84933}"
          SQLTask:SqlStatementSource="Delete MarginTrading where symbol is null or len(symbol)=0&#xA;&#xA;-- update DataDate column after insert data&#xA;Update MarginTrading set DataDate=? where DataDate is null&#xA;&#xA;-- update CID after insert data&#xA;DECLARE @CID int&#xA;DECLARE @Symbol varchar(50)&#xA;&#xA;DECLARE db_cursor CURSOR FOR SELECT CompanyID FROM Company WHERE Status = 1 and CountryCode='TW'&#xA;&#xA;OPEN db_cursor &#xA;&#xA;FETCH NEXT FROM db_cursor INTO @CID  &#xA;&#xA;WHILE @@FETCH_STATUS = 0 BEGIN&#xA;&#xA;select @Symbol=Symbol from Company where CompanyID=@CID&#xA;&#xA;Update MarginTrading set CID=@CID where  DataDate = ? and ltrim(rtrim(Symbol))=SUBSTRING(@Symbol,0,CHARINDEX('.TW', @Symbol)) and CID is null&#xA;&#xA;FETCH NEXT FROM   db_cursor INTO @CID&#xA;&#xA;END &#xA;&#xA;CLOSE db_cursor &#xA;&#xA;DEALLOCATE db_cursor&#xA;&#xA;Delete MarginTrading where CID is null" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::Data_Date"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::Data_Date"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Execute Update Temp Company InsInvest"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{2F3CA122-9B7A-4A90-9988-F15AAC972422}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Execute Update Temp Company InsInvest"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{045A71CF-CF00-4833-8C2C-09F66CE84933}"
          SQLTask:SqlStatementSource="DELETE temp_company_instilinvest &#xA;&#xA;DECLARE @CID int &#xA;&#xA;DECLARE db_cursor CURSOR FOR SELECT CompanyID FROM Company WHERE Status = 1 and CountryCode='TW'&#xA;&#xA;OPEN db_cursor &#xA;&#xA;FETCH NEXT FROM   db_cursor INTO @CID &#xA;&#xA;WHILE @@FETCH_STATUS = 0 BEGIN&#xA;&#xA;INSERT INTO temp_company_instilinvest(CID, DataDate,&#xA;ForeignInvest, ForeignInvestCost, ForeignInvestCostStartDate, ForeignInvest_MA3, ForeignInvest_MA6, ForeignInvest_MA12, ForeignInvest_MA20, ForeignInvest_MA40, ForeignInvest_MA60, ForeignInvest_MA120,&#xA;InvestTrust, InvestTrustCost, InvestTrustCostStartDate, InvestTrust_MA3, InvestTrust_MA6, InvestTrust_MA12, InvestTrust_MA20, InvestTrust_MA40, InvestTrust_MA60, InvestTrust_MA120,&#xA;Dealer, Dealer_MA3, Dealer_MA6, Dealer_MA12, Dealer_MA20, Dealer_MA40, Dealer_MA60, Dealer_MA120,&#xA;BuySellTotal, BuySellTotal_MA3, BuySellTotal_MA6, BuySellTotal_MA12, BuySellTotal_MA20, BuySellTotal_MA40, BuySellTotal_MA60, BuySellTotal_MA120,&#xA;BuySellRunningTotal,&#xA;MaxBuySellRunningTotal&#xA;)&#xA;&#xA;SELECT TOP 90 CID, DataDate,&#xA;&#xA;ForeignInvest / 1000, &#xA;ForeignInvestCost, &#xA;ForeignInvestCostStartDate,&#xA;Cast(SUM(ForeignInvest / 1000) OVER (ORDER BY DataDate ASC ROWS 2 PRECEDING) AS DECIMAL(10, 0)) AS ForeignInvest_MA3, &#xA;Cast(SUM(ForeignInvest / 1000) OVER (ORDER BY DataDate ASC ROWS 5 PRECEDING) AS DECIMAL(10, 0)) AS ForeignInvest_MA6, &#xA;Cast(SUM(ForeignInvest / 1000) OVER (ORDER BY DataDate ASC ROWS 11 PRECEDING) AS DECIMAL(10, 0)) AS ForeignInvest_MA12, &#xA;Cast(SUM(ForeignInvest / 1000) OVER (ORDER BY DataDate ASC ROWS 19 PRECEDING) AS DECIMAL(10, 0)) AS ForeignInvest_MA20,&#xA;Cast(SUM(ForeignInvest / 1000) OVER (ORDER BY DataDate ASC ROWS 39 PRECEDING) AS DECIMAL(10, 0)) AS ForeignInvest_MA40,&#xA;Cast(SUM(ForeignInvest / 1000) OVER (ORDER BY DataDate ASC ROWS 59 PRECEDING) AS DECIMAL(10, 0)) AS ForeignInvest_MA60,&#xA;Cast(SUM(ForeignInvest / 1000) OVER (ORDER BY DataDate ASC ROWS 119 PRECEDING) AS DECIMAL(10, 0)) AS ForeignInvest_MA120,&#xA;&#xA;InvestTrust / 1000,&#xA;InvestTrustCost, &#xA;InvestTrustCostStartDate,&#xA;Cast(SUM(InvestTrust / 1000) OVER (ORDER BY DataDate ASC ROWS 2 PRECEDING) AS DECIMAL(10, 0)) AS InvestTrust_MA3, &#xA;Cast(SUM(InvestTrust / 1000) OVER (ORDER BY DataDate ASC ROWS 5 PRECEDING) AS DECIMAL(10, 0)) AS InvestTrust_MA6, &#xA;Cast(SUM(InvestTrust / 1000) OVER (ORDER BY DataDate ASC ROWS 11 PRECEDING) AS DECIMAL(10, 0)) AS InvestTrust_MA12, &#xA;Cast(SUM(InvestTrust / 1000) OVER (ORDER BY DataDate ASC ROWS 19 PRECEDING) AS DECIMAL(10, 0)) AS InvestTrust_MA20,&#xA;Cast(SUM(InvestTrust / 1000) OVER (ORDER BY DataDate ASC ROWS 39 PRECEDING) AS DECIMAL(10, 0)) AS InvestTrust_MA40,&#xA;Cast(SUM(InvestTrust / 1000) OVER (ORDER BY DataDate ASC ROWS 59 PRECEDING) AS DECIMAL(10, 0)) AS InvestTrust_MA60,&#xA;Cast(SUM(InvestTrust / 1000) OVER (ORDER BY DataDate ASC ROWS 119 PRECEDING) AS DECIMAL(10, 0)) AS InvestTrust_MA120,&#xA;&#xA;Dealer / 1000,&#xA;Cast(SUM(Dealer / 1000) OVER (ORDER BY DataDate ASC ROWS 2 PRECEDING) AS DECIMAL(10, 0)) AS Dealer_MA3, &#xA;Cast(SUM(Dealer / 1000) OVER (ORDER BY DataDate ASC ROWS 5 PRECEDING) AS DECIMAL(10, 0)) AS Dealer_MA6, &#xA;Cast(SUM(Dealer / 1000) OVER (ORDER BY DataDate ASC ROWS 11 PRECEDING) AS DECIMAL(10, 0)) AS Dealer_MA12, &#xA;Cast(SUM(Dealer / 1000) OVER (ORDER BY DataDate ASC ROWS 19 PRECEDING) AS DECIMAL(10, 0)) AS Dealer_MA20,&#xA;Cast(SUM(Dealer / 1000) OVER (ORDER BY DataDate ASC ROWS 39 PRECEDING) AS DECIMAL(10, 0)) AS Dealer_MA40,&#xA;Cast(SUM(Dealer / 1000) OVER (ORDER BY DataDate ASC ROWS 59 PRECEDING) AS DECIMAL(10, 0)) AS Dealer_MA60,&#xA;Cast(SUM(Dealer / 1000) OVER (ORDER BY DataDate ASC ROWS 119 PRECEDING) AS DECIMAL(10, 0)) AS Dealer_MA120,&#xA;&#xA;BuySellTotal / 1000,&#xA;Cast(SUM(BuySellTotal / 1000) OVER (ORDER BY DataDate ASC ROWS 2 PRECEDING) AS DECIMAL(10, 0)) AS BuySellTotal_MA3, &#xA;Cast(SUM(BuySellTotal / 1000) OVER (ORDER BY DataDate ASC ROWS 5 PRECEDING) AS DECIMAL(10, 0)) AS BuySellTotal_MA6, &#xA;Cast(SUM(BuySellTotal / 1000) OVER (ORDER BY DataDate ASC ROWS 11 PRECEDING) AS DECIMAL(10, 0)) AS BuySellTotal_MA12, &#xA;Cast(SUM(BuySellTotal / 1000) OVER (ORDER BY DataDate ASC ROWS 19 PRECEDING) AS DECIMAL(10, 0)) AS BuySellTotal_MA20,&#xA;Cast(SUM(BuySellTotal / 1000) OVER (ORDER BY DataDate ASC ROWS 39 PRECEDING) AS DECIMAL(10, 0)) AS BuySellTotal_MA40,&#xA;Cast(SUM(BuySellTotal / 1000) OVER (ORDER BY DataDate ASC ROWS 59 PRECEDING) AS DECIMAL(10, 0)) AS BuySellTotal_MA60,&#xA;Cast(SUM(BuySellTotal / 1000) OVER (ORDER BY DataDate ASC ROWS 119 PRECEDING) AS DECIMAL(10, 0)) AS BuySellTotal_MA120,&#xA;&#xA;-- New Added Column&#xA;BuySellRunningTotal / 1000,&#xA;MaxBuySellRunningTotal / 1000&#xA;&#xA;FROM   InstitutionalInvest WHERE CID = @CID AND DataDate &gt; (getdate() - 300)&#xA;ORDER BY DataDate DESC &#xA;&#xA;&#xA;FETCH NEXT FROM   db_cursor INTO @CID&#xA;&#xA;END &#xA;&#xA;CLOSE db_cursor &#xA;&#xA;DEALLOCATE db_cursor" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::Data_Date"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Execute Update TW Trend_Tracking"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{3791CE0F-FC7C-4405-950D-1C04BFC5BE5F}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Execute Update TW Trend_Tracking"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{045A71CF-CF00-4833-8C2C-09F66CE84933}"
          SQLTask:SqlStatementSource="delete Trend_Tracking where PriceDate=? or PriceDate is null or&#xA;PriceDate&lt;getdate()-360&#xA;&#xA;/*&#xA;File : Step1_Update_TrendTracking_V9&#xA;&#xA;1. 將 CompanyInfo table Capital 欄位整合到 Company table&#xA;&#xA;注意 Trend_Tracking talbe 的 Capital 欄位 單位和 Company table Capital 欄位 不同&#xA;&#xA;*/&#xA;&#xA;DECLARE @CID int&#xA;DECLARE @PriceDate date&#xA;DECLARE @Symbol nvarchar(50)&#xA;DECLARE @ChtName nvarchar(50)&#xA;DECLARE @Capital float&#xA;DECLARE @DayClose float&#xA;&#xA;DECLARE @ITRatio1 float -- 1 投本比&#xA;&#xA;DECLARE @FIRatio1 float&#xA;DECLARE @FIRatio3 float&#xA;DECLARE @FIRatio6 float&#xA;DECLARE @FIRatio12 float&#xA;DECLARE @FIRatio20 float&#xA;DECLARE @FIRatio60 float&#xA;&#xA;DECLARE @InvestTrustVol float&#xA;DECLARE @MarginVol float&#xA;DECLARE @Margin float&#xA;&#xA;DECLARE @BT_60DaysHigh int&#xA;DECLARE @BT_120DaysHigh int&#xA;DECLARE @Day0_W55 float&#xA;DECLARE @Volume float&#xA;DECLARE @WeekDMI int&#xA;DECLARE @WeekADX14 float&#xA;&#xA;DECLARE @Bar_Status nvarchar(50)&#xA;DECLARE @VolAvg3_Status nvarchar(50)&#xA;DECLARE @MA5_Status nvarchar(50)&#xA;DECLARE @MA20_Status nvarchar(50)&#xA;DECLARE @MA60_Status nvarchar(50)&#xA;&#xA;DECLARE @TrendTrackingSignal nvarchar(50)&#xA;DECLARE @SignalType nvarchar(50)&#xA;&#xA;DECLARE @PreSignalCount int&#xA;DECLARE @SignalCount int&#xA;&#xA;DECLARE @SignalDay int&#xA;DECLARE @AccCloseChg float &#xA;DECLARE @CloseChg float &#xA;DECLARE @AccFI1 float &#xA;DECLARE @MaxAccFI1Sell float&#xA;&#xA;DECLARE @MaxAccInvestTrustBuy float -- 投信最大連續買超&#xA;DECLARE @MaxAccInvestTrustBuyDay int -- 投信最大連續買超日數&#xA;&#xA;DECLARE @MaxFI12 float&#xA;DECLARE @MaxFI20 float &#xA;DECLARE @AccMargin1 float &#xA;DECLARE @MaxAccMargin1Sell float&#xA;&#xA;-- Loop #1 db_cursor=@CID from company&#xA;DECLARE cid_cursor CURSOR FOR select distinct CompanyID from Company &#xA;where &#xA;Status=1 &#xA;and CountryCode='TW'&#xA;and CompanyID in ( select distinct CompanyID from temp_company_swd )&#xA;and (&#xA;CompanyID in ( select distinct CompanyID from PortfolioStock where PID in (28, 33, 38, 58, 63, 68, 81, 82, 83, 85, 86, 87, 88, 89, 112, 116, 117, 118, 119, 120, 121, 122, 123, 124, 128, 129, 130, 131, 132, 133))&#xA;or CompanyID in ( select distinct CompanyID from CompanyStockFuture ))&#xA;order by CompanyID&#xA;&#xA;OPEN cid_cursor &#xA;FETCH NEXT FROM cid_cursor INTO @CID  &#xA;&#xA;WHILE @@FETCH_STATUS = 0 BEGIN&#xA;&#xA;   print ''&#xA;   print 'CID ******************************'&#xA;   print @CID&#xA;&#xA;/**************** Inside Loop Begin ****************/&#xA;-- Loop #2 date_cursor from StockDailyData&#xA;  DECLARE date_cursor CURSOR FOR SELECT PriceDate from StockDailyData where CompanyID=@CID and PriceDate&gt;=getdate()-90 order by PriceDate&#xA;  OPEN date_cursor &#xA;  FETCH NEXT FROM date_cursor INTO @PriceDate  &#xA;&#xA;  WHILE @@FETCH_STATUS = 0 BEGIN&#xA;&#xA;&#x9;&#x9;&#x9;Set @PreSignalCount=0&#xA;  &#x9;&#x9;&#x9;Set @SignalCount=0&#xA;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;Set @SignalDay=0&#xA;&#x9;&#x9;&#x9;Set @AccCloseChg=0&#xA;&#x9;&#x9;&#x9;Set @CloseChg=0 &#x9;&#xA;&#x9;&#x9;&#x9;Set @AccFI1=0 &#x9;&#x9;&#xA;&#x9;&#x9;&#x9;Set @MaxAccFI1Sell=0&#xA;&#xA;&#x9;&#x9;&#x9;Set @MaxAccInvestTrustBuy=0&#xA;&#x9;&#x9;&#x9;Set @MaxAccInvestTrustBuyDay=0&#xA;&#xA;&#x9;&#x9;&#x9;Set @MaxFI12=0&#xA;&#x9;&#x9;&#x9;Set @MaxFI20=0 &#xA;&#x9;&#x9;&#x9;Set @AccMargin1=0 &#xA;&#x9;&#x9;&#x9;Set @MaxAccMargin1Sell=0&#xA;&#xA;&#x9;&#x9;&#x9;--print ''&#xA;&#x9;&#x9;    &#x9;--print '&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt;&gt; ' + CONVERT(varchar, @PriceDate, 101 )&#xA;&#xA;&#x9;&#x9;  -- 取 @PriceDate 前一筆資料的數字&#xA;&#x9;&#x9;  select top 1 @PreSignalCount=SignalCount, @SignalDay=SignalDay, @AccCloseChg=AccCloseChg, @AccFI1=AccFI1, @MaxAccFI1Sell=MaxAccFI1Sell,&#xA;&#x9;&#x9;  @MaxAccInvestTrustBuy=MaxAccInvestTrustBuy, @MaxAccInvestTrustBuyDay=MaxAccInvestTrustBuyDay,&#xA;&#x9;&#x9;  @MaxFI12=MaxFI12, @MaxFI20=MaxFI20, @AccMargin1=AccMargin1, @MaxAccMargin1Sell=MaxAccMargin1Sell&#xA;&#x9;&#x9;  from Trend_Tracking where CID=@CID and PriceDate&lt;@PriceDate order by PriceDate desc&#xA;&#xA;&#x9;&#x9;  -- ****************** Insert into Trend_Tracking if not exists ******************&#xA;&#x9;&#x9;   if not exists ( select 1 from Trend_Tracking where CID=@CID and PriceDate=@PriceDate )&#xA;&#x9;&#x9;   Begin&#xA;&#x9;&#x9;   &#x9;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;set @Symbol=''&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;set @ChtName=''&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;set @Capital=0&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;set @DayClose=0&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;set @ITRatio1=0&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;set @FIRatio1=999&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;set @FIRatio3=999&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;set @FIRatio6=999&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;set @FIRatio12=999&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;set @FIRatio20=999&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;set @FIRatio60=999&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;set @InvestTrustVol=999&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;set @MarginVol=0&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;set @Margin=0&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;set @BT_60DaysHigh=999&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;set @BT_120DaysHigh=999&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;set @Day0_W55=999&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;set @Volume=0&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;set @WeekDMI=0&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;set @WeekADX14=0&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;set @Bar_Status=''&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;set @VolAvg3_Status=''&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;set @MA5_Status=''&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;set @MA20_Status=''&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;set @MA60_Status=''&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;set @TrendTrackingSignal=''&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;set @SignalType=''&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;-- 追蹤外投本比, 投量比, 創新高, W55 變化, 量能潮狀態, 均線狀態&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;select &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;@Symbol=Com.Symbol, &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;@ChtName=Com.chtname, &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;@Capital=CONVERT(DECIMAL(10,1),Capital/10000), -- 億&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;@DayClose=sdd.DayClose,&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;@CloseChg=spi.Close_Chg1,&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;@Bar_Status=spi.Day0_Bar_Status, --柱狀體&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;@VolAvg3_Status=spi.VolAvg3_Status, -- 量能潮狀態&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;@MA5_Status=spi.MA5_Status, -- 5日均線狀態&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;@MA20_Status=spi.MA20_Status,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;@MA60_Status=spi.MA60_Status,&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;-- 外投本比&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;@FIRatio1=CONVERT(DECIMAL(10,2),((ForeignInvest+InvestTrust)/Capital)*100),&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;@FIRatio3=CONVERT(DECIMAL(10,2),((ForeignInvest_MA3+InvestTrust_MA3)/Capital)*100),&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;@FIRatio6=CONVERT(DECIMAL(10,2),((ForeignInvest_MA6+InvestTrust_MA6)/Capital)*100),&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;@FIRatio12=CONVERT(DECIMAL(10,2),((ForeignInvest_MA12+InvestTrust_MA12)/Capital)*100),&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;@FIRatio20=CONVERT(DECIMAL(10,2),((ForeignInvest_MA20+InvestTrust_MA20)/Capital)*100),&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;@FIRatio60=CONVERT(DECIMAL(10,2),((ForeignInvest_MA60+InvestTrust_MA60)/Capital)*100),&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;-- 投本比&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;@ITRatio1=CONVERT(DECIMAL(10,2),((InvestTrust)/Capital)*100),&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;-- 投量比&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;@InvestTrustVol=&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;CASE   &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;  WHEN (sdd.Volume/1000)-(dt.Volume/1000) &lt;&gt; 0 THEN CONVERT(DECIMAL(10,2),(invest.InvestTrust/((sdd.Volume/1000)-(dt.Volume/1000)))*100)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;  ELSE 0&#xA;&#x9;&#x9;&#x9;&#x9;    END,   &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;-- 融資量比&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;@MarginVol=&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;CASE   &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;  WHEN (sdd.Volume/1000)-(dt.Volume/1000) &lt;&gt; 0 THEN CONVERT(DECIMAL(10,2),((mt.MarginRmng-mt.PreMarginRmng)/((sdd.Volume/1000)-(dt.Volume/1000)))*100)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;  ELSE 0&#xA;&#x9;&#x9;&#x9;&#x9;    END,   &#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;-- 融資張數&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;@Margin=&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;CASE   &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;  WHEN mt.MarginRmng-mt.PreMarginRmng is not null THEN mt.MarginRmng-mt.PreMarginRmng&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;  ELSE 0&#xA;&#x9;&#x9;&#x9;&#x9;    END,   &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;@BT_60DaysHigh=spi.BT_60DaysHigh, -- 創新高&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;@BT_120DaysHigh=spi.BT_120DaysHigh, -- 創新高&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;@Day0_W55=spi.Day0_W55,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;@Volume=CONVERT(DECIMAL(10,0),sdd.DayClose*sdd.Volume/1000), -- 成交量金額&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;@WeekDMI=swd.WeekDMI,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;@WeekADX14=swd.WeekADX14 &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;from Company as Com&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;inner join StockDailyData as sdd on Com.CompanyID=sdd.CompanyID and sdd.PriceDate=@PriceDate and sdd.CompanyID=@CID  &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;inner join StockPriceIndicator as spi on Com.CompanyID=spi.CompanyID and spi.PriceDate=@PriceDate and spi.CompanyID=@CID&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;left join temp_company_instilinvest as invest on Com.CompanyID=invest.CID and invest.DataDate=@PriceDate and invest.CID=@CID&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;left join DayTrading as dt on Com.CompanyID=dt.CID and dt.DataDate=@PriceDate and dt.CID=@CID&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;left join MarginTrading as mt on Com.CompanyID=mt.CID and mt.DataDate=@PriceDate and mt.CID=@CID&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;left join StockWeeklyData as swd on Com.CompanyID=swd.CompanyID and swd.EndDate=@PriceDate and swd.CompanyID=@CID&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;where Capital&lt;&gt;0 and sdd.Volume&lt;&gt;0&#xA;   &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;-- *** Part 1 : Update TrendTrackingSignal&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;if @Capital&lt;&gt;0&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;Begin&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; -- Insert new records into Trend_Tracking&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; Insert into Trend_Tracking (CID, Symbol, ChtName, Capital, DayClose, TrendTrackingSignal, Bar_Status, VolAvg3_Status, MA5_Status, MA20_Status, MA60_Status, WeekDMI, WeekADX14, PriceDate, Volume, NewHighCount, WeekDMICount, &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; SignalCount, SignalDay, AccCloseChg, AccFI1, MaxAccFI1Sell, MaxAccInvestTrustBuy, MaxAccInvestTrustBuyDay, MaxFI12, MaxFI20, AccMargin1, MaxAccMargin1Sell, SignalType)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; Values(@CID,@Symbol,@ChtName, @Capital, @DayClose, @TrendTrackingSignal, @Bar_Status, @VolAvg3_Status, @MA5_Status, @MA20_Status, @MA60_Status, @WeekDMI, @WeekADX14, @PriceDate, @Volume, 0, 0, &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; @PreSignalCount, @SignalDay, @AccCloseChg, @AccFI1, @MaxAccFI1Sell, @MaxAccInvestTrustBuy, @MaxAccInvestTrustBuyDay, @MaxFI12, @MaxFI20, @AccMargin1, @MaxAccMargin1Sell, @SignalType)&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; print 'insert into Trend_Tracking'&#xA;&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; /****************************** 多頭加分條件 ******************************/&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  -- 3外投本比 6外投本比&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  if @FIRatio3&gt;=3 and @FIRatio6&gt;=3&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  begin&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @TrendTrackingSignal = @TrendTrackingSignal+'AA'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;--update Trend_Tracking set TrendTrackingSignal=TrendTrackingSignal+'AA' where CID=@CID and PriceDate=@PriceDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  end&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  else if @FIRatio3&gt;=1 and @FIRatio6&gt;=1&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  begin&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @TrendTrackingSignal = @TrendTrackingSignal+'A'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;--update Trend_Tracking set TrendTrackingSignal=TrendTrackingSignal+'A' where CID=@CID and PriceDate=@PriceDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  end&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  -- 6外投本比 12外投本比&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  if @FIRatio6&gt;=2.5 and @FIRatio12&gt;=4&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  begin&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @TrendTrackingSignal = @TrendTrackingSignal+'AA'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;--update Trend_Tracking set TrendTrackingSignal=TrendTrackingSignal+'AA' where CID=@CID and PriceDate=@PriceDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  end &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  else if @FIRatio6&gt;=1.2 and @FIRatio12&gt;=1.95&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  begin&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @TrendTrackingSignal = @TrendTrackingSignal+'A'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;--update Trend_Tracking set TrendTrackingSignal=TrendTrackingSignal+'A' where CID=@CID and PriceDate=@PriceDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  end   &#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  -- 外投本比 3A&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  if @FIRatio3&gt;=2 and @FIRatio6&gt;=3 and @FIRatio12&gt;=4 and @FIRatio20&gt;=5&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  begin&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @TrendTrackingSignal = @TrendTrackingSignal+'AAA'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;--update Trend_Tracking set TrendTrackingSignal=TrendTrackingSignal+'AAA' where CID=@CID and PriceDate=@PriceDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  end&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  -- 投量比 3A 2A 1A&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  if @InvestTrustVol&gt;=24&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  begin&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @TrendTrackingSignal = @TrendTrackingSignal+'AAA'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;--update Trend_Tracking set TrendTrackingSignal=TrendTrackingSignal+'AAA' where CID=@CID and PriceDate=@PriceDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  end&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  else if @InvestTrustVol&gt;=16&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  begin&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @TrendTrackingSignal = @TrendTrackingSignal+'AA'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;--update Trend_Tracking set TrendTrackingSignal=TrendTrackingSignal+'AA' where CID=@CID and PriceDate=@PriceDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  end&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  else if @InvestTrustVol&gt;=8&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  begin&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @TrendTrackingSignal = @TrendTrackingSignal+'A'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;--update Trend_Tracking set TrendTrackingSignal=TrendTrackingSignal+'A' where CID=@CID and PriceDate=@PriceDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  end&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  -- 當股本&gt;=100億 降低 外投本比 投量比 數值&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  if @Capital &gt;= 100&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  Begin&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;   if @FIRatio6&gt;=0.5 and @FIRatio12&gt;=0.8 and @FIRatio20&gt;=1&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;   begin&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @TrendTrackingSignal = @TrendTrackingSignal+'AA'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;--update Trend_Tracking set TrendTrackingSignal=TrendTrackingSignal+'AA' where CID=@CID and PriceDate=@PriceDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;   end&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;   if @FIRatio20&gt;=1 and @FIRatio60&gt;=2&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;   begin&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @TrendTrackingSignal = @TrendTrackingSignal+'A'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;--update Trend_Tracking set TrendTrackingSignal=TrendTrackingSignal+'A' where CID=@CID and PriceDate=@PriceDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;   end&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;   if @InvestTrustVol&gt;=5&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;   begin&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @TrendTrackingSignal = @TrendTrackingSignal+'AA'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;--update Trend_Tracking set TrendTrackingSignal=TrendTrackingSignal+'AA' where CID=@CID and PriceDate=@PriceDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;   end&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;   else&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;   if @InvestTrustVol&gt;=3&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;   begin&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @TrendTrackingSignal = @TrendTrackingSignal+'A'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;--update Trend_Tracking set TrendTrackingSignal=TrendTrackingSignal+'A' where CID=@CID and PriceDate=@PriceDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;   end&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  End -- end of 股本&gt;=100億&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  -- 創6個月新高&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  if @BT_120DaysHigh=1&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  begin&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @TrendTrackingSignal = @TrendTrackingSignal+'H'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;--update Trend_Tracking set TrendTrackingSignal=TrendTrackingSignal+'H' where CID=@CID and PriceDate=@PriceDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  end&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; /****************************** 多頭減分條件 ******************************/&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  -- 3外投本比 1X&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  if @FIRatio3&lt;=-1&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  begin&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @TrendTrackingSignal = @TrendTrackingSignal+'X'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;--update Trend_Tracking set TrendTrackingSignal=TrendTrackingSignal+'X' where CID=@CID and PriceDate=@PriceDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  end&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  -- 6外投本比 1X&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  if @FIRatio6&lt;=-1&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  begin&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @TrendTrackingSignal = @TrendTrackingSignal+'X'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;--update Trend_Tracking set TrendTrackingSignal=TrendTrackingSignal+'X' where CID=@CID and PriceDate=@PriceDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  end&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  -- 12外投本比 1X&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  if @FIRatio12&lt;=-1.2&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  begin&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @TrendTrackingSignal = @TrendTrackingSignal+'X'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;--update Trend_Tracking set TrendTrackingSignal=TrendTrackingSignal+'X' where CID=@CID and PriceDate=@PriceDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  end&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  -- 3外投本比 6外投本比 2X&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  if @FIRatio3&lt;=-2 and @FIRatio6&lt;=-2&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  begin&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @TrendTrackingSignal = @TrendTrackingSignal+'XXX'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;--update Trend_Tracking set TrendTrackingSignal=TrendTrackingSignal+'XX' where CID=@CID and PriceDate=@PriceDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  end&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  -- 投量比 3X 2X 1X&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  if @InvestTrustVol&lt;=-24&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  begin&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @TrendTrackingSignal = @TrendTrackingSignal+'XXX'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;--update Trend_Tracking set TrendTrackingSignal=TrendTrackingSignal+'XXX' where CID=@CID and PriceDate=@PriceDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  end&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  else&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  if @InvestTrustVol&lt;=-16&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  begin&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @TrendTrackingSignal = @TrendTrackingSignal+'XX'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;--update Trend_Tracking set TrendTrackingSignal=TrendTrackingSignal+'XX' where CID=@CID and PriceDate=@PriceDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  end&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  else&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  if @InvestTrustVol&lt;=-8&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  begin&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @TrendTrackingSignal = @TrendTrackingSignal+'X'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;--update Trend_Tracking set TrendTrackingSignal=TrendTrackingSignal+'X' where CID=@CID and PriceDate=@PriceDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  end&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;   -- 股本&gt;=100億&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  if @Capital &gt;= 100&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  Begin&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;   if @FIRatio6&lt;=-0.5 and @FIRatio12&lt;=-0.8 and @FIRatio20&lt;=-1&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;   begin&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @TrendTrackingSignal = @TrendTrackingSignal+'XX'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;--update Trend_Tracking set TrendTrackingSignal=TrendTrackingSignal+'XX' where CID=@CID and PriceDate=@PriceDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;   end&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;   if @FIRatio20&lt;=-1 and @FIRatio60&lt;=-2&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;   begin&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @TrendTrackingSignal = @TrendTrackingSignal+'X'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;--update Trend_Tracking set TrendTrackingSignal=TrendTrackingSignal+'X' where CID=@CID and PriceDate=@PriceDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;   end&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;   if @InvestTrustVol&lt;=-5&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;   begin&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @TrendTrackingSignal = @TrendTrackingSignal+'XX'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;--update Trend_Tracking set TrendTrackingSignal=TrendTrackingSignal+'XX' where CID=@CID and PriceDate=@PriceDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;   end&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;   else&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;   if @InvestTrustVol&lt;=-3&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;   begin&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @TrendTrackingSignal = @TrendTrackingSignal+'X'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;--update Trend_Tracking set TrendTrackingSignal=TrendTrackingSignal+'X' where CID=@CID and PriceDate=@PriceDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;   end&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  End -- end of 股本&gt;=100億&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  -- W55見傅姍姍 1X&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  if @Day0_W55&lt;66&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  begin&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @TrendTrackingSignal = @TrendTrackingSignal+'W'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;--update Trend_Tracking set TrendTrackingSignal=TrendTrackingSignal+'W' where CID=@CID and PriceDate=@PriceDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;  end&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;End -- end of if @Capital&lt;&gt;0&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;update Trend_Tracking set TrendTrackingSignal=@TrendTrackingSignal where CID=@CID and PriceDate=@PriceDate&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;-- *** End of Part 1 : Update TrendTrackingSignal&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;print 'Part 1 Update Done'&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;-- *** Part 2 : Update SignalType 和 SignalCount 次數&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;-- ****** 黃箭頭 for 中大量 ******&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;if exists (&#x9;select 1 from temp_company_spi as SPI inner join temp_company_sdd as SDD on SPI.CompanyID=SDD.CID and SPI.PriceDate=SDD.PriceDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;where SPI.CompanyID=@CID and SPI.PriceDate=@PriceDate &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;and ( SPI.Days_CloseOnMa5&gt;=0 and (SPI.MA5_Status like N'%轉上%' or SPI.MA5_Status like N'%向上%')) -- 均線&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;and ( SPI.Day0_Bar&gt;-0.5 ) -- 柱狀體值&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;and ( (SPI.Day0_Bar_Status like N'%轉上%') or (SPI.Day0_Bar_Status like N'%向上%') ) -- 柱狀體&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;and ( (SPI.Day0_K&gt;SPI.Day0_D and SPI.Day0_K-SPI.Day1_K&gt;=3) or (SPI.Close_Chg1&gt;=3) or (SPI.Close_Chg1&gt;0 and SPI.Close_Chg3&gt;=5)) -- KD值 or 漲幅&#x9;&#x9;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;and ( (SPI.Days_VolMa3OnMa15&lt;=-6) or (SPI.Day1_Days_VolMa3OnMa15&lt;=-5) or ((SPI.Days_VolMa3OnMa15&lt;=3 and (SDD.Vol_MA3/SDD.Vol_MA15&gt;=3.5)))) -- 量縮 5 天以上 or 特別攻擊量 *&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;and ( (SDD.Volume/SDD.Vol_MA10&gt;1) or (SDD.Volume&gt;=SPI.Day1_Vol*1.6) or (SDD.Vol_MA3&gt;=SPI.Day1_VolMa3*1.8) ) -- 量增&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;and ( SDD.DayClose*SDD.Volume&gt;15000 ) -- 中大量&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;and ( @FIRatio1&gt;=0.5 or @FIRatio6&gt;=0.3 or @FIRatio12&gt;=0.3 or @FIRatio20&gt;=0.1 or &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;(@FIRatio1&gt;=0 and @FIRatio60&gt;=0) or (@InvestTrustVol&gt;=10 and @FIRatio1&gt;0) or @MarginVol&gt;=20 ) -- 籌碼&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;and ( @FIRatio12&gt;-1 ) -- 籌碼&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;) &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;Begin&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; set @SignalType=N'黃箭頭'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; set @SignalCount=1&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;End&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;-- ****** 紅箭頭 for 中大量  ******&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;if exists (&#x9;select 1 from temp_company_spi as SPI inner join temp_company_sdd as SDD on SPI.CompanyID=SDD.CID and SPI.PriceDate=SDD.PriceDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;where SPI.CompanyID=@CID and SPI.PriceDate=@PriceDate &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;and ( SPI.Days_CloseOnMa5&gt;=0 and (SPI.MA5_Status like N'%轉上%' or SPI.MA5_Status like N'%向上%')) -- 均線&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;and ( SPI.Day0_Bar&gt;0 and (SPI.Day0_Bar_Status like N'%轉上%' or SPI.Day0_Bar_Status like N'%向上%')) -- 柱狀體&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;and ( (SPI.Day0_K&gt;=50 and SPI.Day0_D&gt;=50 and SPI.Day0_K&gt;SPI.Day0_D and SPI.Day0_K&gt;SPI.Day1_K) or ( SPI.Close_Chg1&gt;=3 ) or (SPI.Close_Chg1&gt;0 and SPI.Close_Chg3&gt;=5)) -- KD值 or 漲幅&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;and ( SPI.Close_Chg1&gt;=0 ) -- 單日漲幅&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;and ( SDD.DayClose*SDD.Volume&gt;15000 ) -- 中大量&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;and ( (SDD.Volume/SDD.Vol_MA10&gt;1) or (SDD.Volume&gt;=SPI.Day1_Vol*2.3) or (SDD.Volume&gt;=SPI.Day1_VolMa3*1.8) or (SDD.Vol_MA3/SDD.Vol_MA15&gt;=1.6) ) -- 量增&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;and ( SPI.VolAvg3_Status like N'%轉上%' or SPI.VolAvg3_Status like N'%突破%' or SPI.VolAvg3_Status like N'%增加%' ) -- 量能潮&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;and ( @FIRatio1&gt;=1 or @FIRatio6&gt;=1 or @FIRatio12&gt;=1 or (@InvestTrustVol&gt;=10 and @FIRatio1&gt;0) or @MarginVol&gt;=20) -- 籌碼&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;and ( @FIRatio12&gt;-1 ) -- 籌碼&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;) &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;Begin&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @SignalType=N'紅箭頭'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @SignalCount=1&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;End&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;-- ****** 綠箭頭 (平倉)  ******&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;if exists (&#x9;select 1 from temp_company_spi as SPI inner join temp_company_sdd as SDD on SPI.CompanyID=SDD.CID and SPI.PriceDate=SDD.PriceDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;where SPI.CompanyID=@CID and SPI.PriceDate=@PriceDate &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;and SPI.DayClose&lt;(((sdd.MA11*11)- SPI.DayClose)/10) --跌破 MA11 *&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;Begin&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @SignalType=N'綠箭頭'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @SignalCount=0&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;End&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;-- ****** 藍箭頭 (空頭)  ******&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;--線型轉空&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;if exists (&#x9;select 1 from temp_company_spi as SPI inner join temp_company_sdd as SDD on SPI.CompanyID=SDD.CID and SPI.PriceDate=SDD.PriceDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;where SPI.CompanyID=@CID and SPI.PriceDate=@PriceDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;and ( SPI.DayClose&lt; ((sdd.MA11*11)- SPI.DayClose)/10 ) --跌破 MA11&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;and ( SPI.DayClose&lt;sdd.MA20 ) --跌破 MA20&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;and ( SPI.MA5_Status like N'%轉下%' or SPI.MA5_Status like N'%向下%' ) -- MA5向下&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;and ( SPI.MA20_Status like N'%轉下%' or SPI.MA20_Status like N'%向下%' ) --MA20向下&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;and ( SPI.MA42_Status like N'%轉下%' or SPI.MA42_Status like N'%向下%' ) --MA42向下 *&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;and ( SPI.MA60_Status like N'%轉下%' or SPI.MA60_Status like N'%向下%' ) --MA60向下&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;Begin&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @SignalType=N'藍箭頭'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @SignalCount=0&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;End&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;--籌碼轉空&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;if exists (&#x9;select 1 from temp_company_spi as SPI inner join temp_company_sdd as SDD on SPI.CompanyID=SDD.CID and SPI.PriceDate=SDD.PriceDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;where SPI.CompanyID=@CID and SPI.PriceDate=@PriceDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;and ( SPI.DayClose&lt; ((sdd.MA11*11)- SPI.DayClose)/10 ) --跌破 MA11&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;and ( SPI.DayClose&lt;sdd.MA20 ) --跌破 MA20&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;and ( SPI.MA5_Status like N'%轉下%' or SPI.MA5_Status like N'%向下%' ) -- MA5向下&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;and ( (@FIRatio1&lt;=-1.2 and @FIRatio6&lt;=-1.2 and @FIRatio12&lt;=-1.2) or (@InvestTrustVol&lt;=-15 and @FIRatio1&lt;=-1) ) -- 籌碼大賣&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;Begin&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @SignalType=N'藍箭頭'&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @SignalCount=0&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;End&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;-- 最後 Update SignalType 和 SignalCount 次數&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;if( @SignalType=N'藍箭頭' ) &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;update Trend_Tracking set SignalType=@SignalType, SignalCount=0 where CID=@CID and PriceDate=@PriceDate&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;else&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;update Trend_Tracking set SignalType=@SignalType, SignalCount=SignalCount+@SignalCount where CID=@CID and PriceDate=@PriceDate&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;-- *** End of Part 2 : Update 黃箭頭 紅箭頭 &#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;print 'Part 2 Update Done'&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;-- *** Part 3 : 當 SignalCount&gt;0 更新 SignalCount 之外的計數&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;if exists ( select 1 from Trend_Tracking where CID=@CID and PriceDate=@PriceDate and SignalCount&gt;0)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;Begin&#x9;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; -- 期間外投最大累計賣超&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; Declare @tempMaxAccFI1Sell float&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; set @tempMaxAccFI1Sell=0&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; if( @FIRatio1 &lt; 0  or @MaxAccFI1Sell + @FIRatio1 &lt; 0 )&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @tempMaxAccFI1Sell = CONVERT(DECIMAL(10,2),@MaxAccFI1Sell + @FIRatio1)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; else&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @tempMaxAccFI1Sell = 0&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; -- 期間投信最大累計買超&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; Declare @tempMaxAccInvestTrustBuy float&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; Declare @tempMaxAccInvestTrustBuyDay int&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; set @tempMaxAccInvestTrustBuy=0&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; set @tempMaxAccInvestTrustBuyDay=0&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; if( @MaxAccInvestTrustBuy &gt; 0  or @MaxAccInvestTrustBuy + @ITRatio1 &gt; 0 )&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; begin&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @tempMaxAccInvestTrustBuy = CONVERT(DECIMAL(10,2),@MaxAccInvestTrustBuy + @ITRatio1)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @tempMaxAccInvestTrustBuyDay = @MaxAccInvestTrustBuyDay + 1;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; end&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; else&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; begin&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @tempMaxAccInvestTrustBuy = 0&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @tempMaxAccInvestTrustBuyDay = 0&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; end&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;-- 期間最大 12外投本比&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;if( @FIRatio12 &gt; @MaxFI12 )&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @MaxFI12 = @FIRatio12&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;-- 期間最大 20外投本比&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;if( @FIRatio20 &gt; @MaxFI20 )&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @MaxFI20 = @FIRatio20&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; -- 期間最大累計融資賣超&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; Declare @tempMaxAccMargin1Sell float&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; set @tempMaxAccMargin1Sell=0&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; if( @MaxAccMargin1Sell + @Margin &lt; @MaxAccMargin1Sell  or @MaxAccMargin1Sell + @Margin &lt; 0 )&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @tempMaxAccMargin1Sell = CONVERT(DECIMAL(10,2),@MaxAccMargin1Sell + @Margin)&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; else&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;set @tempMaxAccMargin1Sell = 0&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; update Trend_Tracking set SignalDay=SignalDay+1, AccCloseChg=CONVERT(DECIMAL(10,2),AccCloseChg+@CloseChg), &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; AccFI1=CONVERT(DECIMAL(10,2),AccFI1+@FIRatio1), MaxAccFI1Sell=@tempMaxAccFI1Sell,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; MaxAccInvestTrustBuy=@tempMaxAccInvestTrustBuy,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; MaxAccInvestTrustBuyDay=@tempMaxAccInvestTrustBuyDay,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; MaxFI12=@MaxFI12, MaxFI20=@MaxFI20,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; AccMargin1=AccMargin1+@Margin,&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; MaxAccMargin1Sell=@tempMaxAccMargin1Sell&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; where CID=@CID and PriceDate=@PriceDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;End&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;else&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;Begin&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; -- 當SignalCount=0, Reset 各個計數  &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9; update Trend_Tracking set SignalDay=0, AccCloseChg=0, AccFI1=0, MaxAccFI1Sell=0,  MaxAccInvestTrustBuy=0, MaxAccInvestTrustBuyDay=0, MaxFI12=0, MaxFI20=0, AccMargin1=0, MaxAccMargin1Sell=0 where CID=@CID and PriceDate=@PriceDate&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;End&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;-- *** End of Part 3&#xA;&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;print 'Part 3 Update Done'&#xA;&#x9;&#x9;   End &#xA;&#x9;&#x9;  -- End of Insert into Trend_Tracking if not exists ******************&#xA;&#xA;  FETCH NEXT FROM  date_cursor INTO @PriceDate&#xA;  END &#xA;-- end of while loop #2 &#xA;  &#xA;  CLOSE date_cursor &#xA;  DEALLOCATE date_cursor&#xA;&#xA;&#xA;/**************** Inside Loop End ****************/&#xA;&#xA;FETCH NEXT FROM   cid_cursor INTO @CID&#xA;&#xA;END &#xA;-- end of while loop #1 &#xA;&#xA;CLOSE cid_cursor &#xA;DEALLOCATE cid_cursor&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::Data_Date"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Execute Update TWII_BigData"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{8DF78001-8C08-4427-BFE4-B575B0E3908F}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Execute Update TWII_BigData"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{045A71CF-CF00-4833-8C2C-09F66CE84933}"
          SQLTask:SqlStatementSource="delete TWII_BigData where PriceDate=?&#xA;&#xA;IF OBJECT_ID('tempdb..#TWII_BigData_TempTable') IS NOT NULL&#xA;    DROP TABLE #TWII_BigData_TempTable&#xA;&#xA;Declare @StartDate date&#xA;Set @StartDate = '2021-04-20'&#xA;&#xA;select TWII.PriceDate, A.Long, B.Short, C.ClosePosition, TWII.Close_Chg1, TWII.DayClose&#xA;Into #TWII_BigData_TempTable&#xA;from &#xA;(&#xA;select SPI.PriceDate, SPI.Close_Chg1, SPI.DayClose from StockPriceIndicator as SPI&#xA;where SPI.CompanyID=1490 and SPI.PriceDate&gt;@StartDate&#xA;) as TWII &#xA;&#xA;--黃箭頭,紅箭頭&#xA;left join &#xA;(select CS.PriceDate, count(*) as 'Long' from CompanySignalTracking as CS&#xA;inner join StockDailyData as sdd on CS.CompanyID=sdd.CompanyID and CS.PriceDate=sdd.PriceDate&#xA;where (CS.Signal like N'%[黃]%' or CS.Signal like N'%[紅]%') &#xA;group by CS.PriceDate) as A on TWII.PriceDate=A.PriceDate&#xA;&#xA;--藍箭頭&#xA;left join &#xA;(select CS.PriceDate, count(*) as 'Short' from CompanySignalTracking as CS&#xA;inner join StockDailyData as sdd on CS.CompanyID=sdd.CompanyID and CS.PriceDate=sdd.PriceDate&#xA;where (CS.Signal like N'%[藍]%') &#xA;group by CS.PriceDate) as B on TWII.PriceDate=B.PriceDate&#xA;&#xA;--綠箭頭&#xA;left join &#xA;(select CS.PriceDate, count(*) as 'ClosePosition' from CompanySignalTracking as CS&#xA;inner join StockDailyData as sdd on CS.CompanyID=sdd.CompanyID and CS.PriceDate=sdd.PriceDate&#xA;where (CS.Signal like N'%[綠]%') &#xA;group by CS.PriceDate) as C on TWII.PriceDate=C.PriceDate&#xA;&#xA;&#xA;update #TWII_BigData_TempTable set Long=0 where Long is null&#xA;update #TWII_BigData_TempTable set Short=0 where Short is null&#xA;update #TWII_BigData_TempTable set ClosePosition=0 where ClosePosition is null&#xA;&#xA;-- Insert Result into TWII_BigData table&#xA;&#xA;Insert into TWII_BigData&#xA;select PriceDate, &#xA;DayClose as '加權指數',&#xA;CAST((DayClose-(DayClose/(1+Close_Chg1/100))) AS NUMERIC(10,2)) as '漲跌',&#xA;CAST(Close_Chg1 AS NUMERIC(10,2)) as '漲跌幅%',&#xA;Long as '多頭數', &#xA;Short as '空頭數', &#xA;ClosePosition as '平倉數'&#xA;from #TWII_BigData_TempTable&#xA;where PriceDate not in ( select distinct PriceDate from TWII_BigData)&#xA;&#xA;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::Data_Date"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Execute Update TWII_BuySellData"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{0E3B8CC8-78E2-46A9-87FB-A3A140B9D13C}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Execute Update TWII_BuySellData"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{045A71CF-CF00-4833-8C2C-09F66CE84933}"
          SQLTask:SqlStatementSource="declare @StartDate date&#xA;declare @EndDate date&#xA;set @StartDate='2021-04-20'&#xA;set @EndDate=getdate()&#xA;&#xA;delete TWII_BuySellData where PriceDate=? &#xA;&#xA;-- 三大法人買賣超 日期區間累計&#xA;Insert into TWII_BuySellData&#xA;select Ins.DataDate, Count(*) as 'Count    ',&#xA;case&#xA;&#x9;when Abs(SUM(Ins.ForeignInvest*( (DayHigh+DayLow)/2) )/100000000) &gt;=40 then CONVERT(DECIMAL(10, 2),SUM(Ins.ForeignInvest*( (DayHigh+DayLow)/2) /100000000))&#xA;&#x9;when Abs(SUM(Ins.ForeignInvest*( (DayHigh+DayLow)/2) )/100000000) &lt;40 then CONVERT(DECIMAL(10, 2),SUM(Ins.ForeignInvest*( DayOpen*0.25+((DayHigh+DayLow)/2)*0.5+DayClose*0.25 )/100000000))&#xA;end&#xA;as '外資買賣超 (億)',  &#xA;CONVERT(DECIMAL(10, 2),SUM(Ins.InvestTrust*(  (DayHigh+DayLow)/2 ))/100000000)&#xA;as '投信買賣超 (億)',&#xA;CONVERT(DECIMAL(10, 2),SUM(Ins.Dealer*(  (DayHigh+DayLow)/2 ))/100000000)&#xA;as '自營商買賣超 (億)',&#xA;CONVERT(DECIMAL(10, 2),SUM((Ins.ForeignInvest+Ins.InvestTrust+Ins.Dealer)*((DayHigh+DayLow)/2))/100000000) as '三大法人買賣超 (億)'&#xA;from InstitutionalInvest as Ins &#xA;inner join StockDailyData as SDD on Ins.CID=SDD.CompanyID and Ins.DataDate=SDD.PriceDate&#xA;Group by Ins.DataDate&#xA;Having Ins.DataDate&gt;@StartDate and Ins.DataDate&lt;=@EndDate&#xA;and Ins.DataDate not in ( select distinct pricedate from TWII_BuySellData )" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::Data_Date"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="129"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
