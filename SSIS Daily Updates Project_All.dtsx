    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Update temp_company_sdd"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{4DE47C76-65DC-4699-A84B-70671CFCC33A}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Update temp_company_sdd"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{045A71CF-CF00-4833-8C2C-09F66CE84933}"
          SQLTask:SqlStatementSource="DELETE temp_company_sdd &#xA;&#xA;DECLARE @CID int &#xA;&#xA;DECLARE @PriceDate datetime&#xA;&#xA;-- for update chg3 chg6 chg20 chg60&#xA;--Declare @rowNum int&#xA;--Declare @cls0 float&#xA;--Declare @cls3 float&#xA;--Declare @chg3 float&#xA;--Declare @cls6 float&#xA;--Declare @chg6 float&#xA;--Declare @cls20 float&#xA;--Declare @chg20 float&#xA;--Declare @cls60 float&#xA;--Declare @chg60 float&#xA;&#xA;DECLARE db_cursor CURSOR FOR SELECT CompanyID FROM    Company WHERE  Status = 1 &#xA;&#xA;OPEN db_cursor &#xA;&#xA;FETCH NEXT FROM   db_cursor INTO @CID &#xA;&#xA;WHILE @@FETCH_STATUS = 0 BEGIN&#xA;&#xA;INSERT INTO temp_company_sdd(CID, PriceDate, DayOpen, DayHigh, DayLow, DayClose, Volume, Vol_MA3, Vol_MA5, Vol_MA10, Vol_MA15, Vol_MA20, MA5, MA10, MA11, MA20, MA42, MA60, MA100, PreClose)&#xA;SELECT TOP 60 CompanyID, PriceDate, DayOpen, DayHigh, DayLow, DayClose, Cast(Volume / 1000 AS int) AS Volume, &#xA;Cast(AVG(Volume / 1000) OVER (ORDER BY PriceDate ASC ROWS 2 PRECEDING) AS DECIMAL(10, 2)) AS Vol_MA3,  &#xA;Cast(AVG(Volume / 1000) OVER (ORDER BY PriceDate ASC ROWS 4 PRECEDING) AS DECIMAL(10, 2)) AS Vol_MA5, &#xA;Cast(AVG(Volume / 1000) OVER (ORDER BY PriceDate ASC ROWS 9 PRECEDING) AS DECIMAL(10, 2)) AS Vol_MA10, &#xA;Cast(AVG(Volume / 1000) OVER (ORDER BY PriceDate ASC ROWS 14 PRECEDING) AS DECIMAL(10, 2)) AS Vol_MA15,&#xA;Cast(AVG(Volume / 1000) OVER (ORDER BY PriceDate ASC ROWS 19 PRECEDING) AS DECIMAL(10, 2)) AS Vol_MA20,  &#xA;Cast(AVG(DayClose) OVER (ORDER BY PriceDate ASC ROWS 4 PRECEDING) AS DECIMAL(10, 2)) AS MA5,&#xA;Cast(AVG(DayClose) OVER (ORDER BY PriceDate ASC ROWS 9 PRECEDING) AS DECIMAL(10, 2)) AS MA10,&#xA;Cast(AVG(DayClose) OVER (ORDER BY PriceDate ASC ROWS 10 PRECEDING) AS DECIMAL(10, 2)) AS MA11,&#xA;Cast(AVG(DayClose) OVER (ORDER BY PriceDate ASC ROWS 19 PRECEDING) AS DECIMAL(10, 2)) AS MA20,&#xA;Cast(AVG(DayClose) OVER (ORDER BY PriceDate ASC ROWS 41 PRECEDING) AS DECIMAL(10, 2)) AS MA42,&#xA;Cast(AVG(DayClose) OVER (ORDER BY PriceDate ASC ROWS 59 PRECEDING) AS DECIMAL(10, 2)) AS MA60, &#xA;Cast(AVG(DayClose) OVER (ORDER BY PriceDate ASC ROWS 99 PRECEDING) AS DECIMAL(10, 2)) AS MA100, &#xA;LAG(DayClose) OVER (ORDER BY PriceDate) AS PreClose&#xA;FROM   StockDailyData WHERE CompanyID = @CID AND PriceDate &gt; (getdate() - 300)  AND Volume &lt;&gt; 0&#xA;ORDER BY PriceDate DESC &#xA;&#xA;FETCH NEXT FROM   db_cursor INTO @CID&#xA;&#xA;END &#xA;&#xA;CLOSE db_cursor &#xA;&#xA;DEALLOCATE db_cursor" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Update temp_company_spi"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{33647C31-BB04-4236-8D6A-E64D0F8A1CEE}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Update temp_company_spi"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{045A71CF-CF00-4833-8C2C-09F66CE84933}"
          SQLTask:SqlStatementSource="Delete temp_company_spi&#xA;&#xA;insert into temp_company_spi &#xA;select CompanyID&#xA;,PriceDate&#xA;,DayClose&#xA;,Close_Chg1&#xA;,Close_Chg3&#xA;,Close_Chg5&#xA;,Close_Chg6&#xA;,Close_Chg10&#xA;,Close_Chg12&#xA;,Close_Chg20&#xA;,Close_Chg40&#xA;,Close_Chg60&#xA;,Close_Chg120&#xA;,Day0_K&#xA;,Day0_D&#xA;,Day0_Dif&#xA;,Day0_Macd&#xA;,Day0_Bar&#xA;,Day0_Bar_Status&#xA;,Day1_K&#xA;,Day1_D&#xA;,Day1_Dif&#xA;,Day1_Macd&#xA;,Day0_W55&#xA;,Day0_W9&#xA;,KLine_Status&#xA;,MA5_Status&#xA;,MA10_Status&#xA;,MA20_Status&#xA;,MA42_Status&#xA;,MA60_Status&#xA;,VolAvg3_Status&#xA;,Days_CloseOnMa5&#xA;,Days_CloseOnMa20&#xA;,Days_VolMa3OnMa15&#xA;,Days_Ma5OnMa20&#xA;,DMQ_Status&#xA;,BT_60DaysHigh&#xA;,BT_120DaysHigh&#xA;,FB_60DaysLow&#xA;,FB_120DaysLow&#xA;,Day1_Vol/1000&#xA;,Day1_VolMa3/1000&#xA;,Day1_Days_VolMa3OnMa15&#xA;,UpperBBand&#xA;,LowerBBand&#xA;,MinVol_In10Days&#xA;,ChgTime from StockPriceIndicator where PriceDate&gt;getdate()-100" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\Update temp_company_swd"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{6BC939E4-C9DC-4881-8BAF-25FFF559FCF7}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Update temp_company_swd"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{045A71CF-CF00-4833-8C2C-09F66CE84933}"
          SQLTask:SqlStatementSource="delete temp_company_swd&#xA;&#xA;INSERT INTO temp_company_swd(CompanyID, Symbol, ChtName, EngName, EndDate, WeekClose, Volume, WeekMA10, WeekMA20, WeekMA35, WeekMA60, &#xA;WeekMA60_Div_Pct, WeekTrend, WeekMACDStatus, WeekDMI, WeekADX14, Major400, Major1000, MajorDiff)&#xA;SELECT B.CompanyID, B.Symbol, B.ChtName, B.EngName, A.EndDate, A.WeekClose, A.Volume / 1000 AS 'Week Volume', &#xA;A.WeekMA10, A.WeekMA20, A.WeekMA35, A.WeekMA60, A.WeekMA60_Div_Pct, A.WeekTrend, A.WeekMACDStatus, A.WeekDMI, A.WeekADX14, C.Major400, C.Major1000, C.MajorDiff FROM StockWeeklyData AS A &#xA;INNER JOIN Company AS B ON A.CompanyID = B.CompanyID AND A.EndDate &gt; getdate()-183&#x9;-- top 60=getdate()-90; top 90=getdate()-136; top 120=getdate()-183&#xA;Left Join ShareHolder As C on A.CompanyID=C.CompanyID and A.EndDate=C.EndDate&#xA;WHERE B.Status = 1" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
