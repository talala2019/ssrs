      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{24FEF92E-0019-4E19-BD52-C84915B799E2}"
          SQLTask:SqlStatementSource="-- Update Symbol Column&#xA;update Temp_MonthlySales set symbol=SUBSTRING(name,1,4)&#xA;&#xA;-- Delete Unused Date&#xA;delete Temp_MonthlySales where Sales is null or Sales=0&#xA;delete Temp_MonthlySales where Len(symbol)&lt;4&#xA;&#xA;-- Update CID&#xA;DECLARE @CID int&#xA;DECLARE @Symbol varchar(50)&#xA;&#xA;DECLARE db_cursor CURSOR FOR SELECT CompanyID FROM Company WHERE Status=1 and CountryCode='TW'&#xA;&#xA;OPEN db_cursor &#xA;&#xA;FETCH NEXT FROM db_cursor INTO @CID  &#xA;&#xA;WHILE @@FETCH_STATUS = 0 BEGIN&#xA;&#xA;select @Symbol=Symbol from Company where CompanyID=@CID&#xA;&#xA;-- Update CID&#xA;Update Temp_MonthlySales set CID=@CID where ltrim(rtrim(Symbol))=SUBSTRING(@Symbol,1,4) and CID is null &#xA;&#xA;&#xA;FETCH NEXT FROM   db_cursor INTO @CID&#xA;&#xA;END &#xA;&#xA;CLOSE db_cursor &#xA;&#xA;DEALLOCATE db_cursor&#xA;&#xA;--Delete Temp_MonthlySales where CID is null " xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
