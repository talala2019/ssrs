          </DTS:Variables>
          <DTS:Executables />
        </DTS:EventHandler>
      </DTS:EventHandlers>
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{24FEF92E-0019-4E19-BD52-C84915B799E2}"
          SQLTask:SqlStatementSource="-- update CID after insert data&#xA;DECLARE @CID int&#xA;DECLARE @Symbol varchar(50)&#xA;&#xA;declare @count int&#xA;declare @year int&#xA;&#xA;DECLARE db_cursor CURSOR FOR SELECT CompanyID FROM Company WHERE Status = 1 and CountryCode='TW'&#xA;&#xA;OPEN db_cursor &#xA;&#xA;FETCH NEXT FROM db_cursor INTO @CID  &#xA;&#xA;WHILE @@FETCH_STATUS = 0 BEGIN&#xA;&#xA;select @Symbol=Symbol from Company where CompanyID=@CID&#xA;&#xA;Update CompanyInfo set CompanyID=@CID where  ltrim(rtrim(Symbol))=SUBSTRING(@Symbol,0,5) and CompanyID is null&#xA;&#xA;&#xA;set @count=0&#xA;set @year=0&#xA;&#xA;select @count=count(*) from CompanyInfo where CompanyID=@CID&#xA;&#xA;--print @count&#xA;&#xA;-- 只留最新一筆資料&#xA;if(@count&gt;1)&#xA;begin&#xA;&#x9;select top 1 @year=Year from CompanyInfo where  CompanyID=@CID order by year desc&#xA;&#x9;--print @year&#xA;&#x9;delete CompanyInfo where CompanyID=@CID and Year&lt;@year&#xA;end&#xA;&#xA;FETCH NEXT FROM   db_cursor INTO @CID&#xA;&#xA;END &#xA;&#xA;CLOSE db_cursor &#xA;&#xA;DEALLOCATE db_cursor&#xA;&#xA;Delete CompanyInfo where CompanyID is null" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
