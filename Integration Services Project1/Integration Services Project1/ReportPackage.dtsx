      DTS:DTSID="{EE30B053-6174-452A-8872-3B692E6DB0C1}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Update temp_company_msalesYoY"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2017; © 2017 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="1">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{24FEF92E-0019-4E19-BD52-C84915B799E2}"
          SQLTask:SqlStatementSource="DELETE temp_company_msalesYoY &#xA;&#xA;Declare @year int&#xA;Declare @month int&#xA;&#xA;set @year = ?&#xA;set @month = ?&#xA;&#xA;INSERT INTO temp_company_msalesYoY (cid, year, month, msales, msales_pre1, msales_pre2, totalsales, lyear, lymonth, lymsales, lymsales_pre1, lymsales_pre2, lytotalsales, chtname, symbol, msalesresult, salesYoY, lytotalsales_wholeyear)&#xA;SELECT MS.CompanyId, MS.Year, @month AS 'Month', &#xA;        (CASE @month WHEN 1 THEN MS.Jan WHEN 2 THEN MS.Feb WHEN 3 THEN MS.Mar WHEN 4 THEN MS.April WHEN 5 THEN MS.May WHEN 6 THEN MS.June &#xA;&#x9;&#x9;&#x9;&#x9;WHEN 7 THEN MS.July WHEN 8 THEN MS.Aug WHEN 9 THEN MS.Sep WHEN 10 THEN MS.Oct WHEN 11 THEN MS.Nov WHEN 12 THEN MS.Dec ELSE 0 END) AS 'MonthlySales',&#xA;&#x9;&#x9;(CASE @month-1 WHEN 1 THEN MS.Jan WHEN 2 THEN MS.Feb WHEN 3 THEN MS.Mar WHEN 4 THEN MS.April WHEN 5 THEN MS.May WHEN 6 THEN MS.June &#xA;&#x9;&#x9;&#x9;&#x9;WHEN 7 THEN MS.July WHEN 8 THEN MS.Aug WHEN 9 THEN MS.Sep WHEN 10 THEN MS.Oct WHEN 11 THEN MS.Nov WHEN 12 THEN MS.Dec ELSE 0 END) AS 'MonthlySales_Pre1', &#xA;&#x9;&#x9;(CASE @month-2 WHEN 1 THEN MS.Jan WHEN 2 THEN MS.Feb WHEN 3 THEN MS.Mar WHEN 4 THEN MS.April WHEN 5 THEN MS.May WHEN 6 THEN MS.June &#xA;&#x9;&#x9;&#x9;&#x9;WHEN 7 THEN MS.July WHEN 8 THEN MS.Aug WHEN 9 THEN MS.Sep WHEN 10 THEN MS.Oct WHEN 11 THEN MS.Nov WHEN 12 THEN MS.Dec ELSE 0 END) AS 'MonthlySales_Pre2',  &#xA;&#x9;&#x9;MS.TotalSales, LY.Year AS 'LYear', @month AS 'LYMonth', &#xA;&#x9;&#x9;LY.LYMonthlySales,&#xA;&#x9;&#x9;LY.LYMonthlySales_Pre1, &#xA;&#x9;&#x9;LY.LYMonthlySales_Pre2,  &#xA;&#x9;&#x9;LY.LYTotalSales, &#xA;&#x9;&#x9;comp.ChtName, comp.Symbol, comp.MSalesDLResult, &#xA;        MS.TotalSales / LY.LYTotalSales AS 'SalesYoY',&#xA;&#x9;&#x9;LY.LYTotalSales_WholeYear&#xA;FROM MonthlySales AS MS &#xA;INNER JOIN&#xA;            (&#x9;SELECT CompanyId, Year, &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;(CASE @month WHEN 1 THEN lms.Jan WHEN 2 THEN lms.Feb WHEN 3 THEN lms.Mar WHEN 4 THEN lms.April WHEN 5 THEN lms.May WHEN 6 THEN lms.June &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN 7 THEN lms.July WHEN 8 THEN lms.Aug WHEN 9 THEN lms.Sep WHEN 10 THEN lms.Oct WHEN 11 THEN lms.Nov WHEN 12 THEN lms.Dec ELSE 0 END) AS 'LYMonthlySales', &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;(CASE @month-1 WHEN 1 THEN lms.Jan WHEN 2 THEN lms.Feb WHEN 3 THEN lms.Mar WHEN 4 THEN lms.April WHEN 5 THEN lms.May WHEN 6 THEN lms.June &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN 7 THEN lms.July WHEN 8 THEN lms.Aug WHEN 9 THEN lms.Sep WHEN 10 THEN lms.Oct WHEN 11 THEN lms.Nov WHEN 12 THEN lms.Dec ELSE 0 END) AS 'LYMonthlySales_Pre1', &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;(CASE @month-2 WHEN 1 THEN lms.Jan WHEN 2 THEN lms.Feb WHEN 3 THEN lms.Mar WHEN 4 THEN lms.April WHEN 5 THEN lms.May WHEN 6 THEN lms.June &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN 7 THEN lms.July WHEN 8 THEN lms.Aug WHEN 9 THEN lms.Sep WHEN 10 THEN lms.Oct WHEN 11 THEN lms.Nov WHEN 12 THEN lms.Dec ELSE 0 END) AS 'LYMonthlySales_Pre2', &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;(CASE @month WHEN 1 THEN lms.Jan WHEN 2 THEN lms.Jan + lms.Feb WHEN 3 THEN lms.Jan + lms.Feb + lms.Mar &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN 4 THEN lms.Jan + lms.Feb + lms.Mar + lms.April &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN 5 THEN lms.Jan + lms.Feb + lms.Mar + lms.April + lms.May &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN 6 THEN&#x9;lms.Jan + lms.Feb + lms.Mar + lms.April + lms.May + lms.June &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN 7 THEN lms.Jan + lms.Feb + lms.Mar + lms.April + lms.May + lms.June + lms.July &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN 8 THEN lms.Jan + lms.Feb + lms.Mar + lms.April + lms.May + lms.June + lms.July + lms.Aug&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN 9 THEN lms.Jan + lms.Feb + lms.Mar + lms.April + lms.May + lms.June + lms.July + lms.Aug + lms.Sep &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN 10 THEN lms.Jan + lms.Feb + lms.Mar + lms.April + lms.May + lms.June + lms.July + lms.Aug + lms.Sep + lms.Oct &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN 11 THEN lms.Jan + lms.Feb + lms.Mar + lms.April + lms.May + lms.June + lms.July + lms.Aug + lms.Sep + lms.Oct + lms.Nov &#xA;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;&#x9;WHEN 12 THEN lms.TotalSales ELSE 0 END) AS 'LYTotalSales',&#xA;&#x9;&#x9;&#x9;&#x9;&#x9;TotalSales AS 'LYTotalSales_WholeYear'&#xA;&#x9;&#x9;&#x9;&#x9;FROM    MonthlySales AS lms WHERE (Year = @year - 1)&#xA;&#x9;&#x9;&#x9;) AS LY ON MS.CompanyId = LY.CompanyId &#xA;INNER JOIN&#xA;Company AS comp ON MS.CompanyId = comp.CompanyID&#xA;WHERE comp.Status = 1 AND (MS.Year = @year) AND LY.LYTotalSales &lt;&gt; 0" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="0"
            SQLTask:DtsVariableName="User::CurrentYear"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="131"
            SQLTask:ParameterSize="-1" />
          <SQLTask:ParameterBinding
            SQLTask:ParameterName="1"
            SQLTask:DtsVariableName="User::CurrentMonth"
            SQLTask:ParameterDirection="Input"
            SQLTask:DataType="131"
            SQLTask:ParameterSize="-1" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
